#!/usr/bin/env python3
# CLASS: code
"""Reef adversarial record — the loophole-hunter's pass as DATA on the task file.

Usage:
  reef-adversarial <task-file> plan  <report-file>    record the pass on the PLAN (before code)
  reef-adversarial <task-file> guard <report-file>    record the pass on the finished GUARD (after)
  reef-adversarial <task-file> plan-hash               print the plan hash the guard will compare
  reef-adversarial <task-file> plan --migrate          (0.7) re-stamp a record written before the cut moved to
                                                       `## Reviewer notes` — only when the 0.6-form hash of the file
                                                       still equals the stamp (the plan is unchanged); no hunter round
  reef-adversarial <task-file> plan --decided <mark>   (0.7) the owner ruled at the gate (queue footnote <mark>) on a
                                                       plan edited after the hunter's last pass: re-stamp without a round

The plan pass has a ROUND CAP (0.7, `hunter.plan_rounds`, default 2): the pass, one fix, one re-check. A report whose
RUN line says `round=N` / `(round N)` above the cap is refused — the hole it names is the owner's decision at the gate
(fix as drafted / accept as a found row / drop the task), or an AC/Proof row the CODE proves, never a third hunter
round on prose (2026-10-17: rows 2 and 13 reached round 6 and three planning sessions produced no code).

A `tier: design` task runs the loophole-hunter twice. This script turns each pass into a
frontmatter key the mechanisms read:
  adversarial-plan: <sha12 of the PLAN content>   — the guard refuses a design-tier
                    implementer dispatch unless this equals the task's current plan hash
                    (edit the plan and the pass is void — re-run the hunter)
  adversarial-guard: <sha12 of the report>@<HEAD of the worktree>  — the pre-commit refuses
                    a design-tier task file staged into tasks/done/ without this key

What is recorded: only a report that is the hunter's (RUN: agent=loophole-hunter ...
pass=<same pass>), ends VERDICT: PASS, and carries no BLOCKER line. A FAIL is not
recorded — it goes back to the plan or the implementer. A mech/light task is refused:
the adversarial stage never runs on mech (the cost lesson), and recording one would
only decorate the file.

Exit 0 = recorded. 2 = refused (reason on stderr). Never a traceback.
"""
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile

FENCE = re.compile(r"\A---\r?\n(.*?\r?\n)---\r?\n", re.S)
LOG_HEADING = re.compile(r"^##[ \t]+[Ll][Oo][Gg][ \t]*$", re.M)
# the Reviewer notes (plan-review advisories) are outside the plan, like the Log — reef-plan-check cuts the same way
# (2026-10-18: notes added after the hunter's pass changed this hash and the orchestrator reverted the notes to match)
CUT_HEADING = re.compile(r"^##[ \t]+(?:[Ll][Oo][Gg]|Reviewer notes)[ \t]*$", re.M)
EXEC_KEYS = r"^(status|attempts|last_failure_sig|dispatches|worktree|adversarial-plan|adversarial-guard|adversarial-decided):.*(?:\r?\n|\Z)"
ROUND = re.compile(r"\bround[= ](\d+)\b|\(round (\d+)\)", re.I)


def plan_rounds_cap(task_path):
    """hunter.plan_rounds from the nearest .reef/config.json above the task file (default 2; 0 = no cap)."""
    d = os.path.dirname(os.path.abspath(task_path))
    for _ in range(12):
        cfg = os.path.join(d, ".reef", "config.json")
        if os.path.isfile(cfg):
            try:
                with open(cfg, encoding="utf-8") as f:
                    h = (json.load(f).get("hunter") or {})
                return int(h.get("plan_rounds", 2) or 0)
            except Exception:
                return 2
        nd = os.path.dirname(d)
        if nd == d:
            break
        d = nd
    return 2


def report_round(report):
    head = re.search(r"^RUN:.*$", report, re.M)
    m = ROUND.search(head.group(0)) if head else None
    return int(m.group(1) or m.group(2)) if m else 1
PASSES = ("plan", "guard")


def die(msg):
    print(f"reef-adversarial REFUSED: {msg}", file=sys.stderr)
    sys.exit(2)


def read(path):
    with open(path, encoding="utf-8", newline="") as f:
        return f.read()


def frontmatter(text):
    m = FENCE.match(text)
    if not m:
        return None
    fm = {}
    for line in m.group(1).splitlines():
        if line[:1] in (" ", "\t", "#") or ":" not in line:
            continue
        k, _, v = line.partition(":")
        fm.setdefault(k.strip(), v.strip().strip('"'))
    return fm


def _hash_cut(text, cut):
    text = cut.split(text, maxsplit=1)[0]
    m = FENCE.match(text)
    if m:
        fm = re.sub(EXEC_KEYS, "", m.group(1), flags=re.M)
        text = fm + text[m.end(1):]
    return hashlib.sha1(text.encode("utf-8")).hexdigest()[:12]


def plan_hash(text):
    """What PLANNING wrote: the frontmatter minus execution keys, the body up to ## Reviewer notes / ## Log.
    The same strip reef-plan-check uses for the stamp, plus this script's own keys."""
    return _hash_cut(text, CUT_HEADING)


def legacy_plan_hash(text):
    """The 0.6 form: cut at ## Log only, so the Reviewer notes were inside the hash. Read by `plan --migrate` and by
    the guard's denial (2026-10-18: a stamp written the day before the cut moved failed as "the plan changed"); never
    written."""
    return _hash_cut(text, LOG_HEADING)


def set_key(path, text, key, value):
    m = FENCE.match(text)
    fm = m.group(1)
    if re.search(rf"^{re.escape(key)}:", fm, re.M):
        fm = re.sub(rf"^{re.escape(key)}:.*$", f"{key}: {value}", fm, count=1, flags=re.M)
    else:
        fm = fm + f"{key}: {value}\n"
    new = text[:m.start(1)] + fm + text[m.end(1):]
    fd, tmp = tempfile.mkstemp(prefix=".reef-adv-", dir=os.path.dirname(os.path.abspath(path)))
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
            f.write(new)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def check_report(report, want_pass):
    head = re.search(r"^RUN:[ \t]*agent=loophole-hunter\b(.*)$", report, re.M)
    if not head:
        die("the report does not start a RUN: agent=loophole-hunter line — only the hunter's own report counts")
    got = re.search(r"\bpass=(\w+)", head.group(1))
    if not got or got.group(1) != want_pass:
        die(f"the report's pass is {got.group(1) if got else 'missing'!r}, not {want_pass!r} — a plan pass does not stand in for the guard pass")
    verdict = re.search(r"^VERDICT:[ \t]*(PASS|FAIL)\b", report, re.M)
    if not verdict:
        die("the report has no VERDICT: PASS|FAIL line")
    if verdict.group(1) != "PASS":
        die("VERDICT: FAIL is not recorded — fix the plan or the guard, then run the hunter again")
    # a BLOCKER line is a hole; "BLOCKER: none" is the hunter saying there is none (seen live, 0.7 dogfood) and
    # `**BLOCKER:** hole` is a hole in markdown bold (also seen live) — strip the bold, read the words
    for line in report.splitlines():
        bare = line.replace("*", "").strip()
        if not bare.upper().startswith("BLOCKER"):
            continue
        rest = re.sub(r"^BLOCKER\s*:?\s*", "", bare, flags=re.I).strip().rstrip(".").lower()
        if rest and not re.match(r"^(none|no blockers?|nothing)\b", rest):   # "none found." / "none — all NEW-ROW" (seen live, first contact)
            die("a BLOCKER line with VERDICT: PASS is a contradiction — not recorded")


def head_of(path):
    d = os.path.dirname(os.path.abspath(path))
    r = subprocess.run(["git", "rev-parse", "--short=12", "HEAD"], cwd=d, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else "no-git"


def main(argv):
    if len(argv) == 2 and argv[1] == "plan-hash":
        print(plan_hash(read(argv[0])))
        return 0
    if len(argv) == 3 and argv[1] == "plan" and argv[2] == "--migrate":
        task_path = argv[0]
        if not os.path.isfile(task_path):
            die(f"file not found: {task_path}")
        text = read(task_path)
        fm = frontmatter(text)
        got = ((fm or {}).get("adversarial-plan") or "").strip()
        if fm is None or not got:
            die("--migrate re-stamps a record the hunter wrote; there is no adversarial-plan record here — run the hunter")
        want = plan_hash(text)
        if got == want:
            print(f"adversarial-plan: {got} is current — nothing to migrate")
            return 0
        if got != legacy_plan_hash(text):
            die(f"the plan changed since the hunter's pass (adversarial-plan {got} is neither the current hash {want} nor the 0.6 form of "
                f"this file) — not a migration: a hunter re-check within hunter.plan_rounds, or the owner's ruling at the gate (`plan --decided <mark>`)")
        set_key(task_path, text, "adversarial-plan", want)
        print(f"adversarial-plan: {got} → {want} (the 0.6 stamp hashed the Reviewer notes; the plan is unchanged, no hunter round)")
        return 0
    if len(argv) == 4 and argv[1] == "plan" and argv[2] == "--decided":
        task_path, mark = argv[0], argv[3].strip()
        if not os.path.isfile(task_path):
            die(f"file not found: {task_path}")
        if not mark:
            die("--decided needs the queue footnote mark that records the owner's ruling")
        text = read(task_path)
        fm = frontmatter(text)
        if fm is None or "adversarial-plan" not in fm:
            die("--decided re-stamps a plan the hunter already passed once; there is no adversarial-plan record here — run the hunter")
        value = plan_hash(text)
        set_key(task_path, text, "adversarial-plan", value)
        set_key(task_path, read(task_path), "adversarial-decided", mark)
        print(f"adversarial-plan: {value} (owner decision {mark}, no hunter round)")
        return 0
    if len(argv) != 3 or argv[1] not in PASSES:
        die("usage: reef-adversarial <task-file> plan|guard <report-file>  |  <task-file> plan --decided <mark>  |  <task-file> plan --migrate  |  <task-file> plan-hash")
    task_path, which, report_path = argv
    for p in (task_path, report_path):
        if not os.path.isfile(p):
            die(f"file not found: {p}")
    text = read(task_path)
    fm = frontmatter(text)
    if fm is None:
        die(f"{task_path} has no frontmatter fence — not a reef task file")
    if fm.get("complexity") == "mech" or fm.get("tier") == "light":
        die("the adversarial stage never runs on a mech/light task — nothing to record")
    report = read(report_path)
    check_report(report, which)
    if which == "plan":
        cap, rnd = plan_rounds_cap(task_path), report_round(report)
        if cap and rnd > cap:
            die(f"plan pass round {rnd} > hunter.plan_rounds {cap}: the plan gets no further hunter round. An open hole is the owner's "
                f"decision at the gate (fix as drafted / accept it as a found row / drop the task) — record his words as a queue footnote and run "
                f"`reef-adversarial <task> plan --decided <mark>`; a hole the code must prove becomes an AC with a Proof row, and the hunter's next pass is on the CODE")
        value = plan_hash(text)
    else:
        if "adversarial-plan" not in fm:
            die("no adversarial-plan record — the plan pass comes first")
        value = hashlib.sha1(read(report_path).encode("utf-8")).hexdigest()[:12] + "@" + head_of(task_path)
    set_key(task_path, text, f"adversarial-{which}", value)
    print(f"adversarial-{which}: {value}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except Exception as e:
        die(f"internal error: {e}")
