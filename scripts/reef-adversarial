#!/usr/bin/env python3
# CLASS: code
"""Reef adversarial record — the loophole-hunter's pass as DATA on the task file.

Usage:
  reef-adversarial <task-file> plan  <report-file>    record the pass on the PLAN (before code)
  reef-adversarial <task-file> guard <report-file>    record the pass on the finished GUARD (after)
  reef-adversarial <task-file> plan-hash               print the plan hash the guard will compare
  reef-adversarial --feature <slug> guard <report>     (0.7) hunter.guard_pass = feature: ONE guard pass on the feature's
                                                       merged diff, recorded on every design/critical task of the feature
                                                       (open and done); reef-record refuses GREEN without it
  reef-adversarial <task-file> plan --decided <mark>   (0.7) the owner ruled at the gate (queue footnote <mark>) on a
                                                       plan edited after the hunter's last pass: re-stamp without a round

The plan pass has a ROUND CAP (0.7, `hunter.plan_rounds`, default 2): the pass, one fix, one re-check. A FAIL at a round
(`round=N` / `(round N)` on the RUN line) at or above the cap gets no further round — the hole it names is the owner's
decision at the gate (fix as drafted / accept as a found row / drop the task), or an AC/Proof row the CODE proves,
never another hunter round on prose (2026-10-17: rows 2 and 13 reached round 6). A PASS is recorded at any round: it
ends the cycle (2026-10-21: R4's round-3 PASS was refused, and the only way out was a config change by the owner).

A `tier: design` task runs the loophole-hunter twice. This script turns each pass into a
frontmatter key the mechanisms read:
  adversarial-plan: <sha12 of the PLAN content>   — the guard refuses a design-tier
                    implementer dispatch unless this equals the task's current plan hash
                    (edit the plan and the pass is void — re-run the hunter)
  adversarial-guard: <sha12 of the report>@<HEAD of the worktree>  — the pre-commit refuses
                    a design-tier task file staged into tasks/done/ without this key

What is recorded: only a report that is the hunter's (RUN: agent=loophole-hunter ...
pass=<same pass>), ends VERDICT: PASS, and carries no BLOCKER line. A FAIL is not
recorded — it goes back to the plan or the implementer. A mech/light task is refused:
the adversarial stage never runs on mech (the cost lesson), and recording one would
only decorate the file.

Exit 0 = recorded. 2 = refused (reason on stderr). Never a traceback.
"""
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))   # the shared helpers live beside this script
from reef_common import read_crlf as read  # noqa: E402

FENCE = re.compile(r"\A---\r?\n(.*?\r?\n)---\r?\n", re.S)
# the Reviewer notes (plan-review advisories) are outside the plan, like the Log — reef-plan-check cuts the same way
# (2026-10-18: notes added after the hunter's pass changed this hash and the orchestrator reverted the notes to match)
CUT_HEADING = re.compile(r"^##[ \t]+(?:[Ll][Oo][Gg]|Reviewer notes)[ \t]*$", re.M)
EXEC_KEYS = r"^(status|attempts|last_failure_sig|dispatches|worktree|adversarial-plan|adversarial-guard|adversarial-decided):.*(?:\r?\n|\Z)"
ROUND = re.compile(r"\bround[= ](\d+)\b|\(round (\d+)\)", re.I)


def plan_rounds_cap(task_path):
    """hunter.plan_rounds (default 2; 0 = no cap) from the loop policy's home, the MAIN checkout's config
    (2026-10-21: row 4's plan lives in its worktree, whose copy kept the old cap; the owner was asked to edit two files)."""
    try:
        return int((policy_config(task_path).get("hunter") or {}).get("plan_rounds", 2) or 0)
    except Exception:
        return 2


def config_near(path):
    """(root, config dict) for the nearest .reef/config.json at or above path (a file or a directory)."""
    d = os.path.abspath(path if os.path.isdir(path) else os.path.dirname(path))
    for _ in range(12):
        cfg = os.path.join(d, ".reef", "config.json")
        if os.path.isfile(cfg):
            try:
                with open(cfg, encoding="utf-8") as f:
                    return d, json.load(f)
            except Exception:
                return d, {}
        nd = os.path.dirname(d)
        if nd == d:
            break
        d = nd
    return None, {}


def policy(path):
    """(root, config): loop policy has ONE home, the MAIN checkout's config (a worktree's copy predates the owner's edit
    until its next merge of the base); the nearest config when there is no other checkout."""
    root, cfg = config_near(path)
    if root:
        try:
            r = subprocess.run(["git", "-C", root, "worktree", "list", "--porcelain"], capture_output=True, text=True, timeout=10)
            main = next((l[len("worktree "):].strip() for l in r.stdout.splitlines() if l.startswith("worktree ")), "")
            if main and os.path.abspath(main) != os.path.abspath(root):
                with open(os.path.join(main, ".reef", "config.json"), encoding="utf-8") as f:
                    root, cfg = main, json.load(f)
        except Exception:
            pass
    return root, cfg


def policy_config(path):
    return policy(path)[1]


def footnote_in_queue(task_path, mark):
    """The owner's ruling is a queue footnote: a line of the main checkout's queue starting with its mark (`⁶⁸`, or `68`)."""
    root, cfg = policy(task_path)
    sup = mark.translate(str.maketrans("0123456789", "⁰¹²³⁴⁵⁶⁷⁸⁹"))
    try:
        with open(os.path.join(root or ".", (cfg.get("paths") or {}).get("queue", "docs/queue.md")), encoding="utf-8") as f:
            return any(l.startswith(sup + " ") for l in f)
    except OSError:
        return False


def guard_pass_mode(path):
    """hunter.guard_pass: `task` (default; the hunter's guard pass per design/critical task, the pre-commit requires it to
    close) or `feature` (one pass on the feature's merged diff before the GREEN record — 2026-10-18: two judges cost
    96k on a 20-line task; the hunter's floor is paid once per feature instead). Read from `policy_config`."""
    return str((policy_config(path).get("hunter") or {}).get("guard_pass", "task") or "task").strip().lower()


def plan_pass_tiers(path):
    """The tiers whose plan needs the hunter's pass before code: hunter.plan_pass `critical` (default, 0.7 — a design
    task gets the plan reviewer; measured 2026-10-17/18, the plan hunter's rounds were the planning sessions' cost) or
    `design` (design and critical, the 0.6 behaviour). Read from the MAIN checkout like guard_pass. A review ROLLUP
    (R<NN>-…) needs none (the owner's go, 2026-10-24: qassimha's R4 took three plan rounds; the feature's guard pass reads
    its diff before GREEN)."""
    if re.match(r"R\d+[-.]", os.path.basename(path)):
        return ()
    root, cfg = config_near(path)
    if root:
        try:
            r = subprocess.run(["git", "-C", root, "worktree", "list", "--porcelain"], capture_output=True, text=True, timeout=10)
            main = next((l[len("worktree "):].strip() for l in r.stdout.splitlines() if l.startswith("worktree ")), "")
            if main and os.path.abspath(main) != os.path.abspath(root):
                with open(os.path.join(main, ".reef", "config.json"), encoding="utf-8") as f:
                    cfg = json.load(f)
        except Exception:
            pass
    mode = str((cfg.get("hunter") or {}).get("plan_pass", "critical") or "critical").strip().lower()
    return ("design", "critical") if mode == "design" else ("critical",)


def feature_tasks(root, cfg, slug):
    """Every task file of a feature: the 0.6 folder (paths.features/<slug>/tasks/*.md and tasks/done/*.md) or, in the
    flat layout, the tasks/ files whose frontmatter names the feature."""
    import glob
    features = str((cfg.get("paths") or {}).get("features") or "reef/features")
    fdir = os.path.join(root, features, slug, "tasks")
    if os.path.isdir(fdir):
        return sorted(glob.glob(os.path.join(fdir, "*.md")) + glob.glob(os.path.join(fdir, "done", "*.md")))
    tdir = os.path.join(root, str((cfg.get("paths") or {}).get("tasks") or "tasks"))
    out = []
    for p in sorted(glob.glob(os.path.join(tdir, "*.md")) + glob.glob(os.path.join(tdir, "done", "*.md"))):
        fm = frontmatter(read(p)) or {}
        if fm.get("feature") == slug:
            out.append(p)
    return out


def guarded_tasks(root, cfg, slug):
    """The feature's design/critical tasks (the ones the guard pass covers) as (path, frontmatter)."""
    out = []
    for p in feature_tasks(root, cfg, slug):
        fm = frontmatter(read(p)) or {}
        if fm.get("tier") in ("design", "critical"):
            out.append((p, fm))
    return out


def report_round(report):
    head = re.search(r"^RUN:.*$", report, re.M)
    m = ROUND.search(head.group(0)) if head else None
    return int(m.group(1) or m.group(2)) if m else 1
PASSES = ("plan", "guard")


def die(msg):
    print(f"reef-adversarial REFUSED: {msg}", file=sys.stderr)
    sys.exit(2)


def frontmatter(text):
    m = FENCE.match(text)
    if not m:
        return None
    fm = {}
    for line in m.group(1).splitlines():
        if line[:1] in (" ", "\t", "#") or ":" not in line:
            continue
        k, _, v = line.partition(":")
        fm.setdefault(k.strip(), v.strip().strip('"'))
    return fm


def _hash_cut(text, cut):
    text = cut.split(text, maxsplit=1)[0]
    m = FENCE.match(text)
    if m:
        fm = re.sub(EXEC_KEYS, "", m.group(1), flags=re.M)
        text = fm + text[m.end(1):]
    return hashlib.sha1(text.encode("utf-8")).hexdigest()[:12]


def plan_hash(text):
    """What PLANNING wrote: the frontmatter minus execution keys, the body up to ## Reviewer notes / ## Log.
    The same strip reef-plan-check uses for the stamp, plus this script's own keys."""
    return _hash_cut(text, CUT_HEADING)


def set_key(path, text, key, value):
    m = FENCE.match(text)
    fm = m.group(1)
    if re.search(rf"^{re.escape(key)}:", fm, re.M):
        fm = re.sub(rf"^{re.escape(key)}:.*$", f"{key}: {value}", fm, count=1, flags=re.M)
    else:
        fm = fm + f"{key}: {value}\n"
    new = text[:m.start(1)] + fm + text[m.end(1):]
    fd, tmp = tempfile.mkstemp(prefix=".reef-adv-", dir=os.path.dirname(os.path.abspath(path)))
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
            f.write(new)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def check_report(report, want_pass):
    head = re.search(r"^RUN:[ \t]*agent=loophole-hunter\b(.*)$", report, re.M)
    if not head:
        die("the report does not start a RUN: agent=loophole-hunter line — only the hunter's own report counts")
    got = re.search(r"\bpass=(\w+)", head.group(1))
    if not got or got.group(1) != want_pass:
        die(f"the report's pass is {got.group(1) if got else 'missing'!r}, not {want_pass!r} — a plan pass does not stand in for the guard pass")
    verdict = re.search(r"^VERDICT:[ \t]*(PASS|FAIL)\b", report, re.M)
    if not verdict:
        die("the report has no VERDICT: PASS|FAIL line")
    if verdict.group(1) != "PASS":
        die("VERDICT: FAIL is not recorded — fix the plan or the guard, then run the hunter again")
    # a BLOCKER line is a hole; "BLOCKER: none" is the hunter saying there is none (seen live, 0.7 dogfood) and
    # `**BLOCKER:** hole` is a hole in markdown bold (also seen live) — strip the bold, read the words
    for line in report.splitlines():
        bare = line.replace("*", "").strip()
        if not bare.upper().startswith("BLOCKER"):
            continue
        rest = re.sub(r"^BLOCKER\s*:?\s*", "", bare, flags=re.I).strip().rstrip(".").lower()
        if rest and not re.match(r"^(none|no blockers?|nothing)\b", rest):   # "none found." / "none — all NEW-ROW" (seen live, first contact)
            die("a BLOCKER line with VERDICT: PASS is a contradiction — not recorded")


def head_of(path):
    d = os.path.dirname(os.path.abspath(path))
    r = subprocess.run(["git", "rev-parse", "--short=12", "HEAD"], cwd=d, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else "no-git"


def main(argv):
    if len(argv) == 4 and argv[0] == "--feature" and argv[2] == "guard":
        slug, report_path = argv[1].strip(), argv[3]
        root, cfg = config_near(os.getcwd())
        if not root:
            die("no .reef/config.json at or above the current directory — run in the checkout that holds the feature")
        if not os.path.isfile(report_path):
            die(f"file not found: {report_path}")
        tasks = guarded_tasks(root, cfg, slug)
        if not tasks:
            die(f"feature {slug!r} has no task of tier design or critical (its `tier:`, not its `complexity:`) — no guard pass "
                "is required or recorded; the GREEN record does not ask for one")
        for p, fm in tasks:
            if "adversarial-plan" not in fm:
                die(f"{os.path.relpath(p, root)}: no adversarial-plan record — the plan pass comes first")
        check_report(read(report_path), "guard")
        value = hashlib.sha1(read(report_path).encode("utf-8")).hexdigest()[:12] + "@" + head_of(tasks[0][0])
        for p, _ in tasks:
            set_key(p, read(p), "adversarial-guard", value)
        print(f"adversarial-guard: {value} on {len(tasks)} task(s) of {slug}: " + ", ".join(fm.get("id", "?") for _, fm in tasks))
        return 0
    if len(argv) == 2 and argv[1] == "plan-hash":
        print(plan_hash(read(argv[0])))
        return 0
    if len(argv) == 4 and argv[1] == "plan" and argv[2] == "--decided":
        task_path, mark = argv[0], argv[3].strip()
        if not os.path.isfile(task_path):
            die(f"file not found: {task_path}")
        if not mark:
            die("--decided needs the queue footnote mark that records the owner's ruling")
        text = read(task_path)
        fm = frontmatter(text)
        if fm is None:
            die(f"{task_path} has no frontmatter fence — not a reef task file")
        if "adversarial-plan" not in fm and not footnote_in_queue(task_path, mark):
            die(f"--decided {mark} on a plan the hunter never passed: no queue footnote {mark} — write the owner's ruling as a "
                f"footnote on the row first (with a pass on record, a decision only replaces the re-check)")
        value = plan_hash(text)
        set_key(task_path, text, "adversarial-plan", value)
        set_key(task_path, read(task_path), "adversarial-decided", mark)
        print(f"adversarial-plan: {value} (owner decision {mark}, no hunter round)")
        clear_plan_marker(task_path, fm.get("id", ""))
        return 0
    if len(argv) != 3 or argv[1] not in PASSES:
        die("usage: reef-adversarial <task-file> plan|guard <report-file>  |  --feature <slug> guard <report-file>  |  <task-file> plan --decided <mark>  |  <task-file> plan-hash")
    task_path, which, report_path = argv
    for p in (task_path, report_path):
        if not os.path.isfile(p):
            die(f"file not found: {p}")
    text = read(task_path)
    fm = frontmatter(text)
    if fm is None:
        die(f"{task_path} has no frontmatter fence — not a reef task file")
    if fm.get("complexity") == "mech" or fm.get("tier") == "light":
        die("the adversarial stage never runs on a mech/light task — nothing to record")
    report = read(report_path)
    if which == "plan":
        cap, rnd = plan_rounds_cap(task_path), report_round(report)
        if cap and rnd >= cap and re.search(r"^VERDICT:[ \t]*FAIL\b", report, re.M):
            die(f"plan pass round {rnd} FAILED at hunter.plan_rounds {cap}: the plan gets no further hunter round. An open hole is the owner's "
                f"decision at the gate (fix as drafted / accept it as a found row / drop the task) — record his words as a queue footnote and run "
                f"`reef-adversarial <task> plan --decided <mark>`; a hole the code must prove becomes an AC with a Proof row, and the hunter's next pass is on the CODE")
    check_report(report, which)
    if which == "plan":
        if cap and rnd > cap:
            print(f"note: round {rnd} is above hunter.plan_rounds {cap}; its PASS is recorded, and a FAIL at the cap would have gone to the owner")
        value = plan_hash(text)
    else:
        if "adversarial-plan" not in fm:
            die("no adversarial-plan record — the plan pass comes first")
        value = hashlib.sha1(read(report_path).encode("utf-8")).hexdigest()[:12] + "@" + head_of(task_path)
    set_key(task_path, text, f"adversarial-{which}", value)
    print(f"adversarial-{which}: {value}")
    if which == "plan":
        clear_plan_marker(task_path, fm.get("id", ""))
    return 0


def clear_plan_marker(task_path, tid):
    """The guard writes .reef/verifying/<id> when it allows a hunter dispatch, in the task file's checkout (the same
    walk-up as reef-guard's task_root). On a PLAN pass nothing else removed it: the tick showed `in flight: verifying:<id>`
    for a hunter that had returned, until the marker went stale (2026-10-20, qassimha 302). The pass is over once it is
    recorded, so the record clears it — only a marker naming this task file. A code pass keeps the orchestrator's `rm`:
    the verifier shares that marker and may still be reading."""
    probe = os.path.dirname(os.path.abspath(task_path))
    while not (os.path.isdir(os.path.join(probe, ".reef")) or os.path.exists(os.path.join(probe, ".git"))):
        parent = os.path.dirname(probe)
        if parent == probe:
            return
        probe = parent
    marker = os.path.join(probe, ".reef", "verifying", str(tid))
    try:
        with open(marker, encoding="utf-8") as f:
            rec = json.load(f)
        if os.path.abspath(str(rec.get("task", ""))) == os.path.abspath(task_path):
            os.unlink(marker)
            print(f"verifying marker cleared: .reef/verifying/{tid} (the plan pass is recorded)")
    except (OSError, ValueError):
        pass


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except Exception as e:
        die(f"internal error: {e}")
