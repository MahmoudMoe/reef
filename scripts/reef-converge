#!/usr/bin/env python3
# CLASS: code
"""Reef converge — the feature's Proof table executed against the branch: `missing` (test or command absent),
`contradicts` (present but red), appended to the ONE rollup under a dated ## Converge; `Converged` writes nothing.
Usage: reef-converge <feature> [--repo DIR] [--base BRANCH] [--dry-run]     Exit 0 converged · 1 findings · 2 usage
A bare test name runs through converge.test_cmd ({name}) when set, else the full gate once.
"""
import datetime
import json
import glob
import os
import re
import subprocess
import sys

TEST_RE = re.compile(r"(?<![A-Za-z0-9_])test_[a-z0-9_]+|(?<![A-Za-z0-9_])Test[A-Z][A-Za-z0-9_]*|(?:\bit|\btest|\bdescribe)\((['\"])(.+?)\1\)")
# a backticked Proof is a COMMAND when it reads like one — shell operators, a flag, a path, or a known runner up front;
# otherwise it is a test's name (vitest/jest names are sentences with spaces: `health reports database and storage ok`;
# first contact, 2026-10-17: 26 of them were run as shell and reported missing)
SHELL_OPS = re.compile(r"&&|\|\||[|;<>]|\$\(|\$\{|\s--?[a-zA-Z]|=|^!")
RUNNERS = {"sh", "bash", "zsh", "env", "npm", "npx", "pnpm", "yarn", "bun", "node", "deno", "python", "python3", "pytest", "uv", "pip",
           "go", "cargo", "make", "docker", "git", "test", "curl", "wget", "grep", "rg", "find", "ls", "cat", "diff", "cmp", "exit", "true", "false"}
TPL_FALLBACK = """---
id: NNNnn
feature: <feature-slug>
status: pending
complexity: design
effort: medium
blocked-by: []
resources: []
tier: full
touches: []
verify: judge
attempts: 0
dispatches: 0
last_failure_sig: ""
---
# NNNnn — <title>

## Scope
The feature's Proof table executed on the integrated branch: every `missing` and `contradicts` line below is fixed here.

## Acceptance Criteria
- AC-1: every Proof row of the feature holds on the branch (`reef-converge` prints Converged).

## Proof
| AC | Proof |
|---|---|
| AC-1 | `python3 scripts/reef-converge <feature> --dry-run` |

## Log
"""


SUBCOMMANDS = {"run", "test", "exec", "install", "ci", "build", "audit", "view", "grep", "diff", "log", "status", "show", "add",
               "commit", "rev-parse", "ls-files", "check", "lint", "x", "dlx", "tsc", "vitest", "jest", "pytest", "unittest"}


def looks_like_command(s):
    s = s.strip()
    if not s:
        return False
    if SHELL_OPS.search(s):
        return True
    toks = s.split()
    head = toks[0]
    if head.startswith(("./", "/", "../", "~")):
        return True
    if head not in RUNNERS:
        return False
    # a runner word up front is a command only when what follows reads like an argument: a flag, an assignment, a path,
    # a file, a subcommand, or nothing — `env defaults to the test database when unset` is a vitest name (2026-10-18,
    # row 2's review: three false "missing" lines)
    if len(toks) <= 2:
        return True
    nxt = toks[1]
    return nxt.startswith("-") or "=" in nxt or "/" in nxt or "." in nxt or nxt in SUBCOMMANDS


def die(msg, code=2):
    print(f"reef-converge: {msg}", file=sys.stderr)
    sys.exit(code)


def read(p):
    with open(p, encoding="utf-8") as f:
        return f.read()


def section(text, heading):
    m = re.search(rf"^##\s+{re.escape(heading)}\s*$(.*?)(?=^##\s|\Z)", text, re.M | re.S)
    return m.group(1) if m else None


def proofs(text):
    """[(ac id, proof string, kind)] — kind is 'cmd' (backticked command) or 'test' (a name)."""
    out = []
    acs = [l for l in (section(text, "Acceptance Criteria") or "").splitlines() if re.match(r"^\s*[-*+]\s+|^\s*\d+[.)]\s+", l)]
    table = section(text, "Proof")
    rows = {}
    if table is not None:
        for l in table.splitlines():
            # `\|` inside a cell is a literal pipe (a regex alternation in a grep), not a column break
            cells = [c.strip().replace("\\|", "|") for c in re.split(r"(?<!\\)\|", l.strip().strip("|"))]
            m = re.match(r"^\**(AC-?\d+)\**$", cells[0]) if len(cells) >= 2 else None
            if m and not re.match(r"^-+$", cells[1]):
                rows[re.sub(r"^AC-?", "AC-", m.group(1))] = cells[1]
    for i, ac in enumerate(acs, 1):
        if "HUMAN AC" in ac:
            continue
        m = re.search(r"\bAC-?(\d+)\b", ac)
        ac_id = f"AC-{m.group(1) if m else i}"
        if rows:
            p = rows.get(ac_id)
            if p is None:
                continue
            body = p.strip("`").strip()
            if re.match(r"^(~~.*~~|superseded\b.*)$", p.strip(), re.I | re.S):
                out.append((ac_id, p.strip().strip("~").strip(), "superseded"))   # replaced by a later task's row: never run
            elif re.match(r"^\[mechanic\]", p):
                out.append((ac_id, re.sub(r"^\[mechanic\]\s*", "", p).strip("`").strip(), "mechanic"))
            elif (p0 := without_notes(p)) != p:
                rows[ac_id] = p0   # a note in parentheses is commentary (2026-10-24, note n45): read the cell without it
                out += proofs_of(ac_id, p0)
            elif re.fullmatch(r"`[^`]+`\s+prints\s+`[^`]*`", p) or not p.startswith("`"):
                out += proofs_of(ac_id, p)
            elif len(re.findall(r"`[^`]+`", p)) > 1 and not re.sub(r"`[^`]+`|[,;]|\band\b|\s", "", p):
                # `a`, `b` in one cell is two proofs, each checked (2026-10-24, the trial's row 5 rollup: read as one name)
                out += [(ac_id, x.strip(), "cmd" if not TEST_RE.fullmatch(x.strip()) and looks_like_command(x) else "test")
                        for x in re.findall(r"`([^`]+)`", p)]
            elif p.startswith("`") and p.endswith("`") and not TEST_RE.fullmatch(body) and looks_like_command(body):
                out.append((ac_id, body, "cmd"))
            else:
                out.append((ac_id, body, "test"))
        else:
            for t in TEST_RE.finditer(ac):
                out.append((ac_id, t.group(2) or t.group(0), "test"))
    return out


def without_notes(p):
    """The cell without its notes: a parenthesis opened outside backticks, to its matching close (backticks inside it
    allowed); a parenthesis inside a backticked command is the command's own."""
    out, depth, code = [], 0, False
    for ch in p:
        if ch == "`":
            code = not code
        elif not code and ch == "(":
            depth += 1
            continue
        elif not code and ch == ")" and depth:
            depth -= 1
            continue
        if not depth:
            out.append(ch)
    return re.sub(r"\s+", " ", "".join(out)).strip()


def proofs_of(ac_id, p):
    """One cell, read as written (2026-10-24, the trial's row 18, note n45): `cmd` prints `N` is a command and its expected
    output; a cell of prose names no test or command and is listed, never reported missing; else a test or a command."""
    m = re.fullmatch(r"`([^`]+)`\s+prints\s+`([^`]*)`", p)
    if m:
        return [(ac_id, f"{m.group(1)}\0{m.group(2)}", "prints")]
    if not p.startswith("`"):
        return [(ac_id, p, "prose")]
    if len(re.findall(r"`[^`]+`", p)) > 1 and not re.sub(r"`[^`]+`|[,;]|\band\b|\s", "", p):
        return [(ac_id, x.strip(), "cmd" if not TEST_RE.fullmatch(x.strip()) and looks_like_command(x) else "test") for x in re.findall(r"`([^`]+)`", p)]
    body = p.strip("`").strip()
    return [(ac_id, body, "cmd" if p.endswith("`") and not TEST_RE.fullmatch(body) and looks_like_command(body) else "test")]


ASSERT_RE = re.compile(r"\bexpect\(|\bassert\b|\bshould\b")
TEST_FILE_RE = re.compile(r"(^|/)(tests?|__tests__|spec)/|\.(test|spec)\.[a-z]+$|(^|/)test_[^/]+\.py$|_test\.(go|py|rs|js|ts)$")


def assertion_changes(diff):
    """Per EXISTING test file in a unified diff: the assertion lines removed and added (whitespace-normalised). A new test
    file is allowed; a renamed path is the same file; a moved line shows up on both sides (0.7.2, first adoption, item 15)."""
    out, cur, new_file = {}, None, False
    for line in diff.splitlines():
        if line.startswith("diff --git "):
            cur = line.split(" b/", 1)[-1]
            new_file = False
            continue
        if line.startswith("new file mode"):
            new_file = True
            continue
        if line.startswith(("+++", "---")) or cur is None or new_file or not TEST_FILE_RE.search(cur):
            continue
        if line[:1] in "+-" and ASSERT_RE.search(line[1:]):
            out.setdefault(cur, ([], []))[0 if line[0] == "-" else 1].append(" ".join(line[1:].split()))
    return out


def test_exists(repo, name):
    r = subprocess.run(["git", "grep", "-l", "-F", "--", name, "--", ":!*.md"], cwd=repo, capture_output=True, text=True)
    hits = [h for h in r.stdout.splitlines() if not h.startswith((".reef/", "reef/", "docs/", "tasks/"))]
    if hits:
        return True
    r = subprocess.run(["grep", "-rlF", "--exclude-dir=.git", "--exclude-dir=.reef", "--exclude-dir=node_modules", "--exclude=*.md", name, "."],
                       cwd=repo, capture_output=True, text=True)
    return bool(r.stdout.strip())


def main(argv):
    repo, base, dry, pos = ".", None, False, []
    i = 0
    while i < len(argv):
        if argv[i] == "--repo":
            repo = argv[i + 1]; i += 2
        elif argv[i] == "--base":
            base = argv[i + 1]; i += 2
        elif argv[i] == "--dry-run":
            dry = True; i += 1
        else:
            pos.append(argv[i]); i += 1
    if len(pos) != 1:
        die("usage: reef-converge <feature> [--repo DIR] [--base BRANCH] [--dry-run]")
    feature = pos[0]
    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=repo, capture_output=True, text=True).stdout.strip() or os.path.abspath(repo)
    try:
        cfg = json.loads(read(os.path.join(root, ".reef", "config.json")))
    except Exception:
        cfg = {}
    paths = cfg.get("paths", {})
    fdir = os.path.join(root, paths.get("features", "reef/features"), feature, "tasks")
    tdir = fdir if os.path.isdir(fdir) else os.path.join(root, paths.get("tasks", "tasks"))
    tasks = []
    for d in (tdir, os.path.join(tdir, "done")):
        for f in (sorted(os.listdir(d)) if os.path.isdir(d) else []):
            if re.match(r"^\d+-.*\.md$", f):
                t = read(os.path.join(d, f))
                m = re.search(r"^feature:\s*(.*)$", t, re.M)
                if tdir == fdir or (m and m.group(1).strip().strip('"') == feature):
                    tasks.append((os.path.join(d, f), t))
    if not tasks:
        die(f"no task files for feature {feature!r}", 2)
    test_cmd = str((cfg.get("converge") or {}).get("test_cmd", "") or "")
    gate = None
    findings, mechanic_rows, superseded, prose = [], [], [], []
    for path, text in tasks:
        for ac_id, proof, kind in proofs(text):
            label = f"{os.path.basename(path)} {ac_id}"
            if kind == "superseded":
                superseded.append(f"{label}: {proof}")
                continue
            if kind == "prose":
                prose.append(f"{label}: {proof[:90]}")   # names no test or command: the verifier judged it, converge cannot
                continue
            if kind == "prints":
                cmd, want = proof.split("\0", 1)
                r = subprocess.run(["sh", "-c", cmd], cwd=root, capture_output=True, text=True)
                if r.returncode == 127:
                    findings.append(f"{label}: missing — `{cmd}` (exit 127)")
                elif r.stdout.strip() != want:
                    findings.append(f"{label}: contradicts — `{cmd}` prints {r.stdout.strip()[:40]!r}, not {want!r}")
                continue
            if kind == "mechanic":
                mechanic_rows.append(f"{label}: `{proof}`")   # writes files: the mechanic runs it, converge never does
                continue
            if kind == "cmd":
                r = subprocess.run(["sh", "-c", proof], cwd=root, capture_output=True, text=True)
                if r.returncode == 127 or "not found" in (r.stderr or "").lower() and r.returncode != 0:
                    findings.append(f"{label}: missing — `{proof}` ({r.stderr.strip()[:80] or 'exit 127'})")
                elif r.returncode != 0:
                    findings.append(f"{label}: contradicts — `{proof}` exit {r.returncode}")
                continue
            if not test_exists(root, proof):
                findings.append(f"{label}: missing — test {proof} does not exist in the tree")
                continue
            if test_cmd:
                r = subprocess.run(["sh", "-c", test_cmd.replace("{name}", proof)], cwd=root, capture_output=True, text=True)
                if r.returncode != 0:
                    findings.append(f"{label}: contradicts — {proof} fails (exit {r.returncode})")
            else:
                if gate is None:
                    gate = subprocess.run(["sh", os.path.join("scripts", "reef-gate.sh"), "full"], cwd=root, capture_output=True, text=True).returncode
                if gate != 0:
                    findings.append(f"{label}: contradicts — {proof} exists but the full gate is red (exit {gate})")
    # 0.7.2 (first adoption, item 15): a `kind: refactor` task's deterministic criterion — in the branch's diff no existing test
    # file changes an assertion line (moved code and imports allowed), and the full gate is green
    refactors = [os.path.basename(p) for p, t in tasks if re.search(r"^kind:\s*refactor\s*$", t, re.M)]
    if refactors:
        base_ref = base or str((cfg.get("branches") or {}).get("base", "main") or "main")
        r = subprocess.run(["git", "diff", "-M", "--unified=0", f"{base_ref}...HEAD"], cwd=root, capture_output=True, text=True)
        label = f"{refactors[0]} refactor"
        if r.returncode != 0:
            findings.append(f"{label}: contradicts — no diff against {base_ref} ({r.stderr.strip()[:80]})")
        else:
            for f, (rem, add) in sorted(assertion_changes(r.stdout).items()):
                if sorted(rem) != sorted(add):
                    findings.append(f"{label}: contradicts — {f} changes an assertion line ({len(rem)} removed, {len(add)} added); "
                                    "a refactor preserves behaviour, its tests stay")
            if gate is None:
                gate = subprocess.run(["sh", os.path.join("scripts", "reef-gate.sh"), "full"], cwd=root, capture_output=True, text=True).returncode
            if gate != 0:
                findings.append(f"{label}: contradicts — the full gate is red (exit {gate}); behaviour is not shown preserved")
    if superseded:
        print(f"{len(superseded)} superseded row(s) skipped (a later task's Proof replaces them):")
        for m_ in superseded:
            print(f"  - {m_}")
    if prose:
        print(f"{len(prose)} prose row(s) not run here (they name no test or command — the verifier judged them):")
        for m_ in prose:
            print(f"  - {m_}")
    if mechanic_rows:
        print(f"{len(mechanic_rows)} [mechanic] row(s) not run here (they write files — the mechanic runs them verbatim):")
        for m_ in mechanic_rows:
            print(f"  - {m_}")
    if not findings:
        print("Converged")
        return 0
    print(f"{len(findings)} finding(s):")
    for f in findings:
        print(f"  - {f}")
    if dry:
        return 1
    rollup = next((os.path.join(d, f) for d in (tdir, os.path.join(tdir, "done")) for f in (sorted(os.listdir(d)) if os.path.isdir(d) else [])
                   if re.match(r"^R\d+-.*\.md$", f) and re.search(rf"^feature:\s*{re.escape(feature)}\s*$", read(os.path.join(d, f)), re.M)), None)
    if rollup is None:
        # the template lives in the PLUGIN; this script usually runs as the project's copy under scripts/ (first contact,
        # 2026-10-17: it looked for <project>/templates/task.md and crashed, writing nothing)
        tpl = None
        for cand in (os.environ.get("CLAUDE_PLUGIN_ROOT") or "", os.path.dirname(os.path.dirname(os.path.abspath(__file__)))):
            tp = os.path.join(cand, "templates", "task.md") if cand else ""
            if tp and os.path.isfile(tp):
                tpl = read(tp)
                break
        if tpl is None:
            tpl = TPL_FALLBACK
        # a rollup id is a task id, and the graph is ONE across every feature folder (2026-10-18, qassimha row 11: its first
        # rollup took R1 because its own folder had none, row 2's R1 was already on develop, and the tick printed BROKEN)
        feats = os.path.dirname(os.path.dirname(os.path.abspath(tdir)))
        taken = [int(m.group(1)) for d in glob.glob(os.path.join(feats, "*", "tasks")) + glob.glob(os.path.join(feats, "*", "tasks", "done"))
                 for f in os.listdir(d) for m in [re.match(r"^R(\d+)-", f)] if m]
        n = 1 + max(taken, default=0)
        rollup = os.path.join(tdir, f"R{n:02d}-{feature}.md")
        # complete, no placeholders: the orchestrator used to hand-fill the template, and two features' rollups both
        # claimed the literal `reef-converge <feature> --dry-run` (2026-10-19, qassimha row 68)
        text = (f"---\nid: R{n}\nfeature: {feature}\nstatus: pending\ncomplexity: design\neffort: medium\nblocked-by: []\n"
                f"resources: []\ntier: full\ntouches: []\nverify: judge\nattempts: 0\ndispatches: 0\nlast_failure_sig: \"\"\n---\n"
                f"# R{n} — {feature} rollup\n\n## Scope\nThe feature's Proof rows run on the integrated branch; every `missing` or "
                f"`contradicts` line under Converge below is fixed here, or closed with its reason.\n\n"
                f"## Acceptance Criteria\n- AC-1: every Proof row of the feature holds on the integrated branch.\n\n"
                f"## Proof\n| AC | Proof |\n|---|---|\n| AC-1 | `python3 scripts/reef-converge {feature} --dry-run` |\n\n## Log\n")
        with open(rollup, "w", encoding="utf-8") as f:
            f.write(text)
        print(f"rollup created: {os.path.relpath(rollup, root)}")
    # the findings go BEFORE ## Log (the last section); a later run adds its own dated section there too
    with open(rollup, encoding="utf-8") as f:
        body = f.read()
    block = f"## Converge {datetime.date.today().isoformat()}\n" + "".join(f"- {x}\n" for x in findings) + "\n"
    m = re.search(r"^## Log[ \t]*$", body, re.M)
    body = body[:m.start()] + block + body[m.start():] if m else body.rstrip("\n") + "\n\n" + block
    with open(rollup, "w", encoding="utf-8") as f:
        f.write(body)
    print(f"appended to {os.path.relpath(rollup, root)}")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
