#!/usr/bin/env python3
# CLASS: code
"""Reef recalibrate — an existing project's documents into Reef's structure: planned, then applied under one approval.
  reef-recalibrate plan    [--repo DIR]      reef/recalibration.md + .reef/recalibration.json (create/convert/move/keep + reason)
  reef-recalibrate history [--repo DIR]      how it was pushed: branches, commit convention, merge style, tags, CI → derived branches.*
  reef-recalibrate measure [--json] [--repo DIR]   (0.7.2) counts, not judgments, into reef/day-zero.md ## Measured: largest product
                                             files, product vs test LOC, raw SQL by directory, functions/triggers per migration,
                                             linter, existing guard tests; reef/size-baseline.json; files over assess.large_file
                                             as candidate refactor rows in reef/recalibration.md
  reef-recalibrate --apply [--repo DIR] [--list plan.json] [--no-commit]   ONE commit; undo = git revert
decision → ADR with Supersedes: (Nygard + one-line statement); spec for open work → feature folder + queue row;
glossary → merged; else → reef/archive/<date>/<path> with README index. README/LICENSE/CONTRIBUTING/SECURITY/
CHANGELOG/CODEOWNERS, docs a docs build serves and files referenced from code/CI are kept unless the owner's list
says move. Relative links rewritten; a broken link refuses and restores the tree. Exit 0 · 1 refused/nothing · 2 usage.
"""
import datetime
import json
import os
import re
import subprocess
import sys

KEEP = {"README.md", "LICENSE", "LICENSE.md", "CONTRIBUTING.md", "SECURITY.md", "CHANGELOG.md", "CODEOWNERS", "CODE_OF_CONDUCT.md", "AGENTS.md", "CLAUDE.md", "HANDOFF.md"}
DECISION_DIR = re.compile(r"(^|/)(adr|adrs|decisions?|rfcs?)(/|$)", re.I)
SPEC_DIR = re.compile(r"(^|/)(specs?|requirements|features?)(/|$)|spec\.md$|-spec\.md$|_spec\.md$", re.I)
RUNBOOK = re.compile(r"runbook|operations|how[-_ ]?to|guide|playbook|onboarding", re.I)
LINK = re.compile(r"(!?\[[^\]]*\]\()([^)\s#]+)(#[^)]*)?(\))")


def die(msg, code=2):
    print(f"reef-recalibrate: {msg}", file=sys.stderr)
    sys.exit(code)


def git(root, *a, check=True):
    r = subprocess.run(["git", "-C", root, *a], capture_output=True, text=True)
    if check and r.returncode != 0:
        die(f"git {' '.join(a[:2])} failed: {r.stderr.strip()[:200]}", 1)
    return r.stdout


def read(p):
    with open(p, encoding="utf-8", errors="replace") as f:
        return f.read()


def served_dirs(root):
    out = set()
    if os.path.isfile(os.path.join(root, "mkdocs.yml")):
        m = re.search(r"^docs_dir:\s*(\S+)", read(os.path.join(root, "mkdocs.yml")), re.M)
        out.add((m.group(1) if m else "docs").strip("/"))
    for cand in ("docusaurus.config.js", "docusaurus.config.ts", "docusaurus.config.mjs", "docs/package.json"):
        if os.path.isfile(os.path.join(root, cand)):
            out.add("docs")
    for dp, dn, fn in os.walk(root):
        dn[:] = [d for d in dn if d not in (".git", "node_modules", ".reef", ".venv")]
        if "conf.py" in fn and any(x.endswith((".rst", ".md")) for x in fn):
            out.add(os.path.relpath(dp, root).strip("./"))
    return {d for d in out if d}


def referenced_by(root, rel):
    # "referenced from code, CI or the docs build": never from Reef's own plan (.reef/recalibration.json lists every
    # document, which made every document "kept" on a second run — 0.7 dogfood) nor from logs and evidence dumps
    r = subprocess.run(["git", "-C", root, "grep", "-l", "-F", "--", rel, "--", ":!*.md", ":!.reef/**", ":!*.log", ":!*.txt"],
                       capture_output=True, text=True)
    return [l for l in r.stdout.splitlines() if l]


def classify(root, rel, text, served):
    base = os.path.basename(rel)
    if base in KEEP:
        return "keep", "project file (README, LICENSE, CONTRIBUTING, SECURITY, CHANGELOG, CODEOWNERS)"
    if rel.startswith(("reef/", ".reef/", ".github/", ".claude/", "tasks/")):
        return "keep", "already in the layout"
    if any(rel == d or rel.startswith(d + "/") for d in served):
        return "keep", "served by the docs build"
    refs = referenced_by(root, rel)
    if refs:
        return "keep", f"referenced by {refs[0]}" + (f" (+{len(refs) - 1})" if len(refs) > 1 else "")
    if DECISION_DIR.search(rel) or re.search(r"^#+\s*(Decision|Status|Context)\b", text, re.M | re.I) and re.search(r"^#+\s*Consequences", text, re.M | re.I):
        return "convert-adr", "a decision record (ADR/RFC shape)"
    if base.lower() == "glossary.md":
        return "merge-glossary", "a glossary"
    if SPEC_DIR.search(rel):
        if re.search(r"^Status:\s*(done|shipped|implemented|merged)", text, re.M | re.I):
            return "archive", "a spec whose work is done"
        return "convert-feature", "a spec for open work"
    if RUNBOOK.search(rel) or RUNBOOK.search(text[:400]):
        return "archive", "a runbook / process document"
    if re.search(r"\b(TODO|draft|deprecated|obsolete)\b", text[:600], re.I):
        return "archive", "stale"
    return "archive", "a process document outside the layout"


GENERIC = {"misc", "fixes", "feature", "update", "stuff", "changes", "work", "tasks", "new", "todo", "wip", "spec", "md", "the", "a", "an", "of", "for"}


def slugify(name, title=""):
    """2-5 descriptive kebab words: the file or directory name first, the document's title when that is too short."""
    for cand in (name, title, f"{name} {title}"):
        s = re.sub(r"[^a-z0-9]+", "-", cand.lower()).strip("-")
        words = [w for w in s.split("-") if w and w not in GENERIC and not w.isdigit()]
        while words and re.match(r"^\d", words[0]):       # a leading id token (`014a`, `572a`) is not a word (ai-coach: 96 of them)
            words.pop(0)
        if len(words) >= 2:
            return "-".join(words[:5])
    words = [w for w in re.sub(r"[^a-z0-9]+", "-", name.lower()).split("-") if w] or ["recalibrated"]
    return "-".join(words[:4] + ["slice"])


def cmd_history(root):
    log = git(root, "log", "--format=%s%x00%P", "-n", "400", check=False).splitlines()
    subjects = [l.split("\0")[0] for l in log if l]
    merges = sum(1 for l in log if len(l.split("\0")[-1].split()) > 1)
    authored = [l.split("\0")[0] for l in log if l and len(l.split("\0")[-1].split()) <= 1]   # merge commits are generated, not written
    conventional = sum(1 for s in authored if re.match(r"^(feat|fix|chore|docs|refactor|test|build|ci|perf|style)(\(.+\))?!?:", s))
    branches = [b.strip().replace("origin/", "") for b in git(root, "branch", "-a", "--format=%(refname:short)", check=False).splitlines()]
    branches = sorted({b for b in branches if b and not b.endswith("HEAD")})
    tags = git(root, "tag", "-l", check=False).split()
    base, release = "main", "main"
    for cand in ("develop", "dev", "integration", "staging"):
        if cand in branches:
            base = cand
            break
    release = "main" if "main" in branches else ("master" if "master" in branches else base)
    if base == release and base not in branches and branches:
        base = release = branches[0]
    ci = []
    wf = os.path.join(root, ".github", "workflows")
    for f in (sorted(os.listdir(wf)) if os.path.isdir(wf) else []):
        t = read(os.path.join(wf, f))
        trig = re.search(r"^on:\s*(.*?)(?=^\S)", t + "\nX", re.M | re.S)
        ci.append({"file": f, "on": " ".join((trig.group(1) if trig else "").split())[:120]})
    out = {"commits_sampled": len(subjects), "conventional_commits_share": round(conventional / len(authored), 2) if authored else None,
           "merge_commits": merges, "merge_style": "merge" if merges > len(subjects) // 10 else "squash-or-rebase",
           "branches": branches, "tags": tags[:20], "semver_tags": all(re.match(r"^v?\d+\.\d+\.\d+", t) for t in tags) if tags else None,
           "derived": {"branches.base": base, "branches.release": release, "merge.by": "loop" if base != release else "human",
                       "ci.feature_gate": "local" if base != release else "ci"}, "ci": ci}
    return out


def build_plan(root):
    served = served_dirs(root)
    date = datetime.date.today().isoformat()
    files = [l for l in git(root, "ls-files", "--", "*.md", "**/*.md", check=False).splitlines() if l.endswith(".md")]
    plan, n, taken = [], 0, set()
    for rel in sorted(files):
        text = read(os.path.join(root, rel))
        action, reason = classify(root, rel, text, served)
        entry = {"path": rel, "action": action, "reason": reason}
        title = (re.search(r"^#\s+(.+)$", text, re.M) or [None, ""])[1] if re.search(r"^#\s+(.+)$", text, re.M) else ""
        if action == "convert-adr":
            entry["adr_slug"] = slugify(os.path.splitext(os.path.basename(rel))[0], title)
        if action == "convert-feature":
            stem = os.path.splitext(os.path.basename(rel))[0] if os.path.basename(rel).lower() != "spec.md" else os.path.basename(os.path.dirname(rel))
            feat = base = slugify(stem, title)
            k = 2
            while feat in taken:                           # two specs, one slug: the second must not overwrite the first's SPEC.md
                feat = f"{base}-{k}"
                k += 1
            taken.add(feat)
            entry["feature"] = feat
        if action != "keep":
            entry["archive"] = f"reef/archive/{date}/{rel}"
        plan.append(entry)
    hist = cmd_history(root)
    return {"date": date, "entries": plan, "history": hist, "create": ["reef/constitution.md", "reef/queue.md", "reef/journal.md", "reef/glossary.md",
                                                                     "reef/architecture/", "reef/features/README.md", f"reef/archive/{date}/", "reef/archive/README.md"]}


def render_plan(plan):
    lines = [f"# Recalibration — {plan['date']}", "",
             "The full plan of what `scripts/reef-recalibrate --apply` will create, convert, move and keep — one line each, with its reason. "
             "Nothing moves before the owner approves this list (edit a line's action to change it; `keep` lines move only when you change them). "
             "Undo is `git revert` of the apply commit.", "", "## Create", ""]
    lines += [f"- create `{c}`" for c in plan["create"]]
    lines += ["", "## Documents", "", "| action | path | → | reason |", "|---|---|---|---|"]
    for e in plan["entries"]:
        dest = {"convert-adr": f"reef/architecture/adr/NNNN-{e.get('adr_slug', '')}.md (+ archive)",
                "convert-feature": f"reef/features/{e.get('feature', '')}/SPEC.md (+ queue row, + archive)",
                "merge-glossary": "reef/glossary.md (+ archive)", "archive": e.get("archive", ""), "keep": "—"}[e["action"]]
        lines.append(f"| {e['action']} | `{e['path']}` | {dest} | {e['reason']} |")
    h = plan["history"]
    lines += ["", "## How it was pushed (derived)", "",
              f"- branches: {', '.join(h['branches']) or 'none'} → `branches.base` {h['derived']['branches.base']}, `branches.release` {h['derived']['branches.release']}, `merge.by` {h['derived']['merge.by']}",
              f"- commits sampled {h['commits_sampled']}, conventional-commits share {h['conventional_commits_share']}, merge style {h['merge_style']} ({h['merge_commits']} merge commits)",
              f"- tags: {', '.join(h['tags'][:8]) or 'none'} (semver: {h['semver_tags']})",
              "- CI: " + ("; ".join(f"{c['file']} on {c['on']}" for c in h["ci"]) or "none")]
    return "\n".join(lines) + "\n"


def cmd_plan(root):
    plan = build_plan(root)
    os.makedirs(os.path.join(root, "reef"), exist_ok=True)
    os.makedirs(os.path.join(root, ".reef"), exist_ok=True)
    with open(os.path.join(root, "reef", "recalibration.md"), "w", encoding="utf-8") as f:
        f.write(render_plan(plan))
    with open(os.path.join(root, ".reef", "recalibration.json"), "w", encoding="utf-8") as f:
        json.dump(plan, f, indent=1)
    moving = [e for e in plan["entries"] if e["action"] != "keep"]
    print(f"plan written: reef/recalibration.md — {len(moving)} document(s) to convert or move, {len(plan['entries']) - len(moving)} kept")
    return 0


def dead_links(root):
    """(file, target) of every relative Markdown link that does not resolve in the tree as it stands."""
    out = set()
    files = [l for l in git(root, "ls-files", "--", "*.md", "**/*.md", check=False).splitlines() if l.endswith(".md")]
    for rel in files:
        p = os.path.join(root, rel)
        if not os.path.isfile(p):
            continue
        here = os.path.dirname(rel)
        for m in LINK.finditer(read(p)):
            target = m.group(2)
            if re.match(r"^[a-z]+:", target) or target.startswith("/") or target.startswith("<"):
                continue
            if not os.path.exists(os.path.join(root, os.path.normpath(os.path.join(here, target)))):
                out.add((rel, target))
    return out


def rewrite_links(root, moved, touched_files, dead_before=frozenset()):
    """Relative links in every Markdown file: a link to a moved file points at its new home; then every relative
    link must resolve. Returns (broken, already_dead): links the apply broke, and links dead before it (keyed by the
    file's ORIGINAL path, so a dead link that travelled with its document is recognised and never blocks the apply)."""
    broken, already_dead = [], []
    files = [l for l in git(root, "ls-files", "--", "*.md", "**/*.md", check=False).splitlines() if l.endswith(".md")]
    files = sorted(set(files) | set(touched_files))
    came_from = {new: old for old, new in moved.items()}   # a moved file's links were written from its OLD directory
    for rel in files:
        p = os.path.join(root, rel)
        if not os.path.isfile(p):
            continue
        text = read(p)
        here = os.path.dirname(rel)
        m_arch = re.match(r"^reef/archive/[^/]+/(.+)$", rel)      # an archived original keeps its old path under the date
        src = came_from.get(rel) or (m_arch.group(1) if m_arch else rel)
        origin = os.path.dirname(src)

        def fix(m):
            target = m.group(2)
            if re.match(r"^[a-z]+:", target) or target.startswith("/"):
                return m.group(0)
            abs_target = os.path.normpath(os.path.join(here, target))
            if abs_target in moved:
                new = os.path.relpath(moved[abs_target], here or ".")
                return f"{m.group(1)}{new}{m.group(3) or ''}{m.group(4)}"
            if src != rel and not os.path.exists(os.path.join(root, abs_target)):
                # this file moved; the link was relative to where it came from — a sibling that STAYS (kept:
                # referenced by code) or moved elsewhere. Seen live (0.7 dogfood, ai-coach): the apply refused
                # on `design-decisions.md` beside a converted spec, a file the plan itself kept.
                from_origin = os.path.normpath(os.path.join(origin, target))
                dest = moved.get(from_origin, from_origin)
                if os.path.exists(os.path.join(root, dest)):
                    return f"{m.group(1)}{os.path.relpath(dest, here or '.')}{m.group(3) or ''}{m.group(4)}"
            return m.group(0)
        new_text = LINK.sub(fix, text)
        if new_text != text:
            with open(p, "w", encoding="utf-8") as f:
                f.write(new_text)
        for m in LINK.finditer(new_text):
            target = m.group(2)
            if re.match(r"^[a-z]+:", target) or target.startswith("/") or target.startswith("<"):
                continue
            if not os.path.exists(os.path.join(root, os.path.normpath(os.path.join(here, target)))):
                (already_dead if (src, target) in dead_before else broken).append(f"{rel}: {target}")
    return broken, already_dead


def relink(text, old_rel, new_rel):
    """Text copied from old_rel into new_rel: every relative link keeps pointing at the same file."""
    old_dir, new_dir = os.path.dirname(old_rel), os.path.dirname(new_rel)

    def fix(m):
        t = m.group(2)
        if re.match(r"^[a-z]+:", t) or t.startswith(("/", "<")):
            return m.group(0)
        return f"{m.group(1)}{os.path.relpath(os.path.normpath(os.path.join(old_dir, t)), new_dir or '.')}{m.group(3) or ''}{m.group(4)}"
    return LINK.sub(fix, text)


def to_adr(text, number, slug, rel, archive):
    text = relink(text, rel, f"reef/architecture/adr/{number:04d}-{slug}.md")
    title = (re.search(r"^#\s+(.+)$", text, re.M) or [None, slug])[1] if re.search(r"^#\s+(.+)$", text, re.M) else slug.replace("-", " ")
    sec = lambda h: (re.search(rf"^#+\s*{h}\s*$(.*?)(?=^#+\s|\Z)", text, re.M | re.S) or [None, ""])[1].strip() if re.search(rf"^#+\s*{h}\s*$", text, re.M | re.I) else ""
    ctx, dec, con = sec("Context") or text.strip()[:600], sec("Decision") or "(see the original, archived below)", sec("Consequences") or "+ (see the original)\n- (see the original)"
    one = f"In the context of {title}, facing {ctx.splitlines()[0][:80] if ctx else 'the forces below'}, we decided {dec.splitlines()[0][:80]}, to achieve what the Decision states, accepting the Consequences below."
    return (f"# ADR {number:04d} — {title}\n\nStatus: Accepted\nSupersedes: {archive}\n\n{one}\n\n## Context\n{ctx}\n\n## Decision\n{dec}\n\n"
            f"## Consequences\n{con}\n\n## Diagram\n```mermaid\nflowchart LR\n  decision[{slug}] --> system\n```\n")


def to_spec(text, feature, row, archive, rel=""):
    text = relink(text, rel, f"reef/features/{feature}/SPEC.md") if rel else text
    title = (re.search(r"^#\s+(.+)$", text, re.M) or [None, feature])[1] if re.search(r"^#\s+(.+)$", text, re.M) else feature
    bullets = [l.strip()[2:] for l in text.splitlines() if l.strip().startswith(("- ", "* "))][:12] or [title]
    frs = "\n".join(f"- FR-{i} [backend]: {b}" for i, b in enumerate(bullets, 1))
    return (f"# {title} — SPEC\n\nRow: {row}\nSlug: {feature}\nSupersedes: {archive}\n\n## Intent\n{title}: carried over from the original spec (archived).\n\n## Grill\n- Q: (none yet) — A: (none yet)\n\n"
            f"## Scope\n{text.strip()[:400]}\n\n## Non-goals\n(carry the original's non-goals here)\n\n## Already shipped\nnone\n\n## Requirements\n{frs}\n\n"
            f"## Success criteria\n- SC-1: the original spec's outcome is observable.\n\n## Owner decisions\n- (none yet)\n\n## Architecture impact\n(to be stated)\n")


# ---------------------------------------------------------------- measure (0.7.2, ai-coach 2026-10-24, item 10)
# /reef-assess scored "module boundaries" by feel; nothing was counted. On ai-coach the largest files were tests and i18n
# dictionaries, the `$executeRawUnsafe` hits were mostly comments, and the tagged `$queryRaw` calls were parameterised.
CODE_EXT = (".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".py", ".go", ".rs", ".java", ".kt", ".rb", ".php", ".cs", ".swift",
            ".vue", ".svelte")   # schema and migration files are counted in their own table, never as product
TEST_FILE = re.compile(r"(^|/)(tests?|__tests__|spec)/|\.(test|spec)\.[a-z]+$|(^|/)test_[^/]+\.py$|_test\.(go|py|rs|js|ts)$")
GENERATED = re.compile(r"(^|/)(node_modules|dist|build|out|coverage|\.next|\.turbo|generated|__generated__|\.prisma|target|vendor|\.venv)(/|$)")
DATA_DIR = re.compile(r"(^|/)(i18n|locales|interface|translations)(/|$)")
RAW_TAGGED = re.compile(r"\$(query|execute)Raw(?!Unsafe)\b")
RAW_UNSAFE = re.compile(r"\$(query|execute)RawUnsafe\b")
SQL_FUNC = re.compile(r"^\s*CREATE\s+(OR\s+REPLACE\s+)?FUNCTION\b", re.I | re.M)
SQL_TRIG = re.compile(r"^\s*CREATE\s+(OR\s+REPLACE\s+)?TRIGGER\b", re.I | re.M)
LINTERS = (".eslintrc", ".eslintrc.js", ".eslintrc.cjs", ".eslintrc.json", ".eslintrc.yml", ".eslintrc.yaml", "eslint.config.js",
           "eslint.config.mjs", "eslint.config.cjs", "eslint.config.ts", "biome.json", "biome.jsonc", ".golangci.yml", ".golangci.yaml",
           "ruff.toml", ".ruff.toml", ".flake8", ".pylintrc", "rustfmt.toml", ".rubocop.yml")
GUARD_NAME = re.compile(r"guard|forbid|never|no-|aimed|boundar|invariant|rules?\b|lint|allowlist|denylist", re.I)
GUARD_TEXT = re.compile(r"\b(forbids?|forbidden|must not|never|disallow\w*|not allowed|refuses?|rejects?|may not)\b", re.I)


def count_lines(p):
    try:
        with open(p, "rb") as f:
            return sum(1 for _ in f)
    except OSError:
        return 0


def measure(root):
    """The facts /reef-assess used to guess: largest product files, product vs test LOC, raw SQL by directory (node/Prisma;
    comment lines ignored), functions and triggers per migration (Observed; their classification is Inferred, by Explore),
    the linter, the project's existing guard tests, and the files over `assess.large_file` as candidate refactor rows."""
    import fnmatch
    cfg_p = os.path.join(root, ".reef", "config.json")
    cfg = json.loads(read(cfg_p)) if os.path.isfile(cfg_p) else {}
    a = cfg.get("assess") or {}
    excl = [str(x) for x in (a.get("exclude") or [])]
    large = int(a.get("large_file") or 800)
    files = [l for l in git(root, "ls-files", "-co", "--exclude-standard", check=False).splitlines() if l]
    excluded = lambda rel: any(fnmatch.fnmatch(rel, g) or rel.startswith(g.rstrip("/") + "/") for g in excl)
    product, tests = {}, {}
    for rel in files:
        if not rel.endswith(CODE_EXT) or rel.endswith(".d.ts") or GENERATED.search(rel) or DATA_DIR.search(rel) or excluded(rel):
            continue
        (tests if TEST_FILE.search(rel) else product)[rel] = count_lines(os.path.join(root, rel))
    largest = sorted(product.items(), key=lambda kv: (-kv[1], kv[0]))[:10]
    # raw SQL: node + Prisma only, by the file's directory; a comment line never counts
    pkg_p = os.path.join(root, "package.json")
    deps = {}
    if os.path.isfile(pkg_p):
        try:
            pkg = json.loads(read(pkg_p))
            deps = {**(pkg.get("dependencies") or {}), **(pkg.get("devDependencies") or {})}
        except ValueError:
            pass
    raw = {}
    prisma = "prisma" in deps or "@prisma/client" in deps
    if prisma:
        for rel in sorted(product) + sorted(tests):
            if not rel.endswith((".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs")):
                continue
            with open(os.path.join(root, rel), encoding="utf-8", errors="replace") as f:
                for line in f:
                    s = line.strip()
                    if s.startswith(("//", "*", "/*", "#")):
                        continue
                    d = os.path.dirname(rel) or "."
                    if RAW_UNSAFE.search(s):
                        raw.setdefault(d, {"tagged": 0, "unsafe": 0, "files": []})["unsafe"] += 1
                        raw[d]["files"].append(rel) if rel not in raw[d]["files"] else None
                    elif RAW_TAGGED.search(s):
                        raw.setdefault(d, {"tagged": 0, "unsafe": 0, "files": []})["tagged"] += 1
    migrations = {}
    for rel in files:
        if rel.endswith(".sql") and re.search(r"(^|/)(migrations?|migrate|supabase/migrations|alembic)(/|$)", rel):
            text = read(os.path.join(root, rel))
            migrations[rel] = {"functions": len(SQL_FUNC.findall(text)), "triggers": len(SQL_TRIG.findall(text))}
    linter = next((f for f in LINTERS if os.path.isfile(os.path.join(root, f))), None)
    if not linter and os.path.isfile(os.path.join(root, "pyproject.toml")) and re.search(r"^\[tool\.(ruff|flake8|pylint)", read(os.path.join(root, "pyproject.toml")), re.M):
        linter = "pyproject.toml [tool.ruff]"
    guards = []
    for rel in sorted(tests):
        head = "".join(open(os.path.join(root, rel), encoding="utf-8", errors="replace").readlines()[:30])
        if GUARD_NAME.search(os.path.basename(rel)) or GUARD_TEXT.search(head):
            guards.append(rel)
    big = [(rel, n) for rel, n in sorted(product.items(), key=lambda kv: (-kv[1], kv[0])) if n > large]
    return {"date": datetime.date.today().isoformat(), "product": {"loc": sum(product.values()), "files": len(product)},
            "tests": {"loc": sum(tests.values()), "files": len(tests)}, "largest": largest,
            "raw_sql": raw if prisma else None, "raw_sql_note": "" if prisma else "not measured (node + Prisma only; other stacks later)",
            "migrations": migrations, "linter": linter, "guard_tests": guards, "large_file": large, "large_files": big,
            "baseline": product}


def render_measured(m):
    lines = ["## Measured", "",
             f"Counted by `python3 scripts/reef-recalibrate measure` on {m['date']} — Observed, not judged. Tests, `*.d.ts`, generated and "
             "data directories (`i18n`, `locales`, `interface`, `translations`) and `assess.exclude` are left out of the product set.", "",
             f"- Product: {m['product']['loc']:,} lines in {m['product']['files']} files · tests: {m['tests']['loc']:,} lines in {m['tests']['files']} files",
             f"- Linter: {'yes (' + m['linter'] + ')' if m['linter'] else 'no'}", "", "### Largest product files", "", "| lines | file |", "|---|---|"]
    lines += [f"| {n} | `{rel}` |" for rel, n in m["largest"]] or ["| – | none |"]
    lines += ["", "### Raw SQL by directory (comment lines ignored)", ""]
    if m["raw_sql"] is None:
        lines.append(m["raw_sql_note"])
    else:
        lines += ["| directory | tagged `$queryRaw`/`$executeRaw` | `…Unsafe` | Unsafe in |", "|---|---|---|---|"]
        lines += [f"| `{d}` | {v['tagged']} | {v['unsafe']} | {', '.join('`' + f + '`' for f in v['files']) or '–'} |" for d, v in sorted(m["raw_sql"].items())] or ["| – | 0 | 0 | – |"]
    lines += ["", "### Functions and triggers per migration (Observed; integrity rule or product rule is Inferred, by Explore)", "",
              "| migration | CREATE FUNCTION | CREATE TRIGGER |", "|---|---|---|"]
    lines += [f"| `{rel}` | {v['functions']} | {v['triggers']} |" for rel, v in sorted(m["migrations"].items()) if v["functions"] or v["triggers"]] or ["| – | 0 | 0 |"]
    lines += ["", "### Existing guard tests (reuse before adding a gate)", ""]
    lines += [f"- `{g}`" for g in m["guard_tests"]] or ["- none found"]
    lines += ["", f"### Files over `assess.large_file` ({m['large_file']} lines) — candidate `kind: refactor` rows, proposed in reef/recalibration.md, never created here", ""]
    lines += [f"- `{rel}` ({n} lines)" for rel, n in m["large_files"]] or ["- none"]
    return "\n".join(lines) + "\n"


RAW_GUARD = re.compile(r"raw|sql|unsafe|inject", re.I)


def raw_sql_proposal(m):
    """Item 12's proposal (0.7.2): the files holding an Unsafe raw query today become `assess.raw_sql_allow` — a baseline, not a
    cleanup — and `reef-structure --raw-sql` joins gates.extra; when the project already has a guard test about raw SQL,
    that test is named instead of a new gate."""
    if not m.get("raw_sql"):
        return None
    allow = sorted({f for v in m["raw_sql"].values() for f in v["files"]})
    reuse = [g for g in m.get("guard_tests") or [] if RAW_GUARD.search(os.path.basename(g))]
    return {"allow": allow, "reuse": reuse, "gate": "python3 scripts/reef-structure --raw-sql"}


def render_raw_sql(p):
    if p is None:
        return "## Proposed gate — raw SQL\n\nNot measured for this stack (node + Prisma only); nothing proposed.\n"
    lines = ["## Proposed gate — raw SQL (node + Prisma)", ""]
    if p["reuse"]:
        lines += [f"The project already guards raw SQL: {', '.join('`' + g + '`' for g in p['reuse'])} — reuse it (keep it in `gates.full`); no new gate is proposed."]
    else:
        lines += ["On approval the owner adds to `.reef/config.json`: `assess.raw_sql_allow: " + json.dumps(p["allow"]) +
                  "` (today's files with an Unsafe raw query — a baseline, not a cleanup) and to `gates.extra`: `\"raw-sql\": \"" + p["gate"] +
                  "\"`. Day one is green; a new `$queryRawUnsafe`/`$executeRawUnsafe` outside those files fails."]
    return "\n".join(lines) + "\n"


def cmd_measure(root, as_json):
    m = measure(root)
    m["raw_sql_proposal"] = raw_sql_proposal(m)
    if as_json:
        print(json.dumps(m, indent=1))
    dz = os.path.join(root, "reef", "day-zero.md")
    os.makedirs(os.path.dirname(dz), exist_ok=True)
    text = read(dz) if os.path.isfile(dz) else "# Day zero\n"
    sec = re.search(r"^## Measured\n.*?(?=^## |\Z)", text, re.M | re.S)
    block = render_measured(m)
    text = text[:sec.start()] + block + text[sec.end():] if sec else text.rstrip("\n") + "\n\n" + block
    with open(dz, "w", encoding="utf-8") as f:
        f.write(text)
    with open(os.path.join(root, "reef", "size-baseline.json"), "w", encoding="utf-8") as f:
        json.dump({"generated": m["date"], "large_file": m["large_file"], "files": dict(sorted(m["baseline"].items()))}, f, indent=1)
        f.write("\n")
    rp = os.path.join(root, "reef", "recalibration.md")
    rows = [f"| `{rel}` | {n} | `kind: refactor` · `splits: {rel} under {m['large_file']} lines` |" for rel, n in m["large_files"]]
    prop = ("## Proposed rows (refactor)\n\nFiles over `assess.large_file`; each becomes a `kind: refactor` row only when the owner approves this "
            "plan — never created by the measure.\n\n| file | lines | row |\n|---|---|---|\n" + ("\n".join(rows) if rows else "| – | – | none |") + "\n")
    rtext = read(rp) if os.path.isfile(rp) else f"# Recalibration — {m['date']}\n\n"
    rsec = re.search(r"^## Proposed rows \(refactor\)\n.*?(?=^## |\Z)", rtext, re.M | re.S)
    rtext = rtext[:rsec.start()] + prop + rtext[rsec.end():] if rsec else rtext.rstrip("\n") + "\n\n" + prop
    qsec = re.search(r"^## Proposed gate — raw SQL.*?\n.*?(?=^## |\Z)", rtext, re.M | re.S)
    qprop = render_raw_sql(m["raw_sql_proposal"])
    rtext = rtext[:qsec.start()] + qprop + rtext[qsec.end():] if qsec else rtext.rstrip("\n") + "\n\n" + qprop
    with open(rp, "w", encoding="utf-8") as f:
        f.write(rtext)
    if not as_json:
        print(f"measured: {m['product']['files']} product files ({m['product']['loc']:,} lines), {m['tests']['files']} test files; "
              f"{len(m['large_files'])} over {m['large_file']} lines; linter {'yes' if m['linter'] else 'no'}; {len(m['guard_tests'])} guard test(s) — "
              "reef/day-zero.md ## Measured, reef/size-baseline.json, reef/recalibration.md ## Proposed rows")
    return 0


def cmd_apply(root, list_path, commit):
    plan_path = list_path or os.path.join(root, ".reef", "recalibration.json")
    if not os.path.isfile(plan_path):
        die("no plan — run `reef-recalibrate plan` first (the owner approves reef/recalibration.md)", 1)
    plan = json.loads(read(plan_path))
    if list_path and list_path.endswith(".md"):
        die("--list takes the JSON plan (edit the action column of .reef/recalibration.json)", 2)
    date = plan["date"]
    entries = [e for e in plan["entries"] if e["action"] != "keep" and os.path.isfile(os.path.join(root, e["path"]))]
    if not entries:
        print("nothing to do: every document is in the layout or kept")
        return 1
    if git(root, "status", "--porcelain", check=False).strip():
        die("the working tree is not clean — the apply is one commit, undone by one revert", 1)
    dead_before = dead_links(root)   # the apply answers for the links IT breaks, not for ones dead already (ai-coach had 7)
    cfg_path = os.path.join(root, ".reef", "config.json")
    cfg = json.loads(read(cfg_path)) if os.path.isfile(cfg_path) else {}
    paths = cfg.get("paths", {})
    queue_path = os.path.join(root, paths.get("queue", "reef/queue.md"))
    moved, touched, created = {}, [], []
    arch_adr = os.path.join(root, "reef", "architecture", "adr")
    os.makedirs(arch_adr, exist_ok=True)
    numbered = [int(m.group(1)) for d in (arch_adr, os.path.join(root, paths.get("adr", "docs/adr"))) if os.path.isdir(d) for f in os.listdir(d) for m in [re.match(r"^(\d{4})-", f)] if m]
    nxt = (max(numbered) + 1) if numbered else 1
    next_row = 1
    if os.path.isfile(queue_path):
        ids = [int(m.group(1)) for m in re.finditer(r"^\|\s*(\d+)\s*\|", read(queue_path), re.M)]
        next_row = (max(ids) + 1) if ids else 1
    on_issues = (cfg.get("queue") or {}).get("home") == "issues"
    if on_issues:   # 0.7.1: the rows live on issues, the file holds none: the next id comes from the queue script
        r = subprocess.run([sys.executable, os.path.join(os.path.dirname(os.path.abspath(__file__)), "reef-queue.py"), "next-id",
                            "--repo", root], capture_output=True, text=True)
        if r.returncode != 0 or not r.stdout.strip().isdigit():
            die(f"the queue is on issues and its next id is unknown ({(r.stderr or r.stdout).strip()[:200]}); nothing moved", 1)
        next_row = int(r.stdout.strip())
    index = ["# Archive", "", f"Moved by `scripts/reef-recalibrate --apply` on {date}; undo with `git revert` of that commit. Deleting this directory is a later queue row.", "",
             "| original | new home | reason |", "|---|---|---|"]
    gloss_terms = []
    for e in entries:
        rel, arch = e["path"], e["archive"]
        text = read(os.path.join(root, rel))
        os.makedirs(os.path.dirname(os.path.join(root, arch)), exist_ok=True)
        git(root, "mv", rel, arch)
        moved[rel] = arch
        touched.append(arch)
        home = arch
        if e["action"] == "convert-adr":
            new = f"reef/architecture/adr/{nxt:04d}-{e['adr_slug']}.md"
            with open(os.path.join(root, new), "w", encoding="utf-8") as f:
                f.write(to_adr(text, nxt, e["adr_slug"], rel, arch))
            nxt += 1
            moved[rel] = new
            created.append(new)
            home = f"{new} (original under {arch})"
        elif e["action"] == "convert-feature":
            feat = e["feature"]
            new = f"reef/features/{feat}/SPEC.md"
            os.makedirs(os.path.join(root, "reef", "features", feat, "tasks", "done"), exist_ok=True)
            with open(os.path.join(root, new), "w", encoding="utf-8") as f:
                f.write(to_spec(text, feat, next_row, arch, rel))
            if os.path.isfile(queue_path):
                with open(queue_path, "a", encoding="utf-8") as f:
                    if not re.search(r"^\|\s*Id\s*\|.*\bDepends\b", read(queue_path), re.M):   # on issues the file has no table
                        f.write("\n| Id | Item | Depends | Source | Batch | Admitted |\n|---|---|---|---|---|---|\n")
                    f.write(f"| {next_row} | {feat.replace('-', ' ')} (recalibrated from {rel}) | | planned | 1 | |\n")
                touched.append(os.path.relpath(queue_path, root))
            next_row += 1
            moved[rel] = new
            created.append(new)
            home = f"{new} (+ queue row, original under {arch})"
        elif e["action"] == "merge-glossary":
            gloss_terms += [l for l in text.splitlines() if l.startswith("|") and "---" not in l and not re.match(r"^\|\s*Term\s*\|", l)]
            home = f"reef/glossary.md (original under {arch})"
        index.append(f"| `{rel}` | `{home}` | {e['reason']} |")
    if gloss_terms:
        gp = os.path.join(root, paths.get("glossary", "reef/glossary.md"))
        os.makedirs(os.path.dirname(gp), exist_ok=True)
        if not os.path.isfile(gp):
            with open(gp, "w", encoding="utf-8") as f:
                f.write("# Glossary\n\n| Term | Definition |\n|---|---|\n")
        with open(gp, "a", encoding="utf-8") as f:
            f.write("\n".join(gloss_terms) + "\n")
        touched.append(os.path.relpath(gp, root))
    for c in plan.get("create", []):
        if c.endswith("/"):
            os.makedirs(os.path.join(root, c), exist_ok=True)
    with open(os.path.join(root, "reef", "archive", "README.md"), "w", encoding="utf-8") as f:
        f.write("\n".join(index) + "\n")
    created.append("reef/archive/README.md")
    broken, already_dead = rewrite_links(root, moved, touched + created, dead_before)
    if broken:
        git(root, "reset", "-q", "--hard", "HEAD", check=False)
        git(root, "clean", "-fdq", "--", "reef", check=False)
        print("REFUSED: the apply would leave broken relative links — tree restored:")
        for b in broken[:20]:
            print(f"  - {b}")
        return 1
    if already_dead:
        print(f"note: {len(already_dead)} relative link(s) were already broken before the apply and travelled as they were (not this apply's to fix):")
        for b in already_dead[:10]:
            print(f"  - {b}")
    if commit:
        git(root, "add", "-A")   # the tree was clean before: everything staged is this apply (the moves are already staged)
        git(root, "-c", "user.email=reef@local", "-c", "user.name=reef", "commit", "-q", "-m",
            f"chore: reef recalibration {date} — {len(entries)} document(s) converted or archived (undo: git revert)")
    if commit and on_issues and any(e["action"] == "convert-feature" for e in entries):
        # the move stays one revertable commit; its rows then become issues and leave the file in a commit of their own
        r = subprocess.run([sys.executable, os.path.join(os.path.dirname(os.path.abspath(__file__)), "reef-queue.py"), "import-rows",
                            "--apply", "--repo", root], capture_output=True, text=True)
        print(r.stdout.strip() or r.stderr.strip())
        if r.returncode == 0:
            git(root, "add", "--", os.path.relpath(queue_path, root))
            git(root, "-c", "user.email=reef@local", "-c", "user.name=reef", "commit", "-q", "-m",
                "queue: recalibrated rows moved to issues", check=False)
        else:
            print("the rows stay in the queue file: python3 scripts/reef-queue.py import-rows --apply moves them")
    print(f"applied: {len(entries)} document(s) — {sum(1 for e in entries if e['action'] == 'convert-adr')} ADR(s), "
          f"{sum(1 for e in entries if e['action'] == 'convert-feature')} feature folder(s), index at reef/archive/README.md" + (" (committed)" if commit else ""))
    return 0


def main(argv):
    repo = "."
    if "--repo" in argv:
        i = argv.index("--repo")
        repo = argv[i + 1]
        argv = argv[:i] + argv[i + 2:]
    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=repo, capture_output=True, text=True).stdout.strip()
    if not root:
        die("not a git repository", 2)
    if argv[:1] == ["plan"]:
        return cmd_plan(root)
    if argv[:1] == ["history"]:
        print(json.dumps(cmd_history(root), indent=1))
        return 0
    if argv[:1] == ["measure"]:
        return cmd_measure(root, "--json" in argv)
    if argv[:1] == ["--apply"]:
        lst = argv[argv.index("--list") + 1] if "--list" in argv else None
        return cmd_apply(root, lst, "--no-commit" not in argv)
    die("usage: reef-recalibrate plan | history | measure [--json] | --apply [--list plan.json] [--no-commit]  [--repo DIR]")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
