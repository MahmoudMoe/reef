#!/usr/bin/env python3
# CLASS: code
"""Reef recalibrate — an existing project's documents into Reef's structure: planned, then applied under one approval.
  reef-recalibrate plan    [--measure] [--move] [--repo DIR]   reef/recalibration.md + .reef/recalibration.json (create/convert/
                                             move/keep + reason); 0.7.3: the project's documents stay IN PLACE (the old queue's
                                             open rows, a second handoff and the old loop's commands still convert); --move
                                             proposes moving decisions, specs and stray documents into Reef's tree;
                                             --measure (0.7.2) applies the plan in a scratch worktree, runs gates.full and every
                                             check-family command there, prints the error and red-test counts, removes the worktree
  reef-recalibrate history [--repo DIR]      how it was pushed: branches, commit convention, merge style, tags, CI → derived branches.*
  reef-recalibrate measure [--json] [--repo DIR]   (0.7.2) counts, not judgments, into reef/day-zero.md ## Measured: largest product
                                             files, …; on node also a dependency-cruiser config + known-violations baseline under
                                             <git dir>/reef/recalibration/proposed/ (layer boundaries, item 13), proposed in reef/recalibration.md
                                             files, product vs test LOC, raw SQL by directory, functions/triggers per migration,
                                             linter, existing guard tests; reef/size-baseline.json; files over assess.large_file
                                             as candidate refactor rows in reef/recalibration.md
  reef-recalibrate --apply [--repo DIR] [--list plan.json] [--no-commit]   ONE commit; undo = git revert
decision → ADR with Supersedes: (Nygard + one-line statement); spec for open work → feature folder + queue row;
glossary → merged; else → reef/archive/<date>/<path> with README index. README/LICENSE/CONTRIBUTING/SECURITY/
CHANGELOG/CODEOWNERS, docs a docs build serves and files referenced from code/CI are kept unless the owner's list
says move. Relative links rewritten; a broken link refuses and restores the tree. Exit 0 · 1 refused/nothing · 2 usage.
"""
import datetime
import json
import os
import re
import subprocess
import sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))   # the shared helpers live beside this script
sys.dont_write_bytecode = True   # and no scripts/__pycache__ lands in a project's tree (reef-update, a row worktree read it as changes)
from reef_common import git as _git, read_replace as read, table_cells  # noqa: E402

KEEP = {"README.md", "LICENSE", "LICENSE.md", "CONTRIBUTING.md", "SECURITY.md", "CHANGELOG.md", "CODEOWNERS", "CODE_OF_CONDUCT.md", "AGENTS.md", "CLAUDE.md", "HANDOFF.md"}
# 0.7.2 (first adoption, 2026-10-24, item 16): a licence anywhere, under any name (a font's OFL.md, LICENSE-fonts.md, NOTICE.md), is kept;
# so is every document in a directory that holds an asset (font, image, binary) beside its licence


def reef_dir(root):
    """0.7.3 (first adoption, 2026-10-25): Reef's proposals live under the git dir — every tool, test and linter skips .git; under
    .reef/proposed/ a project test that walks the disk counted .dependency-cruiser.cjs and a .claude/ folder as its own.
    The common dir, so a linked worktree sees the same proposals. Outside a git repository: .reef/ as before."""
    r = subprocess.run(["git", "-C", root, "rev-parse", "--git-common-dir"], capture_output=True, text=True)
    g = r.stdout.strip()
    if r.returncode != 0 or not g:
        return os.path.join(root, ".reef")
    return os.path.join(g if os.path.isabs(g) else os.path.join(root, g), "reef")


def proposed_dir(root):
    """The plan's own proposals, apart from reef-init's <reef_dir>/proposed/ (0.7.3: the plan's AGENTS.md rewrite had overwritten
    init's proposal for the same file, which the doctor then offered to `--accept` as Reef's rendering)."""
    return os.path.join(reef_dir(root), "recalibration", "proposed")
LICENCE_RE = re.compile(r"(?i)^(licen[cs]e|copying|notice|ofl)([-_.].*)?(\.md|\.txt)?$")
ASSET_EXT = (".ttf", ".otf", ".woff", ".woff2", ".eot", ".png", ".jpg", ".jpeg", ".gif", ".svg", ".webp", ".ico", ".pdf", ".mp3", ".mp4", ".wasm", ".bin")
DECISION_DIR = re.compile(r"(^|/)(adr|adrs|decisions?|rfcs?)(/|$)", re.I)
SPEC_DIR = re.compile(r"(^|/)(specs?|requirements|features?)(/|$)|spec\.md$|-spec\.md$|_spec\.md$", re.I)
RUNBOOK = re.compile(r"runbook|operations|how[-_ ]?to|guide|playbook|onboarding", re.I)
LINK = re.compile(r"(!?\[[^\]]*\]\()([^)\s#]+)(#[^)]*)?(\))")


def die(msg, code=2):
    print(f"reef-recalibrate: {msg}", file=sys.stderr)
    sys.exit(code)


def git(root, *a, check=True):
    r = _git(root, *a)
    if check and r.returncode != 0:
        die(f"git {' '.join(a[:2])} failed: {r.stderr.strip()[:200]}", 1)
    return r.stdout


def served_dirs(root):
    out = set()
    if os.path.isfile(os.path.join(root, "mkdocs.yml")):
        m = re.search(r"^docs_dir:\s*(\S+)", read(os.path.join(root, "mkdocs.yml")), re.M)
        out.add((m.group(1) if m else "docs").strip("/"))
    for cand in ("docusaurus.config.js", "docusaurus.config.ts", "docusaurus.config.mjs", "docs/package.json"):
        if os.path.isfile(os.path.join(root, cand)):
            out.add("docs")
    for dp, dn, fn in os.walk(root):
        dn[:] = [d for d in dn if d not in (".git", "node_modules", ".reef", ".venv")]
        if "conf.py" in fn and any(x.endswith((".rst", ".md")) for x in fn):
            out.add(os.path.relpath(dp, root).strip("./"))
    return {d for d in out if d}


def referenced_by(root, rel):
    # "referenced from code, CI or the docs build": never from Reef's own plan (.reef/recalibration.json lists every
    # document, which made every document "kept" on a second run — 0.7 dogfood) nor from logs and evidence dumps
    r = subprocess.run(["git", "-C", root, "grep", "-l", "-F", "--", rel, "--", ":!*.md", ":!.reef/**", ":!*.log", ":!*.txt"],
                       capture_output=True, text=True)
    refs = [l for l in r.stdout.splitlines() if l and not REEF_CODE.match(l)]
    # item 19: the files agents read first are readers too (they were excluded with every other *.md)
    r = subprocess.run(["git", "-C", root, "grep", "-l", "-F", "--", rel, "--", *INSTRUCTION_GLOBS], capture_output=True, text=True)
    return refs + [l for l in r.stdout.splitlines() if l and l not in refs and l != rel]


_DIR_READERS = {}


def directory_readers(root, rel):
    """0.7.2 (first adoption, 2026-10-24, item 16a): a tool that reads a whole DIRECTORY or a glob (`check:docs` over `docs/**`, a
    loader over `specs/*/spec.md`) never names the file, so the file read "not referenced" and moved — 735 documents on
    first adoption, 603 `check:docs` errors. Every ancestor directory (`docs/loop/`, `docs/loop`, `specs/`) is grepped in code,
    CI and package.json (the same excludes); a hit keeps every document under it."""
    readers = []
    parts = rel.split("/")[:-1]
    for i in range(len(parts), 0, -1):
        d = "/".join(parts[:i])
        if d not in _DIR_READERS:
            # the DIRECTORY, not a file in it: `docs/loop/` or `docs/loop/**` or a bare `docs/loop`, never `docs/loop/queue.md`
            esc = re.sub(r"([.+?()\[\]{}|^$])", r"\", d)
            needles = [rf"{esc}/(\*|[^A-Za-z0-9_./*-]|$)"] + ([rf"(^|[^A-Za-z0-9_./-]){esc}([^A-Za-z0-9_./-]|$)"] if "/" in d else [])
            hits = []
            for n in needles:
                r = subprocess.run(["git", "-C", root, "grep", "-l", "-E", "--", n, "--", ":!*.md", ":!.reef/**", ":!*.log", ":!*.txt", ":!*.lock", ":!package-lock.json"],
                                   capture_output=True, text=True)
                hits += [l for l in r.stdout.splitlines() if l and l not in hits and not REEF_CODE.match(l)]
                r = subprocess.run(["git", "-C", root, "grep", "-l", "-E", "--", n, "--", *INSTRUCTION_GLOBS], capture_output=True, text=True)
                hits += [l for l in r.stdout.splitlines() if l and l not in hits]
            _DIR_READERS[d] = (d, hits)
        d, hits = _DIR_READERS[d]
        if hits:
            readers.append((d, hits))
    return readers


def unmerged_edits(root, base):
    """Item 16c: a document changed on a local branch not merged into `branches.base` is kept — moving it guarantees a conflict."""
    out = {}
    if subprocess.run(["git", "-C", root, "rev-parse", "-q", "--verify", f"refs/heads/{base}"], capture_output=True).returncode != 0:
        return out
    for b in [l.strip() for l in git(root, "branch", "--format=%(refname:short)", check=False).splitlines() if l.strip()]:
        if b == base or subprocess.run(["git", "-C", root, "merge-base", "--is-ancestor", b, base], capture_output=True).returncode == 0:
            continue
        for rel in git(root, "diff", "--name-only", f"{base}...{b}", check=False).splitlines():
            if rel.endswith(".md"):
                out.setdefault(rel, b)
    return out


def beside_asset_licence(root, rel):
    d = os.path.dirname(os.path.join(root, rel))
    try:
        names = os.listdir(d)
    except OSError:
        return False
    return any(LICENCE_RE.match(n) for n in names) and any(n.lower().endswith(ASSET_EXT) for n in names)


# ---------------------------------------------------------------- the instruction layer (0.7.2, first adoption 2026-10-24, item 19)
# CLAUDE.md, AGENTS.md and CLAUDE-CODE-PROMPT.md told every session to read HANDOFF-FRESH.md and docs/loop/queue.md first, start
# with /loop-start, close with `npm run loop:close`, number ADRs with loop:adr, route models by their own table, run up to 15
# agents. After adoption a fresh session obeyed those files, not Reef: two harnesses. The files agents read first are readers
# too, their process rules are listed with file:line, and their rewrite is part of the approved recalibration.
INSTRUCTION_GLOBS = ("CLAUDE*.md", "AGENTS.md", "GEMINI.md", ".cursorrules", ".github/copilot-instructions.md", ".claude/commands/**", ".claude/agents/**")
INSTRUCTION_FILE = re.compile(r"^(CLAUDE[^/]*\.md|AGENTS\.md|GEMINI\.md|\.cursorrules|\.github/copilot-instructions\.md|\.claude/(commands|agents)/.+)$")
# 0.7.3 (first adoption, 2026-10-25): Reef's own code (the shape the guard locks and reef-update stages) names `specs/`, `docs/` and
# HANDOFF-FRESH.md in comments and code: never the project's reader — it kept specs/, retired the old queue behind four reef-*
# scripts, and the apply repointed scripts/reef-recalibrate, then refused on a "broken link" inside it
REEF_CODE = re.compile(r"^(scripts/reef[-_][^/]+|\.githooks/[^/]+)$")   # reef_common.py is Reef's too (consolidation step 1)
# 0.7.3 (the owner's rule: Reef works on any stack): a rule is found by its SHAPE — a slash command or a task-runner command
# whose name means start, close or ADR, a sentence about numbering ADRs, a queue or backlog file outside Reef — never by one
# project's command names
RUNNER = r"(?:npm run|pnpm(?: run)?|yarn(?: run)?|bun run|make|just|task|poe|pdm run|hatch run|tox -e|invoke|rake|composer)"


def _command_named(words):
    return (rf"(?<![\w/])/[a-z][\w:-]*(?:{words})[\w:-]*|\b{RUNNER}\s+[\w:.-]*(?:{words})[\w:.-]*|"
            rf"(?<![\w/.-])[a-z][\w-]*:(?:{words})\b")


RULE_KINDS = (("start command", re.compile(r"(?i)" + _command_named("start|begin|session|open"))),
              ("close command", re.compile(r"(?i)" + _command_named("close|finish|wrap|end-session|session-end"))),
              ("ADR numbering", re.compile(r"(?i)number(ing)?\s+(the\s+)?ADRs?|ADR\s+numbers?\s+(come|are|from)|" + _command_named("adr"))),
              ("round or agent cap", re.compile(r"(?i)\b(up to|at most|max(imum)?( of)?)\s+\d+\s+(agents?|rounds?|retries|attempts|parallel)")),
              ("model routing", re.compile(r"(?i)\b(opus|sonnet|haiku|gpt-?\d|o\d-mini|gemini-\d|route\w* (the )?models?|model routing)\b")),
              ("handoff file", re.compile(r"HANDOFF[-_][\w-]*\.md|handoff[-_][\w-]*\.md")),
              ("queue or constitution outside Reef", re.compile(r"(?i)(?<![\w/.-])(?!reef/)(?:[\w.-]+/)*[\w.-]*(queue|backlog)[\w.-]*\.md|"
                                                               r"\.specify/(memory/)?constitution\.md")))
OUTRANKS = re.compile(r"(?i)\b(deliberately|on purpose|by design|intentionally)\b.*\b(no|not|never|without)\b|\b(no|never adopt a?)\s+(linter|formatter|orm|framework)\b")
PATH_IN_TEXT = re.compile(r"(?<![\w/])((?:[\w.-]+/)*[\w.-]+\.md)\b")


def instruction_files(root):
    out = []
    for rel in git(root, "ls-files", "-co", "--exclude-standard", check=False).splitlines():
        if INSTRUCTION_FILE.match(rel) and rel != "HANDOFF.md":
            out.append(rel)
    return sorted(out)


def instruction_layer(root, documents, moving=frozenset()):
    """Per instruction file: every pointer to a process document (a path that exists and is not README/LICENSE-like), every process
    rule that conflicts with Reef's, each with file:line — Observed; duplicates (two CLAUDE files) and rules that outrank Reef's
    defaults flagged."""
    docs = set(documents)
    layer = []
    for rel in instruction_files(root):
        text = read(os.path.join(root, rel))
        pointers, rules, outranks = [], [], []
        in_foreign = False
        for n, line in enumerate(text.splitlines(), 1):
            if re.match(r"\s*<!-- BEGIN:[\w.-]+ -->", line):
                in_foreign = True
            if in_foreign:
                if re.match(r"\s*<!-- END:[\w.-]+ -->", line):
                    in_foreign = False
                continue   # another tool's block is not the project's process
            for m in PATH_IN_TEXT.finditer(line):
                p = m.group(1).lstrip("./")
                if p in docs and p != rel and os.path.basename(p) not in KEEP and not LICENCE_RE.match(os.path.basename(p)):
                    pointers.append((n, p, p in moving))   # a pointer to a document the plan moves is a process pointer to retire
            for kind, rx in RULE_KINDS:
                if rx.search(line):
                    rules.append((n, kind, line.strip()[:160]))
                    break
            if OUTRANKS.search(line):
                outranks.append((n, line.strip()[:160]))
        layer.append({"file": rel, "pointers": pointers, "rules": rules, "outranks": outranks})
    claude = [e["file"] for e in layer if re.match(r"^CLAUDE[^/]*\.md$", e["file"])]
    primary = "CLAUDE.md" if "CLAUDE.md" in claude else (claude[0] if claude else None)   # the canonical name wins
    return {"files": layer, "duplicates": [c for c in claude if c != primary], "primary": primary}


POINTER_PARA = ("Process: this project runs on Reef. Read `HANDOFF.md` first, then `AGENTS.md`; the queue is read through "
                "`python3 scripts/reef-queue.py ready`, work runs through `/reef-plan` → `/reef-task` → `/reef-review`, ADRs are numbered "
                "on the base at merge (`reef-queue.py adr-number`), models and caps come from `.reef/config.json`. "
                "(The earlier process rules of this section were retired by the Reef recalibration; see `reef/instruction-layer.md`.)\n")


def rewrite_instruction(text, entry):
    """The file with its process sections replaced by one pointer: product content kept verbatim, foreign blocks byte-identical,
    a section is "process" when a listed pointer or rule sits in it."""
    hits = {n for n, _, moves in entry["pointers"] if moves} | {n for n, _, _ in entry["rules"]}   # a pointer to a kept document stays
    if not hits:
        return text
    lines = text.splitlines(keepends=True)
    out, i, n_lines = [], 0, len(lines)
    # sections start at a heading (or at line 1); a foreign block is copied whole wherever it starts
    bounds = [i for i, l in enumerate(lines) if re.match(r"#{1,6}\s", l)]
    starts = sorted(set([0] + bounds))
    for si, s in enumerate(starts):
        e = starts[si + 1] if si + 1 < len(starts) else n_lines
        sec = lines[s:e]
        sec_nums = set(range(s + 1, e + 1))
        if not (sec_nums & hits):
            out += sec
            continue
        head = [sec[0]] if re.match(r"#{1,6}\s", sec[0]) else []
        body = sec[len(head):]
        kept = []   # foreign blocks inside a process section survive byte for byte
        j = 0
        while j < len(body):
            if re.match(r"\s*<!-- BEGIN:[\w.-]+ -->", body[j]):
                k = j
                while k < len(body) and not re.match(r"\s*<!-- END:[\w.-]+ -->", body[k]):
                    k += 1
                kept += body[j:k + 1]
                j = k + 1
            else:
                j += 1
        out += head + [POINTER_PARA, "\n"] + kept
    return "".join(out)


# ---------------------------------------------------------------- the whole adoption (0.7.2, first adoption 2026-10-24, item 18)
# Assess archived 32 stray documents and handed off; specs/, docs/adr/, a 909-row old queue and a second handoff stayed because the
# project's own tools read them, and nothing said the replacement was deferred or in what order it had to happen. The plan now
# covers the whole adoption as one ordered list, checks that the old loop has nothing in flight, migrates in ONE commit, and ends
# with a hand-off line that says "complete" or "partial: N documents outside it — rows, blocked by …".
QUEUE_FILE = re.compile(r"(^|/)(queue|backlog)[\w-]*\.md$", re.I)
OLD_HANDOFF = re.compile(r"^HANDOFF[-_][\w-]+\.md$")
DONE_STATES = {"done", "closed", "merged", "shipped", "archived", "cancelled", "canceled", "dropped", "released", "complete", "completed"}
HOLD_RE = re.compile(r"(?i)\b(nothing|no\s+\w+|do not|don't|never)\s+(merges?|push\w*|deploy\w*|releases?|promot\w*)\b.*\b(until|before|while)\b|\b(hold|freeze|frozen|moratorium)\b")
BRANCH_IN_TEXT = re.compile(r"[\w./-]*[\w-]")


def parse_old_queue(text):
    """Any markdown table with an id-like and a status-like column: the rows, their id, title and whether they are open."""
    rows, header = [], None
    for line in text.splitlines():
        if not line.strip().startswith("|"):
            header = None
            continue
        cells = table_cells(line)
        if header is None:
            low = [c.lower() for c in cells]
            if any(c in ("id", "#", "row", "no", "n") for c in low) and any(re.search(r"status|state", c) for c in low):
                header = low
            continue
        if re.fullmatch(r"[-:| ]+", line.strip()):
            continue
        if len(cells) < len(header):
            cells += [""] * (len(header) - len(cells))
        row = dict(zip(header, cells))
        rid = next((row[c] for c in header if c in ("id", "#", "row", "no", "n")), "")
        title = next((row[c] for c in header if re.search(r"item|title|task|description|summary|work", c)), "") or next((v for k, v in row.items() if k not in ("id", "#") and v), "")
        status = next((row[c] for c in header if re.search(r"status|state", c)), "")
        rows.append({"id": rid, "title": title, "status": status, "open": status.strip().lower().split(" ")[0] not in DONE_STATES})
    return rows


def adoption_inventory(root, cfg, files, base_branch):
    paths = cfg.get("paths") or {}
    reef_queue = str(paths.get("queue", "reef/queue.md"))
    old_queues, old_handoffs, holds = {}, [], []
    for rel in files:
        if rel != reef_queue and not rel.startswith(("reef/", ".reef/")) and QUEUE_FILE.search(rel):
            rows = parse_old_queue(read(os.path.join(root, rel)))
            if rows:
                old_queues[rel] = rows
        if OLD_HANDOFF.match(rel) or re.search(r"(^|/)HANDOFF[-_][\w-]+\.md$", rel):
            old_handoffs.append(rel)
    for rel in old_handoffs + [r for r in files if RUNBOOK.search(r)]:
        for n, line in enumerate(read(os.path.join(root, rel)).splitlines(), 1):
            if HOLD_RE.search(line):
                holds.append({"file": rel, "line": n, "text": line.strip()[:160]})
    # the precondition: an unmerged local branch the old queue (or the old handoff) names is work in flight under the old loop
    in_flight = []
    # first adoption, 2026-10-25: `main` (the release branch, legitimately unmerged into develop) was "in flight" because the word appeared in
    # docs/loop/queue-archive.md. Only an OPEN row of an old queue, or the old handoff, can claim a branch; base and release never count.
    release_branch = str((cfg.get("branches") or {}).get("release", "main") or "main")
    if subprocess.run(["git", "-C", root, "rev-parse", "-q", "--verify", f"refs/heads/{base_branch}"], capture_output=True).returncode == 0:
        claims = {rel: "\n".join(r["title"] + " " + r["status"] for r in rows if r["open"]) for rel, rows in old_queues.items()}
        claims.update({rel: read(os.path.join(root, rel)) for rel in old_handoffs})
        for b in [l.strip() for l in git(root, "branch", "--format=%(refname:short)", check=False).splitlines() if l.strip()]:
            if b in (base_branch, release_branch) or subprocess.run(["git", "-C", root, "merge-base", "--is-ancestor", b, base_branch], capture_output=True).returncode == 0:
                continue
            for rel, text in claims.items():
                if re.search(r"(?<![\w/-])" + re.escape(b) + r"(?![\w/-])", text):
                    in_flight.append({"branch": b, "claimed_by": rel})
                    break
    # the old loop's commands and agents: those that name the old process are Reef's skills' business now
    old_cmds = []
    for rel in files:
        if rel.startswith((".claude/commands/", ".claude/agents/")):
            text = read(os.path.join(root, rel))
            if any(rx.search(text) for _, rx in RULE_KINDS) or any(q in text for q in old_queues) or any(h in text for h in old_handoffs):
                old_cmds.append(rel)
    scripts = {name: body for name, _, body in project_commands(root) if OLD_LOOP_COMMAND.match(name)}
    return {"old_queues": {k: {"rows": len(v), "open": sum(1 for r in v if r["open"])} for k, v in old_queues.items()}, "old_handoffs": old_handoffs,
            "holds": holds, "in_flight": in_flight, "old_commands": old_cmds, "old_scripts": scripts, "_rows": old_queues}


# 0.7.3 (the owner's rule: Reef works on any stack): the project's own named commands, from whichever task runner it uses —
# package.json scripts, Makefile targets, justfile recipes, Taskfile tasks, tox environments, pyproject poe/pdm/hatch scripts
CHECK_FAMILY = re.compile(r"^check([:._-].*)?$")
OLD_LOOP_COMMAND = re.compile(r"^(loop|handoff|adr)([:._-].*)?$")


def project_commands(root):
    """[(name, how to run it, its body or source file)] — the body when the runner states one (package.json), else the file."""
    out = []
    pkg = os.path.join(root, "package.json")
    if os.path.isfile(pkg):
        try:
            out += [(k, f"npm run {k}", str(v)) for k, v in (json.loads(read(pkg)).get("scripts") or {}).items()]
        except (ValueError, AttributeError):
            pass
    for name in ("Makefile", "makefile", "GNUmakefile"):
        if os.path.isfile(os.path.join(root, name)):
            out += [(t, f"make {t}", name) for t in re.findall(r"^([A-Za-z0-9][\w.:-]*)\s*:(?![=:])", read(os.path.join(root, name)), re.M)]
    for name in ("justfile", "Justfile", ".justfile"):
        if os.path.isfile(os.path.join(root, name)):
            out += [(t, f"just {t}", name) for t in re.findall(r"^@?([A-Za-z0-9][\w-]*)[^:=\n]*:(?!=)", read(os.path.join(root, name)), re.M)]
    for name in ("Taskfile.yml", "Taskfile.yaml", "taskfile.yml"):
        if os.path.isfile(os.path.join(root, name)):
            body = re.split(r"^tasks:\s*$", read(os.path.join(root, name)), maxsplit=1, flags=re.M)
            out += [(t, f"task {t}", name) for t in (re.findall(r"^  ([\w:.-]+):\s*$", body[1], re.M) if len(body) > 1 else [])]
    if os.path.isfile(os.path.join(root, "tox.ini")):
        out += [(t, f"tox -e {t}", "tox.ini") for t in re.findall(r"^\[testenv:([\w.-]+)\]", read(os.path.join(root, "tox.ini")), re.M)]
    if os.path.isfile(os.path.join(root, "pyproject.toml")):
        section = ""
        for line in read(os.path.join(root, "pyproject.toml")).splitlines():
            m = re.match(r"^\[([^\]]+)\]\s*$", line)
            if m:
                section = m.group(1)
                continue
            k = re.match(r"^([A-Za-z0-9][\w-]*)\s*=", line)
            if not k:
                continue
            if section == "tool.poe.tasks":
                out.append((k.group(1), f"poe {k.group(1)}", "pyproject.toml"))
            elif section == "tool.pdm.scripts":
                out.append((k.group(1), f"pdm run {k.group(1)}", "pyproject.toml"))
            elif re.match(r"^tool\.hatch\.envs\.([\w-]+)\.scripts$", section):
                env = section.split(".")[3]
                out.append((k.group(1), f"hatch run {'' if env == 'default' else env + ':'}{k.group(1)}", "pyproject.toml"))
    return out


def adoption_readers(root, moving, new_home):
    """Every reader of a document the adoption moves: a reader naming the exact path is REPOINTED at apply (the string becomes the
    new home); a reader of its directory cannot be repointed mechanically and is RETIRED — a queue row with the blocker, and the
    documents under that directory stay until then (the hand-off says "partial")."""
    readers, blocked = [], {}
    for rel in sorted(moving):
        for f in referenced_by(root, rel):
            if not INSTRUCTION_FILE.match(f):   # the instruction layer is rewritten by item 19, not repointed
                readers.append({"reader": f, "target": rel, "action": "repoint", "new": new_home.get(rel, "")})
        for d, hits in directory_readers(root, rel):
            for f in hits:
                if not INSTRUCTION_FILE.match(f):
                    readers.append({"reader": f, "target": rel, "action": "retire", "directory": d})
                    blocked[rel] = f"{f} reads {d}/"
    return readers, blocked


def render_adoption(a, readers, blocked):
    lines = ["## Adoption — the whole move, in order", "",
             "1. old queue(s): open rows → Reef's queue (`reef-queue.py add-row`, source planned), the file archived with its closed rows; "
             "2. old handoff(s) merged into `HANDOFF.md` under `## Carried over from …`, then archived; 3. every reader of a moved document "
             "repointed (an exact path) or retired (a directory read: a queue row, the documents wait); 4. open specs → feature folders, closed → "
             "archive; 5. decisions → Reef's ADR home (numbered ones keep their number); 6. the old loop's commands and agents archived "
             "(Reef's skills replace them), its package scripts listed for the owner; 7. the instruction layer rewritten (item 19); "
             "8. `reef-structure --check` joins `gates.extra`. All of it in ONE commit (`git revert` undoes it).", ""]
    if a["in_flight"]:
        lines += ["**REFUSED until the old loop has nothing in flight** — unmerged branches its documents claim: " +
                  ", ".join(f"`{x['branch']}` (claimed by `{x['claimed_by']}`)" for x in a["in_flight"]) +
                  ". Finish them first, or `--apply --park-in-flight` re-admits each as a Reef row and migrates. Never migrate under a running loop.", ""]
    lines += [f"- old queue `{q}`: {v['rows']} row(s), {v['open']} open → Reef rows; the file archived" for q, v in a["old_queues"].items()] or ["- no old queue found"]
    lines += [f"- old handoff `{h}` → merged into HANDOFF.md, archived" for h in a["old_handoffs"]] or ["- no second handoff"]
    lines += [f"- hold in `{h['file']}:{h['line']}` — `{h['text']}` (outranks Reef's merge default: named in the hand-off)" for h in a["holds"]]
    lines += [f"- old loop command/agent `{c}` → archived (Reef's skills replace it)" for c in a["old_commands"]]
    lines += [f"- old loop command `{k}`: `{v}` — the owner retires it (not touched)" for k, v in a["old_scripts"].items()]
    for r in readers:
        lines.append(f"- reader `{r['reader']}` of `{r['target']}`: " + (f"repointed to `{r['new']}`" if r["action"] == "repoint" else f"RETIRE — it reads `{r['directory']}/`; a queue row, the documents under it wait"))
    if not readers:
        lines.append("- no reader of a moved document outside the instruction layer")
    return "\n".join(lines) + "\n"


def render_layer(layer, rewrites):
    lines = ["# The instruction layer — what the agents read first", "",
             "Written by `reef-recalibrate plan` (Observed: file:line). Every pointer to a process document and every process rule that "
             "conflicts with Reef's; the rewrite of each file is part of the approved recalibration (its diff under `.git/reef/recalibration/proposed/`), "
             "product content kept verbatim, another tool's block byte-identical, duplicates merged into one file.", ""]
    if not layer["files"]:
        return "\n".join(lines + ["No instruction file found (CLAUDE*.md, AGENTS.md, GEMINI.md, .cursorrules, copilot-instructions, .claude/commands, .claude/agents).", ""])
    for e in layer["files"]:
        lines += [f"## `{e['file']}`" + (" — DUPLICATE of the primary CLAUDE file (merged into it, then archived)" if e["file"] in layer["duplicates"] else ""), ""]
        lines += [f"- pointer → `{p}` ({e['file']}:{n})" + (" — the document moves: retired by the rewrite" if moves else " — kept, the pointer stays") for n, p, moves in e["pointers"]] or ["- no pointer to a process document"]
        lines += [f"- rule, {kind}: `{txt}` ({e['file']}:{n})" for n, kind, txt in e["rules"]] or ["- no process rule that conflicts with Reef's"]
        lines += [f"- **outranks a Reef default** (surfaced, never overridden): `{txt}` ({e['file']}:{n})" for n, txt in e["outranks"]]
        rw = next((r for r in rewrites if r["file"] == e["file"]), None)
        lines += [f"- rewrite proposed: `{rw['proposed']}` ({rw['sections']} section(s) → one pointer, {rw['foreign']} foreign block(s) kept byte-identical)" if rw else "- nothing to rewrite", ""]
    return "\n".join(lines) + "\n"


def propose_rewrites(root, layer):
    """Each instruction file with a pointer or a rule gets its rewritten text under <git dir>/reef/recalibration/proposed/<file>; the plan carries the list.
    Nothing in the tree changes until --apply, under the approved plan."""
    out = []
    for e in layer["files"]:
        if not (e["pointers"] or e["rules"]):
            continue
        text = read(os.path.join(root, e["file"]))
        new = rewrite_instruction(text, e)
        if new == text:
            continue
        p = os.path.join(proposed_dir(root), e["file"])
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w", encoding="utf-8") as f:
            f.write(new)
        out.append({"file": e["file"], "proposed": os.path.relpath(p, root), "sections": new.count(POINTER_PARA),
                    "foreign": len(re.findall(r"<!-- BEGIN:[\w.-]+ -->", new))})
    return out


# 0.7.3 (first adoption, 2026-10-25): the folders .reef/config.json `paths.*` names are the layout (reef-structure has said so since
# 0.7.2): a document there stays, and converted ADRs land in `paths.adr` — the apply had moved docs/adr/ to
# reef/architecture/adr/ and would have split the ADRs across two homes once the owner moved docs/adr/ back
HOME_KEYS = ("adr", "queue", "runlog", "glossary", "tasks", "features", "day_zero")


def config_homes(cfg):
    return [str(v).strip().strip("/") for k, v in (cfg.get("paths") or {}).items() if v and k in HOME_KEYS]


def adr_home(cfg):
    return str((cfg.get("paths") or {}).get("adr") or "reef/architecture/adr").strip().strip("/")


def classify(root, rel, text, served, unmerged=None, homes=()):
    base = os.path.basename(rel)
    if base in KEEP:
        return "keep", "project file (README, LICENSE, CONTRIBUTING, SECURITY, CHANGELOG, CODEOWNERS)"
    if LICENCE_RE.match(base):
        return "keep", "a licence (kept wherever it is, under any name)"
    if INSTRUCTION_FILE.match(rel):
        return "keep", "the instruction layer (rewritten in place by the plan; a duplicate CLAUDE file is merged, then archived)"
    if beside_asset_licence(root, rel):
        return "keep", "beside an asset's licence (fonts, images, binaries)"
    if unmerged and rel in unmerged:
        return "keep", f"edited on unmerged branch {unmerged[rel]}"
    if rel.startswith(("reef/", ".reef/", ".github/", ".claude/", "tasks/")):
        return "keep", "already in the layout"
    if any(rel == h or rel.startswith(h + "/") for h in homes):
        return "keep", "already in the layout (a .reef/config.json paths.* home)"
    if any(rel == d or rel.startswith(d + "/") for d in served):
        return "keep", "served by the docs build"
    refs = referenced_by(root, rel)
    if refs:
        return "keep", f"referenced by {refs[0]}" + (f" (+{len(refs) - 1})" if len(refs) > 1 else "")
    for d, hits in directory_readers(root, rel):
        return "keep", f"directory {d}/ read by {hits[0]}" + (f" (+{len(hits) - 1})" if len(hits) > 1 else "")
    if DECISION_DIR.search(rel) or re.search(r"^#+\s*(Decision|Status|Context)\b", text, re.M | re.I) and re.search(r"^#+\s*Consequences", text, re.M | re.I):
        return "convert-adr", "a decision record (ADR/RFC shape)"
    if base.lower() == "glossary.md":
        return "merge-glossary", "a glossary"
    if SPEC_DIR.search(rel):
        if re.search(r"^Status:\s*(done|shipped|implemented|merged)", text, re.M | re.I):
            return "archive", "a spec whose work is done"
        return "convert-feature", "a spec for open work"
    if RUNBOOK.search(rel) or RUNBOOK.search(text[:400]):
        return "archive", "a runbook / process document"
    if re.search(r"\b(TODO|draft|deprecated|obsolete)\b", text[:600], re.I):
        return "archive", "stale"
    return "archive", "a process document outside the layout"


GENERIC = {"misc", "fixes", "feature", "update", "stuff", "changes", "work", "tasks", "new", "todo", "wip", "spec", "md", "the", "a", "an", "of", "for"}


def slugify(name, title=""):
    """2-5 descriptive kebab words: the file or directory name first, the document's title when that is too short."""
    for cand in (name, title, f"{name} {title}"):
        s = re.sub(r"[^a-z0-9]+", "-", cand.lower()).strip("-")
        words = [w for w in s.split("-") if w and w not in GENERIC and not w.isdigit()]
        while words and re.match(r"^\d", words[0]):       # a leading id token (`014a`, `572a`) is not a word (first adoption: 96 of them)
            words.pop(0)
        if len(words) >= 2:
            return "-".join(words[:5])
    words = [w for w in re.sub(r"[^a-z0-9]+", "-", name.lower()).split("-") if w] or ["recalibrated"]
    return "-".join(words[:4] + ["slice"])


def cmd_history(root):
    log = git(root, "log", "--format=%s%x00%P", "-n", "400", check=False).splitlines()
    subjects = [l.split("\0")[0] for l in log if l]
    merges = sum(1 for l in log if len(l.split("\0")[-1].split()) > 1)
    authored = [l.split("\0")[0] for l in log if l and len(l.split("\0")[-1].split()) <= 1]   # merge commits are generated, not written
    conventional = sum(1 for s in authored if re.match(r"^(feat|fix|chore|docs|refactor|test|build|ci|perf|style)(\(.+\))?!?:", s))
    branches = [b.strip().replace("origin/", "") for b in git(root, "branch", "-a", "--format=%(refname:short)", check=False).splitlines()]
    branches = sorted({b for b in branches if b and not b.endswith("HEAD")})
    tags = git(root, "tag", "-l", check=False).split()
    base, release = "main", "main"
    for cand in ("develop", "dev", "integration", "staging"):
        if cand in branches:
            base = cand
            break
    release = "main" if "main" in branches else ("master" if "master" in branches else base)
    if base == release and base not in branches and branches:
        base = release = branches[0]
    ci = []
    wf = os.path.join(root, ".github", "workflows")
    for f in (sorted(os.listdir(wf)) if os.path.isdir(wf) else []):
        t = read(os.path.join(wf, f))
        trig = re.search(r"^on:\s*(.*?)(?=^\S)", t + "\nX", re.M | re.S)
        ci.append({"file": f, "on": " ".join((trig.group(1) if trig else "").split())[:120]})
    out = {"commits_sampled": len(subjects), "conventional_commits_share": round(conventional / len(authored), 2) if authored else None,
           "merge_commits": merges, "merge_style": "merge" if merges > len(subjects) // 10 else "squash-or-rebase",
           "branches": branches, "tags": tags[:20], "semver_tags": all(re.match(r"^v?\d+\.\d+\.\d+", t) for t in tags) if tags else None,
           "derived": {"branches.base": base, "branches.release": release, "merge.by": "loop" if base != release else "human",
                       "ci.feature_gate": "local" if base != release else "ci"}, "ci": ci}
    return out


# 0.7.3 (the owner's rule: Reef works on any project, 2026-10-25): moving an existing project's documents into Reef's tree was
# the riskiest and least valuable part of adoption — every guess about who reads a file was a broken check somewhere
# (docs/adr on the first adoption). Adoption keeps them in place; `plan --move` proposes the move, a document at a time, later.
IN_PLACE_ACTIONS = ("convert-adr", "convert-feature", "archive", "merge-glossary")


def build_plan(root, move=False):
    served = served_dirs(root)
    date = datetime.date.today().isoformat()
    files = [l for l in git(root, "ls-files", "--", "*.md", "**/*.md", check=False).splitlines() if l.endswith(".md")]
    cfg_p = os.path.join(root, ".reef", "config.json")
    base_branch = str(((json.loads(read(cfg_p)) if os.path.isfile(cfg_p) else {}).get("branches") or {}).get("base", "main") or "main")
    unmerged = unmerged_edits(root, base_branch)
    plan, n, taken = [], 0, set()
    cfg_all = json.loads(read(cfg_p)) if os.path.isfile(cfg_p) else {}
    adoption = adoption_inventory(root, cfg_all, files, base_branch)
    for rel in sorted(files):
        text = read(os.path.join(root, rel))
        action, reason = classify(root, rel, text, served, unmerged, config_homes(cfg_all))
        if not move and action in IN_PLACE_ACTIONS:
            action, reason = "keep", f"in place ({action}: {reason}; `reef-recalibrate plan --move` proposes the move)"
        if rel in adoption["old_queues"]:
            action, reason = "convert-queue", f"the old loop's queue: {adoption['old_queues'][rel]['open']} open row(s) → Reef rows, closed rows archived with the file"
        elif rel in adoption["old_handoffs"]:
            action, reason = "merge-handoff", "a second handoff: merged into HANDOFF.md, then archived"
        elif rel in adoption["old_commands"]:
            action, reason = "archive", "an old loop command or agent — Reef's skills replace it"
        entry = {"path": rel, "action": action, "reason": reason}
        title = (re.search(r"^#\s+(.+)$", text, re.M) or [None, ""])[1] if re.search(r"^#\s+(.+)$", text, re.M) else ""
        if action == "convert-adr":
            entry["adr_slug"] = slugify(os.path.splitext(os.path.basename(rel))[0], title)
            m = re.match(r"^(\d{4})-", os.path.basename(rel))
            if m:   # 0.7.2 (first adoption, item 21): an ADR that already carries its number keeps it — it is the same record
                entry["adr_number"] = int(m.group(1))
        if action == "convert-feature":
            stem = os.path.splitext(os.path.basename(rel))[0] if os.path.basename(rel).lower() != "spec.md" else os.path.basename(os.path.dirname(rel))
            feat = base = slugify(stem, title)
            k = 2
            while feat in taken:                           # two specs, one slug: the second must not overwrite the first's SPEC.md
                feat = f"{base}-{k}"
                k += 1
            taken.add(feat)
            entry["feature"] = feat
        if action != "keep":
            entry["archive"] = f"reef/archive/{date}/{rel}"
        plan.append(entry)
    hist = cmd_history(root)
    moving = {e["path"] for e in plan if e["action"] != "keep"}
    new_home = {e["path"]: (str((cfg_all.get("paths") or {}).get("queue", "reef/queue.md")) if e["action"] == "convert-queue" else "HANDOFF.md" if e["action"] == "merge-handoff"
                            else e.get("archive", "")) for e in plan if e["action"] != "keep"}
    readers, blocked = adoption_readers(root, moving, new_home)
    for e in plan:   # a document a retire-reader needs stays until that reader is retired: the hand-off says "partial"
        if e["path"] in blocked and e["action"] not in ("convert-queue", "merge-handoff"):
            e["action"], e["reason"], e["blocked_by"] = "keep", f"waits: {blocked[e['path']]} (a retire row is created)", blocked[e["path"]]
            e.pop("archive", None)
    adoption.pop("_rows", None)
    adoption["readers"] = readers
    layer = instruction_layer(root, files, {e["path"] for e in plan if e["action"] != "keep"})
    rewrites = propose_rewrites(root, layer)
    return {"date": date, "adr_home": adr_home(cfg_all), "entries": plan, "history": hist, "instruction_layer": layer, "rewrites": rewrites, "adoption": adoption, "create": ["reef/constitution.md", "reef/queue.md", "reef/journal.md", "reef/glossary.md",
                                                                     "reef/architecture/", "reef/features/README.md", f"reef/archive/{date}/", "reef/archive/README.md"]}


def render_plan(plan):
    lines = [f"# Recalibration — {plan['date']}", "",
             "The full plan of what `scripts/reef-recalibrate --apply` will create, convert, move and keep — one line each, with its reason. "
             "Nothing moves before the owner approves this list (edit a line's action to change it; `keep` lines move only when you change them). "
             "Undo is `git revert` of the apply commit.", "", "## Create", ""]
    lines += [f"- create `{c}`" for c in plan["create"]]
    lines += ["", "## Documents", "", "| action | path | → | reason |", "|---|---|---|---|"]
    home = plan.get("adr_home", "reef/architecture/adr")
    for e in plan["entries"]:
        dest = {"convert-queue": "open rows → Reef's queue (+ archive)", "merge-handoff": "HANDOFF.md (+ archive)",
                "convert-adr": f"{home}/{os.path.basename(e['path'])} (the same record, its number kept)" if e.get("adr_number")
                else f"{home}/NNNN-{e.get('adr_slug', '')}.md (+ archive)",
                "convert-feature": f"reef/features/{e.get('feature', '')}/SPEC.md (+ queue row, + archive)",
                "merge-glossary": "reef/glossary.md (+ archive)", "archive": e.get("archive", ""), "keep": "—"}[e["action"]]
        lines.append(f"| {e['action']} | `{e['path']}` | {dest} | {e['reason']} |")
    if plan.get("adoption"):
        a = plan["adoption"]
        lines += ["", render_adoption(a, a.get("readers") or [], {}).rstrip("\n")]
    rw = plan.get("rewrites") or []
    lay = plan.get("instruction_layer") or {"files": [], "duplicates": []}
    lines += ["", "## Instruction layer (reef/instruction-layer.md)", "",
              f"{len(lay['files'])} file(s) the agents read first; {len(rw)} rewrite(s) proposed under `.git/reef/recalibration/proposed/` and applied with this plan "
              "(process sections → one pointer to Reef's tree; product content and other tools' blocks kept byte for byte); "
              + (f"duplicates merged into `{lay.get('primary')}`: {', '.join('`' + d + '`' for d in lay['duplicates'])}" if lay["duplicates"] else "no duplicate CLAUDE file"), ""]
    lines += [f"- rewrite `{r['file']}` ← `{r['proposed']}` ({r['sections']} section(s), {r['foreign']} foreign block(s) kept) — read the diff first: "
              f"`git diff --no-index {r['file']} {r['proposed']}`" for r in rw]
    h = plan["history"]
    lines += ["", "## How it was pushed (derived)", "",
              f"- branches: {', '.join(h['branches']) or 'none'} → `branches.base` {h['derived']['branches.base']}, `branches.release` {h['derived']['branches.release']}, `merge.by` {h['derived']['merge.by']}",
              f"- commits sampled {h['commits_sampled']}, conventional-commits share {h['conventional_commits_share']}, merge style {h['merge_style']} ({h['merge_commits']} merge commits)",
              f"- tags: {', '.join(h['tags'][:8]) or 'none'} (semver: {h['semver_tags']})",
              "- CI: " + ("; ".join(f"{c['file']} on {c['on']}" for c in h["ci"]) or "none")]
    return "\n".join(lines) + "\n"


def measure_plan(root, plan_json):
    """Item 16d: the plan applied in a SCRATCH worktree, then `gates.full` and every check-family command of the project's
    own task runners (`check`, `check:*`, `check-*`; package.json, Makefile, justfile, Taskfile, tox, pyproject) run there;
    the error and red-test counts are printed, the worktree removed, the tree untouched. The owner approves a plan whose cost
    was measured (first adoption: 603 `check:docs` errors and 4 red tests were found only after the apply)."""
    import tempfile
    cfg_p = os.path.join(root, ".reef", "config.json")
    cfg = json.loads(read(cfg_p)) if os.path.isfile(cfg_p) else {}
    cmds = []
    full = str((cfg.get("gates") or {}).get("full", "") or "")
    if full:
        cmds.append(("gates.full", full))
    cmds += sorted((run, run) for name, run, _ in project_commands(root) if CHECK_FAMILY.match(name))
    wt = tempfile.mkdtemp(prefix="reef-plan-measure.")
    os.rmdir(wt)
    git(root, "worktree", "add", "-q", "--detach", wt, "HEAD")
    rows, worst = [], 0
    try:
        if os.path.isfile(cfg_p) and not os.path.isfile(os.path.join(wt, ".reef", "config.json")):
            os.makedirs(os.path.join(wt, ".reef"), exist_ok=True)
            with open(os.path.join(wt, ".reef", "config.json"), "w", encoding="utf-8") as f:
                f.write(read(cfg_p))
        r = subprocess.run([sys.executable, os.path.abspath(__file__), "--apply", "--no-commit", "--list", plan_json, "--repo", wt], capture_output=True, text=True)
        nothing = r.returncode == 1 and r.stdout.startswith("nothing to do")   # adopted in place: the checks still measure the tree
        rows.append(("apply (scratch)", "0 (nothing moves)" if nothing else r.returncode, 0, 0))
        if r.returncode != 0 and not nothing:   # first adoption, 2026-10-25: the gates ran on an unchanged worktree and the table meant nothing
            apply_said = (r.stderr or r.stdout).strip().splitlines()
            rows.append(("(the apply did not run: " + (apply_said[-1][:140] if apply_said else "no output") + " — gates skipped)", "-", "-", "-"))
            cmds = []
            worst = 1
        for name, cmd in cmds:
            r = subprocess.run(["sh", "-c", cmd], cwd=wt, capture_output=True, text=True)
            out = r.stdout + r.stderr
            errors = len(re.findall(r"(?i)\berror\b", out))
            red = sum(int(m) for m in re.findall(r"(?i)\b(\d+) (?:failed|failing)\b", out))
            worst = max(worst, r.returncode)
            rows.append((name, f"{r.returncode} (command not found: not on sh's PATH)" if r.returncode == 127 else r.returncode, errors, red))
    finally:
        git(root, "worktree", "remove", "--force", wt, check=False)
        git(root, "worktree", "prune", check=False)
    lines = ["", "## Measured cost of this plan (applied in a scratch worktree, then every gate run there; the tree here was not touched)", "",
             "| command | exit | error lines | red tests |", "|---|---|---|---|"] + [f"| {n} | {rc} | {e} | {t} |" for n, rc, e, t in rows]
    if not cmds:
        lines.append("| (no gates.full and no check-family command to run) | – | – | – |")
    return "\n".join(lines) + "\n", worst


def cmd_plan(root, measure=False, move=False):
    plan = build_plan(root, move)
    os.makedirs(os.path.join(root, "reef"), exist_ok=True)
    os.makedirs(os.path.join(root, ".reef"), exist_ok=True)
    plan_json = os.path.join(root, ".reef", "recalibration.json")
    with open(plan_json, "w", encoding="utf-8") as f:
        json.dump(plan, f, indent=1)
    with open(os.path.join(root, "reef", "instruction-layer.md"), "w", encoding="utf-8") as f:
        f.write(render_layer(plan["instruction_layer"], plan["rewrites"]))
    text = render_plan(plan)
    if measure:
        block, worst = measure_plan(root, plan_json)
        text += block
        print(block.strip())
        if worst:
            print("measured: this plan leaves a gate red — cut it to the stray documents (keep the folders the project's tools read) and measure again")
    with open(os.path.join(root, "reef", "recalibration.md"), "w", encoding="utf-8") as f:
        f.write(text)
    moving = [e for e in plan["entries"] if e["action"] != "keep"]
    for x in (plan.get("adoption") or {}).get("in_flight") or []:
        print(f"ADOPTION REFUSED: branch {x['branch']} is in flight under the old loop (claimed by {x['claimed_by']}) — finish it first, or --apply --park-in-flight")
    print(f"plan written: reef/recalibration.md — {len(moving)} document(s) to convert or move, {len(plan['entries']) - len(moving)} kept")
    return 0


def dead_links(root):
    """(file, target) of every relative Markdown link that does not resolve in the tree as it stands."""
    out = set()
    files = [l for l in git(root, "ls-files", "--", "*.md", "**/*.md", check=False).splitlines() if l.endswith(".md")]
    for rel in files:
        p = os.path.join(root, rel)
        if not os.path.isfile(p):
            continue
        here = os.path.dirname(rel)
        for m in LINK.finditer(read(p)):
            target = m.group(2)
            if re.match(r"^[a-z]+:", target) or target.startswith("/") or target.startswith("<"):
                continue
            if not os.path.exists(os.path.join(root, os.path.normpath(os.path.join(here, target)))):
                out.add((rel, target))
    return out


def rewrite_links(root, moved, touched_files, dead_before=frozenset()):
    """Relative links in every Markdown file: a link to a moved file points at its new home; then every relative
    link must resolve. Returns (broken, already_dead): links the apply broke, and links dead before it (keyed by the
    file's ORIGINAL path, so a dead link that travelled with its document is recognised and never blocks the apply)."""
    broken, already_dead = [], []
    files = [l for l in git(root, "ls-files", "--", "*.md", "**/*.md", check=False).splitlines() if l.endswith(".md")]
    files = sorted(set(files) | set(touched_files))
    came_from = {new: old for old, new in moved.items()}   # a moved file's links were written from its OLD directory
    for rel in files:
        p = os.path.join(root, rel)
        if not os.path.isfile(p):
            continue
        text = read(p)
        here = os.path.dirname(rel)
        m_arch = re.match(r"^reef/archive/[^/]+/(.+)$", rel)      # an archived original keeps its old path under the date
        src = came_from.get(rel) or (m_arch.group(1) if m_arch else rel)
        origin = os.path.dirname(src)

        def fix(m):
            target = m.group(2)
            if re.match(r"^[a-z]+:", target) or target.startswith("/"):
                return m.group(0)
            abs_target = os.path.normpath(os.path.join(here, target))
            if abs_target in moved:
                new = os.path.relpath(moved[abs_target], here or ".")
                return f"{m.group(1)}{new}{m.group(3) or ''}{m.group(4)}"
            if src != rel and not os.path.exists(os.path.join(root, abs_target)):
                # this file moved; the link was relative to where it came from — a sibling that STAYS (kept:
                # referenced by code) or moved elsewhere. Seen live (0.7 dogfood, first adoption): the apply refused
                # on `design-decisions.md` beside a converted spec, a file the plan itself kept.
                from_origin = os.path.normpath(os.path.join(origin, target))
                dest = moved.get(from_origin, from_origin)
                if os.path.exists(os.path.join(root, dest)):
                    return f"{m.group(1)}{os.path.relpath(dest, here or '.')}{m.group(3) or ''}{m.group(4)}"
            return m.group(0)
        new_text = LINK.sub(fix, text)
        if new_text != text:
            with open(p, "w", encoding="utf-8") as f:
                f.write(new_text)
        for m in LINK.finditer(new_text):
            target = m.group(2)
            if re.match(r"^[a-z]+:", target) or target.startswith("/") or target.startswith("<"):
                continue
            if not os.path.exists(os.path.join(root, os.path.normpath(os.path.join(here, target)))):
                (already_dead if (src, target) in dead_before else broken).append(f"{rel}: {target}")
    return broken, already_dead


def relink(text, old_rel, new_rel):
    """Text copied from old_rel into new_rel: every relative link keeps pointing at the same file."""
    old_dir, new_dir = os.path.dirname(old_rel), os.path.dirname(new_rel)

    def fix(m):
        t = m.group(2)
        if re.match(r"^[a-z]+:", t) or t.startswith(("/", "<")):
            return m.group(0)
        return f"{m.group(1)}{os.path.relpath(os.path.normpath(os.path.join(old_dir, t)), new_dir or '.')}{m.group(3) or ''}{m.group(4)}"
    return LINK.sub(fix, text)


def to_adr(text, number, slug, rel, archive, home="reef/architecture/adr"):
    text = relink(text, rel, f"{home}/{number:04d}-{slug}.md")
    title = (re.search(r"^#\s+(.+)$", text, re.M) or [None, slug])[1] if re.search(r"^#\s+(.+)$", text, re.M) else slug.replace("-", " ")
    sec = lambda h: (re.search(rf"^#+\s*{h}\s*$(.*?)(?=^#+\s|\Z)", text, re.M | re.S) or [None, ""])[1].strip() if re.search(rf"^#+\s*{h}\s*$", text, re.M | re.I) else ""
    ctx, dec, con = sec("Context") or text.strip()[:600], sec("Decision") or "(see the original, archived below)", sec("Consequences") or "+ (see the original)\n- (see the original)"
    one = f"In the context of {title}, facing {ctx.splitlines()[0][:80] if ctx else 'the forces below'}, we decided {dec.splitlines()[0][:80]}, to achieve what the Decision states, accepting the Consequences below."
    return (f"# ADR {number:04d} — {title}\n\nStatus: Accepted\nSupersedes: {archive}\n\n{one}\n\n## Context\n{ctx}\n\n## Decision\n{dec}\n\n"
            f"## Consequences\n{con}\n\n## Diagram\n```mermaid\nflowchart LR\n  decision[{slug}] --> system\n```\n")


def to_spec(text, feature, row, archive, rel=""):
    text = relink(text, rel, f"reef/features/{feature}/SPEC.md") if rel else text
    title = (re.search(r"^#\s+(.+)$", text, re.M) or [None, feature])[1] if re.search(r"^#\s+(.+)$", text, re.M) else feature
    bullets = [l.strip()[2:] for l in text.splitlines() if l.strip().startswith(("- ", "* "))][:12] or [title]
    frs = "\n".join(f"- FR-{i} [backend]: {b}" for i, b in enumerate(bullets, 1))
    return (f"# {title} — SPEC\n\nRow: {row}\nSlug: {feature}\nSupersedes: {archive}\n\n## Intent\n{title}: carried over from the original spec (archived).\n\n## Grill\n- Q: (none yet) — A: (none yet)\n\n"
            f"## Scope\n{text.strip()[:400]}\n\n## Non-goals\n(carry the original's non-goals here)\n\n## Already shipped\nnone\n\n## Requirements\n{frs}\n\n"
            f"## Success criteria\n- SC-1: the original spec's outcome is observable.\n\n## Owner decisions\n- (none yet)\n\n## Architecture impact\n(to be stated)\n")


# ---------------------------------------------------------------- measure (0.7.2, first adoption 2026-10-24, item 10)
# /reef-assess scored "module boundaries" by feel; nothing was counted. On the first adoption the largest files were tests and i18n
# dictionaries, the `$executeRawUnsafe` hits were mostly comments, and the tagged `$queryRaw` calls were parameterised.
CODE_EXT = (".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".py", ".go", ".rs", ".java", ".kt", ".rb", ".php", ".cs", ".swift",
            ".vue", ".svelte")   # schema and migration files are counted in their own table, never as product
TEST_FILE = re.compile(r"(^|/)(tests?|__tests__|spec)/|\.(test|spec)\.[a-z]+$|(^|/)test_[^/]+\.py$|_test\.(go|py|rs|js|ts)$")
GENERATED = re.compile(r"(^|/)(node_modules|dist|build|out|coverage|\.next|\.turbo|generated|__generated__|\.prisma|target|vendor|\.venv|\.reef|\.git)(/|$)")
DATA_DIR = re.compile(r"(^|/)(i18n|locales|interface|translations)(/|$)")
SQL_FUNC = re.compile(r"^\s*CREATE\s+(OR\s+REPLACE\s+)?FUNCTION\b", re.I | re.M)
SQL_TRIG = re.compile(r"^\s*CREATE\s+(OR\s+REPLACE\s+)?TRIGGER\b", re.I | re.M)
LINTERS = (".eslintrc", ".eslintrc.js", ".eslintrc.cjs", ".eslintrc.json", ".eslintrc.yml", ".eslintrc.yaml", "eslint.config.js",
           "eslint.config.mjs", "eslint.config.cjs", "eslint.config.ts", "biome.json", "biome.jsonc", ".golangci.yml", ".golangci.yaml",
           "ruff.toml", ".ruff.toml", ".flake8", ".pylintrc", "rustfmt.toml", ".rubocop.yml")
GUARD_NAME = re.compile(r"guard|forbid|forbidden|aimed|boundar|invariant|allowlist|denylist|no-[a-z]", re.I)
GUARD_TEXT = re.compile(r"\b(forbids?|forbidden|disallows?|must not|may not|not allowed|is never|are never)\b", re.I)


def count_lines(p):
    try:
        with open(p, "rb") as f:
            return sum(1 for _ in f)
    except OSError:
        return 0


# 0.7.3 (the owner's rule: Reef works on any stack): what one stack's tools look like — raw SQL, the database client, the
# layer-boundary tool, session and permission vocabulary — lives in scripts/reef-stacks.json, one profile per stack
def stack_profiles():
    try:
        with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "reef-stacks.json"), encoding="utf-8") as f:
            return {k: v for k, v in json.load(f).items() if isinstance(v, dict)}
    except (OSError, ValueError):
        return {}


def active_profiles(root):
    """[(name, profile, the text of its dependency manifests)] for each stack this project uses."""
    out = []
    for name, prof in stack_profiles().items():
        if any(os.path.isfile(os.path.join(root, f)) for f in prof.get("detect") or []):
            out.append((name, prof, "\n".join(read(os.path.join(root, f)) for f in prof.get("deps_from") or [] if os.path.isfile(os.path.join(root, f)))))
    return out


def has_dep(text, deps):
    return any(re.search(r"(?<![\w@/.-])" + re.escape(d) + r"(?![\w/-])", text, re.I) for d in deps)


def measure(root):
    """The facts /reef-assess used to guess: largest product files, product vs test LOC, raw SQL by directory (by the stack
    profile's raw-SQL rule; comment lines ignored), functions and triggers per migration (Observed; their classification is Inferred, by Explore),
    the linter, the project's existing guard tests, and the files over `assess.large_file` as candidate refactor rows."""
    import fnmatch
    cfg_p = os.path.join(root, ".reef", "config.json")
    cfg = json.loads(read(cfg_p)) if os.path.isfile(cfg_p) else {}
    a = cfg.get("assess") or {}
    excl = [str(x) for x in (a.get("exclude") or [])]
    large = int(a.get("large_file") or 800)
    files = [l for l in git(root, "ls-files", "-co", "--exclude-standard", check=False).splitlines() if l]
    excluded = lambda rel: any(fnmatch.fnmatch(rel, g) or rel.startswith(g.rstrip("/") + "/") for g in excl)
    product, tests = {}, {}
    for rel in files:
        # REEF_CODE: Reef's own scripts are never the project's product (two public repositories, 2026-10-25: the largest
        # "product" file was scripts/reef-queue.py and Reef's scripts were listed as the project's sensitive files)
        if not rel.endswith(CODE_EXT) or rel.endswith(".d.ts") or GENERATED.search(rel) or DATA_DIR.search(rel) or excluded(rel) or REEF_CODE.match(rel):
            continue
        (tests if TEST_FILE.search(rel) else product)[rel] = count_lines(os.path.join(root, rel))
    largest = sorted(product.items(), key=lambda kv: (-kv[1], kv[0]))[:10]
    # raw SQL: by each stack profile's raw-SQL rule, when the project depends on what it names; by directory; a comment never counts
    raw, raw_profile = {}, None
    for name, prof, deps_text in active_profiles(root):
        rs = prof.get("raw_sql")
        if not rs or not has_dep(deps_text, rs.get("when_deps") or []):
            continue
        raw_profile = raw_profile or {"name": rs.get("name", name), "unsafe_calls": rs.get("unsafe_calls", ""), "fix": rs.get("fix", "")}
        unsafe, safe = re.compile(rs["unsafe"]), re.compile(rs.get("safe") or r"(?!)")
        ext, comment = tuple(prof.get("code_ext") or ()), tuple(prof.get("comment") or ("#",))
        for rel in sorted(product) + sorted(tests):
            if not rel.endswith(ext):
                continue
            with open(os.path.join(root, rel), encoding="utf-8", errors="replace") as f:
                for line in f:
                    s = line.strip()
                    if s.startswith(comment):
                        continue
                    d = os.path.dirname(rel) or "."
                    if unsafe.search(s):
                        raw.setdefault(d, {"tagged": 0, "unsafe": 0, "files": []})["unsafe"] += 1
                        raw[d]["files"].append(rel) if rel not in raw[d]["files"] else None
                    elif safe.search(s):
                        raw.setdefault(d, {"tagged": 0, "unsafe": 0, "files": []})["tagged"] += 1
    migrations = {}
    for rel in files:
        if rel.endswith(".sql") and re.search(r"(^|/)(migrations?|migrate|supabase/migrations|alembic)(/|$)", rel):
            text = read(os.path.join(root, rel))
            migrations[rel] = {"functions": len(SQL_FUNC.findall(text)), "triggers": len(SQL_TRIG.findall(text))}
    linter = next((f for f in LINTERS if os.path.isfile(os.path.join(root, f))), None)
    if not linter and os.path.isfile(os.path.join(root, "pyproject.toml")) and re.search(r"^\[tool\.(ruff|flake8|pylint)", read(os.path.join(root, "pyproject.toml")), re.M):
        linter = "pyproject.toml [tool.ruff]"
    guards = []   # first adoption, 2026-10-25: 220 of 517 test files matched "never"/"rules" anywhere in their first 30 lines — noise
    for rel in sorted(tests):
        with open(os.path.join(root, rel), encoding="utf-8", errors="replace") as f:
            first = [f.readline() for _ in range(6)]
        docblock = "".join(l for l in first if l.strip().startswith(("/**", "*", "//", "#", '\"\"\"', "'''")) or '\"\"\"' in l)
        if GUARD_NAME.search(os.path.basename(rel)) or GUARD_TEXT.search(docblock):
            guards.append(rel)
    big = [(rel, n) for rel, n in sorted(product.items(), key=lambda kv: (-kv[1], kv[0])) if n > large]
    sensitive = sensitive_files(root, product)
    return {"date": datetime.date.today().isoformat(), "product": {"loc": sum(product.values()), "files": len(product)},
            "boundaries": boundaries(root, product),
            "sensitive": sensitive, "design_paths": design_paths(root, cfg, sensitive, files),
            "tests": {"loc": sum(tests.values()), "files": len(tests)}, "largest": largest,
            "raw_sql": raw if raw_profile else None, "raw_sql_profile": raw_profile,
            "raw_sql_note": "" if raw_profile else "not measured: no stack profile with a raw-SQL rule matches this project (scripts/reef-stacks.json)",
            "migrations": migrations, "linter": linter, "guard_tests": guards, "large_file": large, "large_files": big,
            "baseline": product}


# ---------------------------------------------------------------- boundaries (0.7.2, first adoption 2026-10-24, item 13)
# Layer boundaries were not enforced. The measure derives a dependency-cruiser config from the observed layout and writes
# today's violations as the known-violations baseline, so day one is green and only a NEW violation fails. Proposed under
# <git dir>/reef/recalibration/proposed/, applied by the owner with the plan; the gate is `depcruise --ignore-known`.
IMPORT_RE = re.compile(r"""(?:^|\n)\s*(?:import\s+(?:[^'"]*?\s+from\s+)?|export\s+[^'"]*?\s+from\s+|const\s+[^=]+=\s*require\()\s*['"]([^'"]+)['"]""")


def resolve_import(rel, spec, files, aliases):
    """A relative or aliased import to a product path in `files`, else None (a package import)."""
    for alias, target in aliases.items():
        if spec.startswith(alias):
            spec = target + spec[len(alias):]
            break
    else:
        if not spec.startswith("."):
            return None
        spec = os.path.normpath(os.path.join(os.path.dirname(rel), spec))
    spec = os.path.normpath(spec)
    for cand in (spec, *(spec + e for e in (".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs")), *(os.path.join(spec, "index" + e) for e in (".ts", ".tsx", ".js"))):
        if cand in files:
            return cand
    return None


def fill(template, values):
    """A profile template's @NAME@ placeholders (never braces: a rendered file must not look like an unfilled template)."""
    for k, v in values.items():
        template = template.replace(f"@{k}@", v)
    return template


def boundaries(root, product):
    """The first stack profile with a boundary tool: an ADR draft (a tool to decide on), or a config derived from the observed
    import graph with today's violations as the known-violations baseline (the JS/TS import graph: imports, tsconfig paths)."""
    hit = next(((n, p) for n, p, _ in active_profiles(root) if p.get("boundaries")), None)
    if hit is None:
        return None
    stack, prof = hit
    b = prof["boundaries"]
    if b.get("adr_draft"):
        draft = os.path.join(proposed_dir(root), b.get("adr_draft_file") or "adr-draft-boundaries.md")
        os.makedirs(os.path.dirname(draft), exist_ok=True)
        with open(draft, "w", encoding="utf-8") as f:
            f.write(b["adr_draft"])
        return {"stack": stack, "tool": b.get("tool", ""), "adr_draft": os.path.relpath(draft, root)}
    aliases = {}
    ts = os.path.join(root, "tsconfig.json")
    if os.path.isfile(ts):
        try:
            paths = (json.loads(re.sub(r"//[^\n]*|/\*.*?\*/", "", read(ts), flags=re.S)).get("compilerOptions") or {}).get("paths") or {}
            for k, v in paths.items():
                if k.endswith("/*") and v and str(v[0]).endswith("/*"):
                    aliases[k[:-1]] = os.path.normpath(str(v[0])[:-1]) + "/"
        except (ValueError, AttributeError, IndexError):
            pass
    if not aliases:
        aliases = {"@/": "src/"}
    ext = tuple(prof.get("code_ext") or ())
    files = set(product)
    client, pkg = re.compile(b["db_client"]), b.get("db_package", "")
    rules = [tuple(r) for r in b.get("rules") or []]
    db_files = sorted(rel for rel in files if rel.endswith(ext) and client.search(read(os.path.join(root, rel))))
    known = []
    for rel in sorted(files):
        if not rel.endswith(ext):
            continue
        for spec in IMPORT_RE.findall(read(os.path.join(root, rel))):
            to = resolve_import(rel, spec, files, aliases)
            if not (to in db_files or spec == pkg):
                continue
            for name, from_re, _ in rules:
                if re.search(from_re, rel):
                    known.append({"from": rel, "to": to or f"node_modules/{pkg}", "rule": {"severity": "error", "name": name}})
    db_re = "|".join(re.escape(p) for p in db_files) or b.get("db_fallback", "")
    rule_text = "".join(fill(b["config_rule"], {"NAME": n, "WHY": why, "FROM": fr, "DB_RE": db_re, "DB_PACKAGE": pkg}) for n, fr, why in rules)
    config = fill(b["config_header"], {"GATE": b["gate"]}) + fill(b["config_body"], {"RULES": rule_text})
    pdir = proposed_dir(root)
    os.makedirs(pdir, exist_ok=True)
    with open(os.path.join(pdir, b["config_file"]), "w", encoding="utf-8") as f:
        f.write(config)
    with open(os.path.join(pdir, b["baseline_file"]), "w", encoding="utf-8") as f:
        json.dump(known, f, indent=1)
        f.write("\n")
    existing = os.path.join(root, b["baseline_file"])
    new = []
    if os.path.isfile(existing):
        try:
            had = {(k.get("from"), k.get("to"), (k.get("rule") or {}).get("name")) for k in json.loads(read(existing))}
            new = [k for k in known if (k["from"], k["to"], k["rule"]["name"]) not in had]
        except (ValueError, AttributeError):
            new = []
    return {"stack": stack, "tool": b.get("tool", ""), "install": b.get("install", ""), "config_file": b["config_file"],
            "baseline_file": b["baseline_file"], "db_files": db_files, "rules": [n for n, _, _ in rules],
            "rule_text": [[n, why] for n, _, why in rules], "known": known, "new": new, "gate": b["gate"]}


def render_boundaries(b):
    if b is None:
        return ("## Proposed gate — boundaries\n\nNo boundary gate is proposed: no stack profile with a boundary tool matches this "
                "project (scripts/reef-stacks.json).\n")
    if b.get("adr_draft"):
        return f"## Proposed gate — boundaries ({b['stack']})\n\nAn ADR draft only: `{b['adr_draft']}` ({b['tool']}). No gate is proposed until the owner decides.\n"
    pd = ".git/reef/recalibration/proposed"
    lines = [f"## Proposed gate — boundaries ({b['stack']})", "",
             f"Derived from the observed layout; nothing is applied. On approval: move `{pd}/{b['config_file']}` and "
             f"`{pd}/{b['baseline_file']}` to the root, `{b['install']}`, and add to `gates.extra`: "
             f"`\"boundaries\": \"{b['gate']}\"`. Today's {len(b['known'])} violation(s) are the baseline: day one is green, only a NEW one fails.", "",
             f"- database client: {', '.join('`' + d + '`' for d in b['db_files']) or 'none found (no file matches the profile’s database client)'}",
             "- rules: " + "; ".join(f"`{n}` — {why}" for n, why in b["rule_text"]), "",
             "| rule | from | to |", "|---|---|---|"]
    lines += [f"| {k['rule']['name']} | `{k['from']}` | `{k['to']}` |" for k in b["known"]] or ["| – | none | – |"]
    if b["new"]:
        lines += ["", f"**{len(b['new'])} NEW violation(s) since the committed baseline** (`{b['baseline_file']}`): " +
                  ", ".join(f"`{k['from']}` → `{k['to']}`" for k in b["new"])]
    return "\n".join(lines) + "\n"

# ---------------------------------------------------------------- the real sensitive code (0.7.2, first adoption 2026-10-24, item 22)
# tiers.design.paths (auth, crypto, secrets, migrations globs) matched 0 of the 21 files holding access control, tenant isolation and
# money (session-access.ts, visibility*.ts, scoped-client*.ts, *tenant*, usage*.ts, metering*.ts, app/api/sign-in/**): a change there
# ran as an ordinary full task. The measure lists sensitive files BY CONTENT, Observed with file:line, and the plan proposes the
# exact tiers.design.paths diff with the count of files each glob matches; .reef/config.json stays owner-edited.
SENSITIVE = (("session, cookie or token handling", re.compile(r"\b(setCookie|getSession|jwt\.(sign|verify)|verifyToken|signToken|sessionStorage|session[-_]?access|refresh[-_]?token)\b", re.I)),
             ("RLS or tenant scoping", re.compile(r"set_config\(|\bRLS\b|row level security|\btenant[-_]?id\b|\btenantId\b|scoped[-_]?client|forTenant|withTenant|\bvisibility\b", re.I)),
             ("permission predicate", re.compile(r"\b(can[A-Z]\w+|is(Admin|Owner|Member|Allowed|Authorized|Permitted)|has(Permission|Role|Access)|assert(Role|Permission|Owner|Access)|require(Role|Permission|Auth)|authorize\w*)\b")),
             ("payment, usage, metering or cap", re.compile(r"\b(stripe|payment\w*|checkout|invoice\w*|metering|meter\w*|usage\w*|quota\w*|billing|credits?|plan[-_]?limit\w*)\b", re.I)),
             ("secret read", re.compile(r"process\.env\.[A-Z0-9_]*(SECRET|KEY|TOKEN|PASSWORD|PRIVATE)|environ(\.get)?\(?\[?[\"'][A-Z0-9_]*(SECRET|KEY|TOKEN|PASSWORD)|getenv\([\"'][A-Z0-9_]*(SECRET|KEY|TOKEN|PASSWORD)")),
             ("sign-in route", re.compile(r"\b(signIn|signOut|handleLogin|loginHandler)\b")))
SENSITIVE_PATH = re.compile(r"(^|/)(sign-?in|sign-?up|login|logout|auth|oauth|sso|callback|session|billing|payments?|metering|tenant\w*)(/|\.|-|_|$)", re.I)


def sensitive_files(root, product):
    out = []
    tm = os.path.join(root, "reef", "architecture", "threat-model.md")
    tm_lines = {}
    if os.path.isfile(tm):
        for n, line in enumerate(read(tm).splitlines(), 1):
            for m in re.finditer(r"(?<![\w/])((?:[\w.-]+/)+[\w.-]+\.(ts|tsx|js|py|go|rs))\b", line):
                tm_lines.setdefault(m.group(1), n)
    # the general vocabulary, then each stack profile's own (a framework's session call, its permission decorator)
    kinds_rx = list(SENSITIVE) + [(k, re.compile(rx)) for _, p, _ in active_profiles(root) for k, rx in (p.get("sensitive") or {}).items()]
    for rel in sorted(product):
        kinds = []
        if SENSITIVE_PATH.search(rel):
            kinds.append({"kind": "sensitive path", "line": 0})
        with open(os.path.join(root, rel), encoding="utf-8", errors="replace") as f:
            seen = set()
            for n, line in enumerate(f, 1):
                s = line.strip()
                if s.startswith(("//", "*", "/*", "#")):
                    continue
                for kind, rx in kinds_rx:
                    if kind not in seen and rx.search(s):
                        kinds.append({"kind": kind, "line": n})
                        seen.add(kind)
        if rel in tm_lines:
            kinds.append({"kind": "named by the threat model", "line": tm_lines[rel]})
        if kinds:
            out.append({"file": rel, "kinds": kinds})
    return out


def design_paths(root, cfg, sensitive, all_files):
    """The exact tiers.design.paths diff: today's globs, which sensitive files they already match, and the globs to add — a directory
    glob when a directory is mostly sensitive, else the file itself — each with the count of files it matches (git ls-files)."""
    import fnmatch
    match = lambda g, rel: fnmatch.fnmatch(rel, g) or (g.endswith("/**") and rel.startswith(g[:-3] + "/")) or (g.startswith("**/") and fnmatch.fnmatch(rel, g[3:]))
    current = [str(g) for g in (((cfg.get("tiers") or {}).get("design") or {}).get("paths") or [])]
    files = [s["file"] for s in sensitive]
    covered = [f for f in files if any(match(g, f) for g in current)]
    by_dir = {}
    for f in files:
        by_dir.setdefault(os.path.dirname(f), []).append(f)
    proposed = []
    for d, fs in sorted(by_dir.items()):
        in_dir = [x for x in all_files if os.path.dirname(x) == d]
        if len(fs) >= 2 and len(fs) * 2 >= len(in_dir):
            proposed.append(f"{d}/**")
        else:
            proposed += fs
    proposed = [g for g in proposed if not any(match(c, g) for c in current)]
    counts = {g: sum(1 for x in all_files if match(g, x)) for g in current + proposed}
    return {"current": current, "covered_by_current": covered, "proposed": proposed, "counts": counts,
            "uncovered": [f for f in files if f not in covered]}


def render_design_paths(dp, sensitive):
    lines = ["## Proposed tiers.design.paths (the design tier reaches the real sensitive code)", "",
             f"{len(sensitive)} sensitive file(s) found by content (below, Observed with file:line); today's globs match {len(dp['covered_by_current'])} of them. "
             "On approval the owner adds the proposed globs to `.reef/config.json` `tiers.design.paths` (owner-edited, never written by the apply); "
             "a task there then runs as `design`: the hunter's plan pass, the design-tier judges, and (item 22) the security agent on its diff.", "",
             "| glob | files it matches | status |", "|---|---|---|"]
    lines += [f"| `{g}` | {dp['counts'][g]} | today |" for g in dp["current"]]
    lines += [f"| `{g}` | {dp['counts'][g]} | **add** |" for g in dp["proposed"]] or ["| – | – | nothing to add |"]
    lines += ["", "| file | why (first hit per kind) |", "|---|---|"]
    lines += [f"| `{s['file']}` | " + "; ".join(f"{k['kind']} ({s['file']}:{k['line']})" if k["line"] else k["kind"] for k in s["kinds"]) + " |" for s in sensitive] or ["| – | none found |"]
    return "\n".join(lines) + "\n"


def render_measured(m):
    lines = ["## Measured", "",
             f"Counted by `python3 scripts/reef-recalibrate measure` on {m['date']} — Observed, not judged. Tests, `*.d.ts`, generated and "
             "data directories (`i18n`, `locales`, `interface`, `translations`) and `assess.exclude` are left out of the product set.", "",
             f"- Product: {m['product']['loc']:,} lines in {m['product']['files']} files · tests: {m['tests']['loc']:,} lines in {m['tests']['files']} files",
             f"- Linter: {'yes (' + m['linter'] + ')' if m['linter'] else 'no'}", "", "### Largest product files", "", "| lines | file |", "|---|---|"]
    lines += [f"| {n} | `{rel}` |" for rel, n in m["largest"]] or ["| – | none |"]
    lines += ["", "### Raw SQL by directory (comment lines ignored)", ""]
    if m["raw_sql"] is None:
        lines.append(m["raw_sql_note"])
    else:
        lines += ["| directory | tagged `$queryRaw`/`$executeRaw` | `…Unsafe` | Unsafe in |", "|---|---|---|---|"]
        lines += [f"| `{d}` | {v['tagged']} | {v['unsafe']} | {', '.join('`' + f + '`' for f in v['files']) or '–'} |" for d, v in sorted(m["raw_sql"].items())] or ["| – | 0 | 0 | – |"]
    lines += ["", "### Functions and triggers per migration (Observed; integrity rule or product rule is Inferred, by Explore)", "",
              "| migration | CREATE FUNCTION | CREATE TRIGGER |", "|---|---|---|"]
    lines += [f"| `{rel}` | {v['functions']} | {v['triggers']} |" for rel, v in sorted(m["migrations"].items()) if v["functions"] or v["triggers"]] or ["| – | 0 | 0 |"]
    lines += ["", "### Sensitive code, by content (Observed; the design tier should reach it — see reef/recalibration.md)", ""]
    lines += [f"- `{s['file']}`: " + "; ".join(f"{k['kind']} (line {k['line']})" if k["line"] else k["kind"] for k in s["kinds"]) for s in m.get("sensitive") or []] or ["- none found"]
    lines += ["", "### Existing guard tests (reuse before adding a gate)", ""]
    lines += [f"- `{g}`" for g in m["guard_tests"]] or ["- none found"]
    lines += ["", f"### Files over `assess.large_file` ({m['large_file']} lines) — candidate `kind: refactor` rows, proposed in reef/recalibration.md, never created here", ""]
    lines += [f"- `{rel}` ({n} lines)" for rel, n in m["large_files"]] or ["- none"]
    return "\n".join(lines) + "\n"


RAW_GUARD = re.compile(r"raw|sql|unsafe|inject", re.I)


def raw_sql_proposal(m):
    """Item 12's proposal (0.7.2): the files holding an Unsafe raw query today become `assess.raw_sql_allow` — a baseline, not a
    cleanup — and `reef-structure --raw-sql` joins gates.extra; when the project already has a guard test about raw SQL,
    that test is named instead of a new gate."""
    if not m.get("raw_sql"):
        return None
    allow = sorted({f for v in m["raw_sql"].values() for f in v["files"]})
    reuse = [g for g in m.get("guard_tests") or [] if RAW_GUARD.search(os.path.basename(g))]
    return {"allow": allow, "reuse": reuse, "gate": "python3 scripts/reef-structure --raw-sql", "profile": m.get("raw_sql_profile") or {}}


def render_raw_sql(p):
    if p is None:
        return ("## Proposed gate — raw SQL\n\nNot measured: no stack profile with a raw-SQL rule matches this project "
                "(scripts/reef-stacks.json); nothing proposed.\n")
    prof = p.get("profile") or {}
    lines = [f"## Proposed gate — raw SQL ({prof.get('name', '')})", ""]
    if p["reuse"]:
        lines += [f"The project already guards raw SQL: {', '.join('`' + g + '`' for g in p['reuse'])} — reuse it (keep it in `gates.full`); no new gate is proposed."]
    else:
        lines += ["On approval the owner adds to `.reef/config.json`: `assess.raw_sql_allow: " + json.dumps(p["allow"]) +
                  "` (today's files with an unsafe raw query — a baseline, not a cleanup) and to `gates.extra`: `\"raw-sql\": \"" + p["gate"] +
                  f"\"`. Day one is green; a new {prof.get('unsafe_calls', 'unsafe raw query')} outside those files fails."]
    return "\n".join(lines) + "\n"


def cmd_measure(root, as_json):
    m = measure(root)
    m["raw_sql_proposal"] = raw_sql_proposal(m)
    if as_json:
        print(json.dumps(m, indent=1))
    dz = os.path.join(root, "reef", "day-zero.md")
    os.makedirs(os.path.dirname(dz), exist_ok=True)
    text = read(dz) if os.path.isfile(dz) else "# Day zero\n"
    sec = re.search(r"^## Measured\n.*?(?=^## |\Z)", text, re.M | re.S)
    block = render_measured(m)
    text = text[:sec.start()] + block + text[sec.end():] if sec else text.rstrip("\n") + "\n\n" + block
    with open(dz, "w", encoding="utf-8") as f:
        f.write(text)
    with open(os.path.join(root, "reef", "size-baseline.json"), "w", encoding="utf-8") as f:
        json.dump({"generated": m["date"], "large_file": m["large_file"], "files": dict(sorted(m["baseline"].items()))}, f, indent=1)
        f.write("\n")
    rp = os.path.join(root, "reef", "recalibration.md")
    rows = [f"| `{rel}` | {n} | `kind: refactor` · `splits: {rel} under {m['large_file']} lines` |" for rel, n in m["large_files"]]
    prop = ("## Proposed rows (refactor)\n\nFiles over `assess.large_file`; each becomes a `kind: refactor` row only when the owner approves this "
            "plan — never created by the measure.\n\n| file | lines | row |\n|---|---|---|\n" + ("\n".join(rows) if rows else "| – | – | none |") + "\n")
    rtext = read(rp) if os.path.isfile(rp) else f"# Recalibration — {m['date']}\n\n"
    rsec = re.search(r"^## Proposed rows \(refactor\)\n.*?(?=^## |\Z)", rtext, re.M | re.S)
    rtext = rtext[:rsec.start()] + prop + rtext[rsec.end():] if rsec else rtext.rstrip("\n") + "\n\n" + prop
    bsec = re.search(r"^## Proposed gate — boundaries.*?\n.*?(?=^## |\Z)", rtext, re.M | re.S)
    bprop = render_boundaries(m["boundaries"])
    rtext = rtext[:bsec.start()] + bprop + rtext[bsec.end():] if bsec else rtext.rstrip("\n") + "\n\n" + bprop
    qsec = re.search(r"^## Proposed gate — raw SQL.*?\n.*?(?=^## |\Z)", rtext, re.M | re.S)
    qprop = render_raw_sql(m["raw_sql_proposal"])
    rtext = rtext[:qsec.start()] + qprop + rtext[qsec.end():] if qsec else rtext.rstrip("\n") + "\n\n" + qprop
    dsec = re.search(r"^## Proposed tiers\.design\.paths.*?\n.*?(?=^## |\Z)", rtext, re.M | re.S)
    dprop = render_design_paths(m["design_paths"], m["sensitive"])
    rtext = rtext[:dsec.start()] + dprop + rtext[dsec.end():] if dsec else rtext.rstrip("\n") + "\n\n" + dprop
    with open(rp, "w", encoding="utf-8") as f:
        f.write(rtext)
    if not as_json:
        print(f"measured: {m['product']['files']} product files ({m['product']['loc']:,} lines), {m['tests']['files']} test files; "
              f"{len(m['large_files'])} over {m['large_file']} lines; linter {'yes' if m['linter'] else 'no'}; {len(m['guard_tests'])} guard test(s) — "
              "reef/day-zero.md ## Measured, reef/size-baseline.json, reef/recalibration.md ## Proposed rows")
    return 0


def cmd_apply(root, list_path, commit, park=False):
    plan_path = list_path or os.path.join(root, ".reef", "recalibration.json")
    if not os.path.isfile(plan_path):
        die("no plan — run `reef-recalibrate plan` first (the owner approves reef/recalibration.md)", 1)
    plan = json.loads(read(plan_path))
    adoption = plan.get("adoption") or {}
    if adoption.get("in_flight") and not park:
        die("the old loop has work in flight: " + ", ".join(f"{x['branch']} (claimed by {x['claimed_by']})" for x in adoption["in_flight"]) +
            " — finish those branches first, or --apply --park-in-flight re-admits each as a Reef row; never migrate under a running loop", 1)
    if list_path and list_path.endswith(".md"):
        die("--list takes the JSON plan (edit the action column of .reef/recalibration.json)", 2)
    date = plan["date"]
    entries = [e for e in plan["entries"] if e["action"] != "keep" and os.path.isfile(os.path.join(root, e["path"]))]
    if not entries:
        print("nothing to do: every document is in the layout or kept")
        return 1
    def rewrite_src(rw):
        return next((p for p in (os.path.join(proposed_dir(root), rw["file"]), os.path.join(root, rw["proposed"])) if os.path.isfile(p)), None)
    lost = [rw["file"] for rw in plan.get("rewrites") or [] if os.path.isfile(os.path.join(root, rw["file"])) and not rewrite_src(rw)]
    if lost:
        die(f"the plan's rewrite of {', '.join(lost)} is missing (proposals live under {os.path.relpath(proposed_dir(root), root)}) — "
            "run `reef-recalibrate plan` again; nothing moved", 1)
    dirty = [l for l in git(root, "status", "--porcelain", check=False).splitlines() if l.strip() and not l.startswith("?? .reef/")]
    if dirty:   # Reef's own untracked state under .reef/ (a config copied into a scratch worktree) is not the owner's work
        die("the working tree is not clean — the apply is one commit, undone by one revert", 1)
    dead_before = dead_links(root)   # the apply answers for the links IT breaks, not for ones dead already (first adoption had 7)
    cfg_path = os.path.join(root, ".reef", "config.json")
    cfg = json.loads(read(cfg_path)) if os.path.isfile(cfg_path) else {}
    paths = cfg.get("paths", {})
    queue_path = os.path.join(root, paths.get("queue", "reef/queue.md"))
    moved, touched, created = {}, [], []
    adr_rel = adr_home(cfg)
    arch_adr = os.path.join(root, adr_rel)
    os.makedirs(arch_adr, exist_ok=True)
    numbered = [int(m.group(1)) for d in {arch_adr, os.path.join(root, "reef", "architecture", "adr"), os.path.join(root, "docs", "adr")}
                if os.path.isdir(d) for f in os.listdir(d) for m in [re.match(r"^(\d{4})-", f)] if m]
    kept = {}   # 0.7.2 (first adoption, item 21): 193 ADRs cited 456 times as `ADR NNNN` would each have taken a new number
    for e in entries:
        if e["action"] == "convert-adr" and e.get("adr_number"):
            n, name = int(e["adr_number"]), os.path.basename(e["path"])
            clash = [f for f in os.listdir(arch_adr) if re.match(rf"^{n:04d}-", f)] + ([os.path.basename(kept[n])] if n in kept else [])
            if clash:
                die(f"ADR number {n:04d} clashes: {e['path']} and {adr_rel}/{clash[0]} — renumber one by hand; nothing moved", 1)
            kept[n] = e["path"]
            numbered.append(n)
    nxt = (max(numbered) + 1) if numbered else 1
    next_row = 1
    if os.path.isfile(queue_path):
        ids = [int(m.group(1)) for m in re.finditer(r"^\|\s*(\d+)\s*\|", read(queue_path), re.M)]
        next_row = (max(ids) + 1) if ids else 1
    on_issues = (cfg.get("queue") or {}).get("home") == "issues"
    if on_issues:   # 0.7.1: the rows live on issues, the file holds none: the next id comes from the queue script
        r = subprocess.run([sys.executable, os.path.join(os.path.dirname(os.path.abspath(__file__)), "reef-queue.py"), "next-id",
                            "--repo", root], capture_output=True, text=True)
        if r.returncode != 0 or not r.stdout.strip().isdigit():
            die(f"the queue is on issues and its next id is unknown ({(r.stderr or r.stdout).strip()[:200]}); nothing moved", 1)
        next_row = int(r.stdout.strip())
    index = ["# Archive", "", f"Moved by `scripts/reef-recalibrate --apply` on {date}; undo with `git revert` of that commit. Deleting this directory is a later queue row.", "",
             "| original | new home | reason |", "|---|---|---|"]
    gloss_terms = []
    queue_script = os.path.join(os.path.dirname(os.path.abspath(__file__)), "reef-queue.py")
    new_rows = []

    def add_row(item, source="planned"):
        r = subprocess.run([sys.executable, queue_script, "add-row", "--item", item, "--source", source, "--repo", root], capture_output=True, text=True)
        if r.returncode != 0 or not r.stdout.strip().isdigit():
            die(f"a Reef row could not be created ({(r.stderr or r.stdout).strip()[:200]}); nothing moved", 1)
        new_rows.append(int(r.stdout.strip()))
        return new_rows[-1]

    # rows first, before any move: the old queue's open rows, the parked in-flight branches, the readers to retire
    for e in entries:
        if e["action"] == "convert-queue":
            for row in [r for r in parse_old_queue(read(os.path.join(root, e["path"]))) if r["open"]]:
                add_row(f"{row['title'][:150]} (from {e['path']} row {row['id']})")
    for x in adoption.get("in_flight") or [] if park else []:
        add_row(f"parked: finish branch {x['branch']} under Reef (was in flight under the old loop, claimed by {x['claimed_by']})")
    retire_rows = {}
    for rd in [r for r in adoption.get("readers") or [] if r["action"] == "retire"]:
        key = (rd["reader"], rd["directory"])
        if key not in retire_rows:
            retire_rows[key] = add_row(f"retire or repoint {rd['reader']}: it reads {rd['directory']}/; the documents under it move to Reef's tree once it does", "found")
    for e in entries:
        rel, arch = e["path"], e["archive"]
        text = read(os.path.join(root, rel))
        if e["action"] == "merge-handoff":   # item 18: the old handoff's text under its own heading in HANDOFF.md, the original archived
            hp = os.path.join(root, "HANDOFF.md")
            prev = read(hp) if os.path.isfile(hp) else f"# Handoff — {date}\n\nRead this first, then `AGENTS.md`.\n"
            with open(hp, "w", encoding="utf-8") as f:
                f.write(prev.rstrip("\n") + f"\n\n## Carried over from {rel} ({date})\n\n" + re.sub(r"^# .*\n", "", text, count=1).strip() + "\n")
            touched.append("HANDOFF.md")
        if e["action"] == "convert-adr" and e.get("adr_number"):   # the same record moves, number and text intact, no Supersedes
            new = f"{adr_rel}/{os.path.basename(rel)}"
            git(root, "mv", rel, new)
            moved[rel] = new
            touched.append(new)
            index.append(f"| `{rel}` | `{new}` | {e['reason']} — the same record, its number kept |")
            continue
        os.makedirs(os.path.dirname(os.path.join(root, arch)), exist_ok=True)
        git(root, "mv", rel, arch)
        moved[rel] = arch
        touched.append(arch)
        home = arch
        if e["action"] == "convert-adr":
            new = f"{adr_rel}/{nxt:04d}-{e['adr_slug']}.md"
            with open(os.path.join(root, new), "w", encoding="utf-8") as f:
                f.write(to_adr(text, nxt, e["adr_slug"], rel, arch, adr_rel))
            nxt += 1
            moved[rel] = new
            created.append(new)
            home = f"{new} (original under {arch})"
        elif e["action"] == "convert-feature":
            feat = e["feature"]
            new = f"reef/features/{feat}/SPEC.md"
            os.makedirs(os.path.join(root, "reef", "features", feat, "tasks", "done"), exist_ok=True)
            with open(os.path.join(root, new), "w", encoding="utf-8") as f:
                f.write(to_spec(text, feat, next_row, arch, rel))
            if os.path.isfile(queue_path):
                with open(queue_path, "a", encoding="utf-8") as f:
                    if not re.search(r"^\|\s*Id\s*\|.*\bDepends\b", read(queue_path), re.M):   # on issues the file has no table
                        f.write("\n| Id | Item | Depends | Source | Batch | Admitted |\n|---|---|---|---|---|---|\n")
                    f.write(f"| {next_row} | {feat.replace('-', ' ')} (recalibrated from {rel}) | | planned | 1 | |\n")
                touched.append(os.path.relpath(queue_path, root))
            next_row += 1
            moved[rel] = new
            created.append(new)
            home = f"{new} (+ queue row, original under {arch})"
        elif e["action"] == "merge-glossary":
            gloss_terms += [l for l in text.splitlines() if l.startswith("|") and "---" not in l and not re.match(r"^\|\s*Term\s*\|", l)]
            home = f"reef/glossary.md (original under {arch})"
        if e["action"] == "convert-queue":
            home = f"{arch} (open rows → Reef's queue)"
        elif e["action"] == "merge-handoff":
            home = f"HANDOFF.md (original under {arch})"
        index.append(f"| `{rel}` | `{home}` | {e['reason']} |")
    # readers of a moved document that name its exact path are repointed in place (item 18.1); directory readers were retired as rows
    for rd in adoption.get("readers") or []:
        if rd["action"] == "repoint" and rd["target"] in moved and rd.get("new"):
            rp_ = os.path.join(root, rd["reader"])
            if os.path.isfile(rp_):
                t = read(rp_)
                if rd["target"] in t:
                    with open(rp_, "w", encoding="utf-8") as f:
                        f.write(t.replace(rd["target"], rd["new"]))
                    touched.append(rd["reader"])
                    index.append(f"| `{rd['reader']}` | (repointed) | reader of `{rd['target']}` → `{rd['new']}` |")
    if gloss_terms:
        gp = os.path.join(root, paths.get("glossary", "reef/glossary.md"))
        os.makedirs(os.path.dirname(gp), exist_ok=True)
        if not os.path.isfile(gp):
            with open(gp, "w", encoding="utf-8") as f:
                f.write("# Glossary\n\n| Term | Definition |\n|---|---|\n")
        with open(gp, "a", encoding="utf-8") as f:
            f.write("\n".join(gloss_terms) + "\n")
        touched.append(os.path.relpath(gp, root))
    # item 19: the instruction layer's rewrites, in this same commit; a duplicate CLAUDE file is merged into the primary and archived
    lay = plan.get("instruction_layer") or {}
    for rw in plan.get("rewrites") or []:
        src = rewrite_src(rw)
        if src and os.path.isfile(os.path.join(root, rw["file"])):
            with open(os.path.join(root, rw["file"]), "w", encoding="utf-8") as f:
                f.write(read(src))
            touched.append(rw["file"])
            index.append(f"| `{rw['file']}` | `{rw['file']}` (rewritten) | instruction layer: process sections → one pointer to Reef's tree |")
    for dup in lay.get("duplicates") or []:
        if os.path.isfile(os.path.join(root, dup)) and lay.get("primary") and os.path.isfile(os.path.join(root, lay["primary"])):
            with open(os.path.join(root, lay["primary"]), "a", encoding="utf-8") as f:
                f.write(f"\n\n## Carried over from {dup}\n\n" + re.sub(r"^# .*\n", "", read(os.path.join(root, dup)), count=1))
            arch = f"reef/archive/{date}/{dup}"
            os.makedirs(os.path.dirname(os.path.join(root, arch)), exist_ok=True)
            git(root, "mv", dup, arch)
            moved[dup] = arch
            touched.append(lay["primary"])
            index.append(f"| `{dup}` | `{arch}` | a second CLAUDE file, merged into {lay['primary']} |")
    for c in plan.get("create", []):
        if c.endswith("/"):
            os.makedirs(os.path.join(root, c), exist_ok=True)
    with open(os.path.join(root, "reef", "archive", "README.md"), "w", encoding="utf-8") as f:
        f.write("\n".join(index) + "\n")
    created.append("reef/archive/README.md")
    broken, already_dead = rewrite_links(root, moved, touched + created, dead_before)
    if broken:
        git(root, "reset", "-q", "--hard", "HEAD", check=False)
        git(root, "clean", "-fdq", "--", "reef", check=False)
        print("REFUSED: the apply would leave broken relative links — tree restored:")
        for b in broken[:20]:
            print(f"  - {b}")
        return 1
    if already_dead:
        print(f"note: {len(already_dead)} relative link(s) were already broken before the apply and travelled as they were (not this apply's to fix):")
        for b in already_dead[:10]:
            print(f"  - {b}")
    for rw in plan.get("rewrites") or [] if commit else []:   # applied: not left waiting (only now: a refused apply keeps them;
        if rw["file"] in touched and rewrite_src(rw):          # only when committing: a scratch apply shares the proposals)
            os.remove(rewrite_src(rw))
    if commit:
        git(root, "add", "-A")   # the tree was clean before: everything staged is this apply (the moves are already staged)
        git(root, "-c", "user.email=reef@local", "-c", "user.name=reef", "commit", "-q", "-m",
            f"chore: reef recalibration {date} — {len(entries)} document(s) converted or archived (undo: git revert)")
    if commit and on_issues and any(e["action"] == "convert-feature" for e in entries):
        # the move stays one revertable commit; its rows then become issues and leave the file in a commit of their own
        r = subprocess.run([sys.executable, os.path.join(os.path.dirname(os.path.abspath(__file__)), "reef-queue.py"), "import-rows",
                            "--apply", "--repo", root], capture_output=True, text=True)
        print(r.stdout.strip() or r.stderr.strip())
        if r.returncode == 0:
            git(root, "add", "--", os.path.relpath(queue_path, root))
            git(root, "-c", "user.email=reef@local", "-c", "user.name=reef", "commit", "-q", "-m",
                "queue: recalibrated rows moved to issues", check=False)
        else:
            print("the rows stay in the queue file: python3 scripts/reef-queue.py import-rows --apply moves them")
    print(f"applied: {len(entries)} document(s) — {sum(1 for e in entries if e['action'] == 'convert-adr')} ADR(s), "
          f"{sum(1 for e in entries if e['action'] == 'convert-feature')} feature folder(s), index at reef/archive/README.md" + (" (committed)" if commit else ""))
    # the hand-off line (item 18.5): complete, or partial with the rows and their blockers; the holds the project's own documents name
    waiting = [e for e in plan["entries"] if e.get("blocked_by")]
    if waiting:
        ids = sorted(new_rows)
        print(f"hand-off: partial: {len(waiting)} document(s) outside Reef's tree — rows #{ids[0]}–#{ids[-1]}" if ids else f"hand-off: partial: {len(waiting)} document(s) outside Reef's tree",
              "— blocked by " + "; ".join(sorted({e['blocked_by'] for e in waiting})))
    else:
        print("hand-off: Reef's tree is complete")
    for h in adoption.get("holds") or []:
        print(f"hold: {h['file']}:{h['line']} — {h['text']} (outranks Reef's merge default)")
    return 0


def main(argv):
    repo = "."
    if "--repo" in argv:
        i = argv.index("--repo")
        repo = argv[i + 1]
        argv = argv[:i] + argv[i + 2:]
    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=repo, capture_output=True, text=True).stdout.strip()
    if not root:
        die("not a git repository", 2)
    if argv[:1] == ["plan"]:
        return cmd_plan(root, "--measure" in argv, "--move" in argv)
    if argv[:1] == ["history"]:
        print(json.dumps(cmd_history(root), indent=1))
        return 0
    if argv[:1] == ["measure"]:
        return cmd_measure(root, "--json" in argv)
    if argv[:1] == ["--apply"]:
        lst = argv[argv.index("--list") + 1] if "--list" in argv else None
        return cmd_apply(root, lst, "--no-commit" not in argv, "--park-in-flight" in argv)
    die("usage: reef-recalibrate plan [--measure] | history | measure [--json] | --apply [--list plan.json] [--no-commit] [--park-in-flight]  [--repo DIR]")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
