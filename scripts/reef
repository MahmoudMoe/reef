#!/usr/bin/env python3
# CLASS: code
"""reef — the owner's one entry point (2026-10-28: "the person opens the terminal, writes reef, sees a logo and the options,
each with a short description"). `reef` alone on a terminal: THE SCREEN (consolidation step 5, 2026-10-30) — the status line,
the inbox of every wait Reef recorded, each with the exact command the row machine names so one key runs it, the runner's last
steps, the doctor's warnings; off a terminal, the menu. `reef <verb> [args]` runs the sibling script that verb names, in the
project this runs in (`--repo DIR` for another). `reef --all`: every script here with its purpose line — the internal ones,
which the skills and agents run, not a person. The screen knows nothing the scripts do not: every key runs a command you could type.
Verbs: screen [--once] · approve <row> · answer <row> "<text>" · status · doctor · run [n] · night · watch · stop · setup · update · factory [row] · cost
"""
import json
import os
import re
import shlex
import subprocess
import sys
import time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))   # the shared helpers live beside this script
sys.dont_write_bytecode = True   # and no scripts/__pycache__ lands in a project's tree (reef-update, a row worktree read it as changes)
from reef_common import main_checkout, approval_questions, questions, answer_command, drop_question  # noqa: E402

HERE = os.path.dirname(os.path.abspath(__file__))
PY = sys.executable
BANNER = r"""
  ____  ____  ____  ____
 |  _ \| ___|| ___|| ___|   Reef — run a software project as a graph of gated work
 | |_) |  _| |  _| |  _|
 |_| \_\____||____||_|
"""
VERBS = [
    ("screen",  "the live screen: the inbox of what waits on you, one key per command (`screen --once` prints it and exits)",
     lambda root, a: cmd_screen(root, a)),
    ("approve", "`approve <row>`: the row's plan approval at its current digest — the line you would type, typed for you",
     lambda root, a: cmd_approve(root, a)),
    ("answer",  "`answer <row> \"<text>\"`: your answer to a filed question — `answered <#>` on an issues queue, the footnote on a file",
     lambda root, a: cmd_answer(root, a)),
    ("status",  "where things stand: the runner, the night, the last session, the loop's wait",
     lambda root, a: run_script("reef-run.py", ["status", "--repo", root], root)),
    ("doctor",  "what is wrong and the one command that fixes each thing (plugin, probe, hold, setup, scripts)",
     lambda root, a: run_script("reef-doctor.py", ["--repo", root, *a], root)),
    ("run",     "the loop in fresh headless sessions until it waits on you — `run 5` caps the sessions",
     lambda root, a: run_script("reef-run.py", ["--repo", root, "--detach", *(["--max-iterations", a[0], *a[1:]] if a and a[0].isdigit() else a)], root)),
    ("night",   "tonight's contract: install it, print the approval question; `night start` runs it detached",
     lambda root, a: run_script("reef-run.py", ["--repo", root, "--night", "--detach"] if a[:1] == ["start"] else ["contract", "--repo", root, *a], root)),
    ("watch",   "the runner's live steps, one line each (Ctrl-C leaves, stops nothing)",
     lambda root, a: run_script("reef-run.py", ["watch", "--repo", root], root)),
    ("stop",    "the runner ends after its current session, never mid-merge; a session a dead runner left behind is ended now",
     lambda root, a: run_script("reef-run.py", ["stop", "--repo", root], root)),
    ("setup",   "the worktree setup, proven once per change: `setup` says the state, `setup prove` proves it",
     lambda root, a: run_script("reef-setup.py", [*(a or ["state"]), "--repo", root], root)),
    ("update",  "pull the plugin, update the project's scripts (one commit), re-prove the setup, say the reload step",
     lambda root, a: cmd_update(root, a)),
    ("factory", "the row on GitHub Actions: `factory` shows the last runs, `factory <row>` labels its issue reef-ready",
     lambda root, a: cmd_factory(root, a)),
    ("cost",    "the pipeline per merged row against the last batch (`cost --since 2026-10-01`)",
     lambda root, a: run_script("reef-cost.py", ["rows", "--repo", root, *a], root)),
]


def plugin_dir(root=None):
    """The plugin clone: CLAUDE_PLUGIN_ROOT, else the marketplace entry whose installLocation (or source.path) holds Reef's plugin.json."""
    cands = [os.environ.get("CLAUDE_PLUGIN_ROOT")]
    try:
        with open(os.path.expanduser("~/.claude/plugins/known_marketplaces.json"), encoding="utf-8") as f:
            for v in json.load(f).values():
                if isinstance(v, dict):
                    cands.append(v.get("installLocation"))
                    src = v.get("source")
                    if isinstance(src, dict):
                        cands.append(src.get("path"))
    except (OSError, ValueError):
        pass
    for c in cands:
        if not c:
            continue
        try:
            with open(os.path.join(c, ".claude-plugin", "plugin.json"), encoding="utf-8") as f:
                name = json.load(f).get("name")
        except (OSError, ValueError, TypeError):
            continue
        if name == "reef" and os.path.isfile(os.path.join(c, "scripts", "reef-update.py")):
            return c
    return None


def script(name):
    """A Reef script: the sibling copy in this folder, else the plugin's (reef-doctor.py and reef-update.py live only there)."""
    here = os.path.join(HERE, name)
    if os.path.isfile(here):
        return here
    plugin = plugin_dir()
    if plugin and os.path.isfile(os.path.join(plugin, "scripts", name)):
        return os.path.join(plugin, "scripts", name)
    return None


def run_script(name, args, cwd):
    path = script(name)
    if not path:
        print(f"reef: scripts/{name} is not here and no plugin clone was found — python3 <plugin>/scripts/reef-update.py --repo . --commit copies it", file=sys.stderr)
        return 1
    return subprocess.run([PY, path, *args], cwd=cwd).returncode


def purpose(path):
    """A script's first purpose line: the docstring's first sentence, or the first `# ` comment after the CLASS line."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read(4000)
    except OSError:
        return ""
    m = re.search(r'"""(.+?)(?:\n|""")', text, re.S)
    if m:
        return m.group(1).strip().split(". ")[0][:110]
    for line in text.splitlines():
        if line.startswith("# ") and "CLASS:" not in line and not line.startswith("#!/"):
            return line[2:].strip()[:110]
    return ""


def status_line(root):
    try:
        with open(os.path.join(root, ".reef", "run", "lock"), encoding="utf-8") as f:
            os.kill(int(f.read().strip() or 0), 0)
        runner = "the runner is running"
    except (OSError, ValueError):
        runner = "no runner is running"
    try:
        with open(os.path.join(root, ".reef", "loop.json"), encoding="utf-8") as f:
            st = json.load(f)
        wait = str(st.get("wait") or "")
        loop = f"the loop waits: {wait[:80]}" if wait else "the loop is active" if st.get("active") else "the loop is idle"
    except (OSError, ValueError):
        loop = "the loop is idle"
    return f"{runner} · {loop}"




# ---------------------------------------------------------------- the screen (consolidation step 5)

SHELL_SYNTAX = re.compile(r"[();|&<>$`]")


def load_sibling(name, modname):
    """A sibling script as a module (reef-run.py: the runner's own view of its lock and session), or None."""
    path = script(name)
    if not path:
        return None
    import importlib.machinery, importlib.util
    loader = importlib.machinery.SourceFileLoader(modname, path)
    spec = importlib.util.spec_from_loader(modname, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def row_state(root, row):
    """The row machine's view (reef-row.py state --json), or {} — kept as one seam for the tests."""
    path = script("reef-row.py")
    if not path or not str(row).isdigit():
        return {}
    try:
        r = subprocess.run([PY, path, "state", str(row), "--json", "--repo", root], capture_output=True, text=True, timeout=60)
        return json.loads(r.stdout) if r.returncode == 0 else {}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}


def handoff_awaiting(root):
    """The tick's `awaiting:` line as HANDOFF.md renders it — since #210 it carries each approval's exact question."""
    try:
        with open(os.path.join(root, "HANDOFF.md"), encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return ""
    m = re.search(r"^## The tick\n```\n(.*?)\n```", text, re.S | re.M)
    m2 = re.search(r"^awaiting: (.*)$", m.group(1) if m else "", re.M)
    return m2.group(1) if m2 else ""


def runner_view(root):
    """(runner pid or 0, session pid or 0, since) through the runner's own functions — never a second reading of its files."""
    mod = load_sibling("reef-run.py", "reef_run_for_screen")
    if mod is None:
        return 0, 0, ""
    try:
        spid, since = mod.session_record(root)
        return mod.runner_pid(root), spid, since
    except Exception:
        return 0, 0, ""


def doctor_lines(root):
    path = script("reef-doctor.py")
    if not path:
        return []
    try:
        return subprocess.run([PY, path, "--repo", root], capture_output=True, text=True, timeout=120).stdout.splitlines()
    except (OSError, subprocess.TimeoutExpired):
        return []


def item(kind, text, argv, shown=None, row=None, recommended="", issue=""):
    """An inbox item: what it is, the argv that runs it (never a shell), and the line the owner would type."""
    return {"kind": kind, "text": text, "argv": argv, "cmd": shown or shlex.join(argv), "row": row, "recommended": recommended, "issue": issue}


def approve_item(q, text=None, row=None):
    return item("approve", text or q, [PY, script("reef-approval.py") or "scripts/reef-approval.py", "--owner", q],
                shown=f'python3 scripts/reef-approval.py --owner "{q}"', row=row)


def inbox(root, doctor=None, runner=None):
    """Every wait Reef has recorded, as items — each with the argv that answers it, never twice. The sources are the loop's
    own files and scripts; agent-written text becomes a command only through a regex that admits nothing a shell reads."""
    items = []

    def add(it):
        if it["argv"] and it["cmd"] not in [i["cmd"] for i in items]:
            items.append(it)

    st = read_json(os.path.join(root, ".reef", "loop.json"))
    wait = str(st.get("wait") or "")
    for q in approval_questions(wait + "\n" + handoff_awaiting(root)):
        add(approve_item(q))
    for r in dict.fromkeys(re.findall(r"\brow (\d+)", wait)):
        qs = approval_questions(str(row_state(root, r).get("detail") or ""))
        if qs:
            add(approve_item(qs[0], text=f"row {r}: {qs[0]}", row=r))
    for r, issue, q, rec in questions(root):
        a = answer_command(root, r, issue, rec or "<your answer>")   # answered <#> on issues, the footnote on a file queue, the recommendation filled in
        text = f"row {r}" + (f" (#{issue})" if issue else "") + f": {q}" + (f" (recommended: {rec})" if rec else "")
        if a:
            argv, shown = a
            add(item("answer", text, [PY, script("reef-queue.py") or "scripts/reef-queue.py"] + argv[2:], shown=shown, row=r, recommended=rec, issue=issue))
        else:   # an issues queue, a line from before 0.7.4, and gh could not name the issue: the look that finds it (never silence)
            add(item("look", text + " — its reef-question issue is not named here", ["gh", "issue", "list", "--label", "reef-question", "--search", f"row {r}"],
                     shown=f'gh issue list --label reef-question --search "row {r}"', row=r))
    if st.get("parked"):
        add(item("unpark", f"the loop parked: {str(st['parked'])[:100]}", [PY, script("reef-loop.py") or "scripts/reef-loop.py", "start", "--repo", root],
                 shown="python3 scripts/reef-loop.py start"))
    pid, spid, since = runner if runner is not None else runner_view(root)
    if not pid and spid > 0:
        add(item("stop", f"runner gone, session {spid} still running since {since}", [PY, script("reef-run.py") or "scripts/reef-run.py", "stop", "--repo", root],
                 shown="python3 scripts/reef-run.py stop"))
    for line in (doctor if doctor is not None else []):
        if not line.startswith("WARN") or " — " not in line:
            continue
        what, fix = line[4:].strip().rsplit(" — ", 1)   # the fix is the LAST part: a bare command, or not an item at all
        if not fix.startswith(COMMAND_WORDS) or SHELL_SYNTAX.search(fix) or re.search(r"<[^>]+>", fix):
            continue
        argv = shlex.split(fix)
        argv[0] = PY if argv[0] == "python3" else argv[0]
        add(item("fix", what, argv, shown=fix))
    return items


COMMAND_WORDS = ("python3 ", "git ", "claude ", "sh ", "gh ")


def screen_text(root, doctor=None, width=120):
    """The screen as text: the status line, the inbox, the runner's last steps, the doctor's warnings, the keys."""
    st = read_json(os.path.join(root, ".reef", "loop.json"))
    runner = runner_view(root)
    pid, spid, since = runner
    runner_s = (f"runner running (pid {pid})" if pid else f"runner gone, session {spid} still running since {since}" if spid > 0 else "no runner is running")
    loop = ("the loop waits on you" if st.get("wait") else "the loop parked" if st.get("parked") else "the loop is active" if st.get("active") else "the loop is idle")
    try:
        with open(os.path.join(root, ".reef", "version"), encoding="utf-8") as f:
            ver = f.read().strip()
    except OSError:
        ver = "?"
    items = inbox(root, doctor, runner)
    lines = [f"reef {os.path.basename(root)} · Reef {ver} · {loop} · {runner_s} · {time.strftime('%H:%M:%S')}", "",
             "INBOX — what waits on you (a number runs it)"]
    if not items:
        lines.append("  nothing waits on you")
    for n, it in enumerate(items, 1):
        lines.append(f"  {n:>2}  {it['kind']:<8} {it['text'][:width - 14]}" if n <= 9 else f"      {it['kind']:<8} {it['text'][:width - 14]}  (beyond the keys: type its line)")
        lines.append(f"      {it['cmd']}")
    lines += ["", "RUNNER — the last steps"]
    try:
        with open(os.path.join(root, ".reef", "run", "live.log"), encoding="utf-8") as f:
            tail = f.read().splitlines()[-10:]
    except OSError:
        tail = []
    lines += ["  " + l[:width - 2] for l in tail] or ["  (no steps recorded)"]
    if doctor is not None:
        warns = [l for l in doctor if l.startswith(("WARN", "FAIL"))]
        lines += ["", "DOCTOR — " + (f"{len(warns)} warning(s) (d for the whole report)" if warns else "nothing wrong")]
        lines += ["  " + l[:width - 2] for l in warns[:6]]
    lines += ["", "keys: 1-9 run an item · r run · n night · s stop · d doctor · c cost · u update · g refresh · q quit"]
    return "\n".join(lines) + "\n"


def cmd_screen(root, args):
    if "--once" in args or not (sys.stdout.isatty() and sys.stdin.isatty()):
        print(screen_text(root, doctor_lines(root)), end="")
        return 0
    try:
        import curses
    except ImportError:
        print(screen_text(root, doctor_lines(root)), end="")
        return 0
    return curses.wrapper(lambda stdscr: screen_loop(stdscr, root, curses))


def run_shown(root, argv, shown):
    """Run an item's argv — no shell — showing the line the owner would type, and wait for a key."""
    print(f"\n$ {shown}\n", flush=True)
    rc = subprocess.run(argv, cwd=root).returncode
    try:
        input(f"\n[exit {rc}] press Enter to return to the screen")
    except EOFError:
        pass


def screen_loop(stdscr, root, curses):
    curses.curs_set(0)
    stdscr.timeout(3000)
    doctor = doctor_lines(root)
    while True:
        h, w = stdscr.getmaxyx()
        text = screen_text(root, doctor, width=max(40, w - 1))
        stdscr.erase()
        for y, line in enumerate(text.splitlines()[:h - 1]):
            try:
                stdscr.addnstr(y, 0, line.encode("utf-8", "replace").decode("utf-8") if sys.stdout.encoding and "utf" in sys.stdout.encoding.lower() else line.encode("ascii", "replace").decode("ascii"), w - 1)
            except (curses.error, UnicodeEncodeError):
                pass
        stdscr.refresh()
        k = stdscr.getch()
        if k == -1:
            continue
        ch = chr(k) if 0 < k < 256 else ""
        if ch == "q":
            return 0
        if ch == "g":
            doctor = doctor_lines(root)
            continue
        argv, shown = None, None
        verb = {"r": "run", "n": "night", "s": "stop", "d": "doctor", "c": "cost", "u": "update"}.get(ch)
        if verb:
            argv, shown = [PY, os.path.abspath(__file__), verb, "--repo", root], f"reef {verb}"
        elif ch.isdigit() and ch != "0":
            items = inbox(root, doctor)
            n = int(ch)
            if n <= len(items):
                it = items[n - 1]
                argv, shown = it["argv"], it["cmd"]
                if it["kind"] == "answer":
                    curses.endwin()
                    try:
                        text = input(f"your answer for row {it['row']} [{it['recommended']}]: ").strip() or it["recommended"]
                    except EOFError:
                        text = ""
                    key = f"#{it['issue']}" if it.get("issue") else it["row"]   # a row-less question answers by its issue
                    argv, shown = ([PY, os.path.abspath(__file__), "answer", key, text, "--repo", root], f"reef answer {shlex.quote(key)} {shlex.quote(text)}") if text else (None, None)
        if argv:
            curses.endwin()
            run_shown(root, argv, shown)
            doctor = doctor_lines(root)
            stdscr.clear()


def cmd_approve(root, args):
    """The row's plan approval, as the row machine names it: `reef-approval.py --owner "Approve plan <slug> at <digest>?"`."""
    rows = [a for a in args if not a.startswith("--")]
    if len(rows) != 1:
        print("reef approve <row>", file=sys.stderr)
        return 2
    d = row_state(root, rows[0])
    qs = approval_questions(str(d.get("detail") or ""))
    if not qs:
        print(f"reef approve: row {rows[0]} is in state {d.get('state', 'unknown')!r} — nothing to approve ({str(d.get('detail') or 'the row machine has no view of it')[:160]})")
        return 1
    it = approve_item(qs[0], row=rows[0])
    print(f"reef approve: {it['cmd']}", flush=True)
    if "--dry-run" in args:
        return 0
    return subprocess.run(it["argv"], cwd=root).returncode


def cmd_answer(root, args):
    """Your answer to a filed question — `reef answer <row> "<text>"`, or `reef answer '#<issue>' "<text>"`: on an issues
    queue `reef-queue.py answered <#>` closes the question's issue (what the loop reads there; a row with two open
    questions needs the number), on a file queue the footnote on its row; then the question's line is cleared."""
    pos = [a for a in args if not a.startswith("--")]
    if len(pos) != 2 or not re.fullmatch(r"#?\d+", pos[0]):
        print('reef answer <row> "<text>" · reef answer \'#<issue>\' "<text>"', file=sys.stderr)
        return 2
    key, text = pos
    if not text.strip():
        print("reef answer: the answer is empty — nothing recorded", file=sys.stderr)
        return 2
    filed = questions(root)
    if key.startswith("#"):
        mine = [(r, i) for r, i, _, _ in filed if i == key[1:]]
        row, issue = (mine[0] if mine else ("-", key[1:]))
    else:
        row = key
        numbers = [i for r, i, _, _ in filed if r == row and i]
        if len(numbers) > 1:
            print(f"reef answer: row {row} has {len(numbers)} open questions — name one: " + " · ".join(f"reef answer '#{n}' \"<text>\"" for n in numbers), file=sys.stderr)
            return 2
        issue = numbers[0] if numbers else ""
    a = answer_command(root, row, issue, text)
    if a is None:
        print(f"reef answer: row {row}'s question lives in a reef-question issue this line does not name — answer it there: gh issue list --label reef-question", file=sys.stderr)
        return 2
    argv, shown = a
    argv = [PY, script("reef-queue.py") or "scripts/reef-queue.py"] + argv[2:]
    print(f"reef answer: {shown}", flush=True)
    if "--dry-run" in args:
        return 0
    rc = subprocess.run(argv, cwd=root).returncode
    if rc != 0:
        return rc
    gone = drop_question(root, issue=issue) if issue else drop_question(root, row=row)   # on issues `answered` already did; a file queue clears here
    if gone:
        print(f"reef answer: row {row}'s question cleared from .reef/questions.md")
    return 0


def cmd_update(root, args):
    plugin = args[args.index("--plugin") + 1] if "--plugin" in args and args.index("--plugin") + 1 < len(args) else plugin_dir()
    if not plugin:
        print("reef update: no plugin clone found — pass --plugin <dir> (the folder /plugin marketplace points at)", file=sys.stderr)
        return 1
    print(f"reef update: the plugin clone is {plugin}", flush=True)
    steps = [["git", "-C", plugin, "pull", "--ff-only"],
             [PY, os.path.join(plugin, "scripts", "reef-update.py"), "--repo", root, "--commit"]]
    for cmd in steps:
        print("reef update: " + " ".join(cmd[-3:]), flush=True)
        if subprocess.run(cmd, cwd=root).returncode != 0:
            print("reef update: stopped at that step", file=sys.stderr)
            return 1
    r = subprocess.run(["git", "push"], cwd=root)   # the update's commit goes to the forge (2026-10-28: it sat local and the owner found it)
    print("reef update: pushed" if r.returncode == 0 else "reef update: the push failed — push yourself: git push", flush=True)
    setup = script("reef-setup.py")
    if setup and subprocess.run([PY, setup, "state", "--repo", root], capture_output=True).returncode == 3:
        print("reef update: the setup digest changed — proving it (a scratch worktree, the setup, the full gate once)", flush=True)
        if subprocess.run([PY, setup, "prove", "--repo", root], cwd=root).returncode != 0:
            return 1
    print("reef update: done — in Claude Code: /plugin marketplace update <marketplace>, then /reload-plugins; `reef doctor` confirms")
    return 0


def cmd_factory(root, args):
    wf = os.path.join(root, ".github", "workflows", "reef-factory.yml")
    if not os.path.isfile(wf):
        print("factory: .github/workflows/reef-factory.yml is not accepted yet — python3 scripts/reef-init.py shows it OFFERED; accept with\n"
              "  python3 <plugin>/scripts/reef-init.py --root . --accept .github/workflows/reef-factory.yml   then commit it on the base")
        return 1
    if args and args[0].isdigit():
        r = subprocess.run([PY, script("reef-queue.py") or os.path.join(HERE, "reef-queue.py"), "row-issue", args[0], "--repo", root], capture_output=True, text=True)
        issue = (r.stdout.strip().splitlines() or [""])[-1]
        if r.returncode != 0 or not issue.isdigit():
            print(f"factory: row {args[0]} has no issue — {(r.stderr or r.stdout).strip()[:160]}", file=sys.stderr)
            return 1
        print(f"factory: labelling issue #{issue} reef-ready (the labeler must be an admin)", flush=True)
        return subprocess.run(["gh", "issue", "edit", issue, "--add-label", "reef-ready"], cwd=root).returncode
    return subprocess.run(["gh", "run", "list", "--workflow", "reef-factory.yml", "--limit", "5"], cwd=root).returncode


def menu(root):
    print(BANNER.rstrip("\n"))
    try:
        with open(os.path.join(root, ".reef", "version"), encoding="utf-8") as f:
            ver = f.read().strip()
    except OSError:
        ver = "?"
    print(f"  Reef {ver} · {root} · {status_line(root)}\n")
    for verb, what, _ in VERBS:
        print(f"  {verb:<9}{what}")
    print("\n  reef <verb> [args] · reef --all lists every script and its purpose · reef <verb> --repo <dir> for another project"
          "\n  on a terminal `reef` alone opens the screen: the inbox of what waits on you, one key per command; `reef --menu` is this list")
    return 0


def main(argv):
    args = list(argv)
    repo = "."
    if "--repo" in args and args.index("--repo") + 1 < len(args):
        repo = args[args.index("--repo") + 1]
        del args[args.index("--repo"):args.index("--repo") + 2]
    root = main_checkout(os.path.abspath(repo))   # the abspath fallback the entry point always had
    if not args:
        if sys.stdout.isatty() and sys.stdin.isatty() and not os.environ.get("REEF_NO_SCREEN"):
            return cmd_screen(root, [])   # a terminal: the screen; `reef --menu`, or no terminal, the menu
        return menu(root)
    if args == ["--menu"]:
        return menu(root)
    if args[0] == "--all":
        for name in sorted(os.listdir(HERE)):
            if name.startswith("reef-"):   # commands; reef_common.py is a module
                print(f"  {name:<28}{purpose(os.path.join(HERE, name))}")
        return 0
    verb, rest = args[0], args[1:]
    for name, _, do in VERBS:
        if name == verb:
            return do(root, rest)
    print(f"reef: unknown verb {verb!r} — run `reef` for the list", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
