#!/usr/bin/env python3
# CLASS: code
"""reef — the owner's one entry point (2026-10-28: "the person opens the terminal, writes reef, sees a logo and the options,
each with a short description"). `reef` alone on a terminal: THE SCREEN (consolidation step 5, 2026-10-30) — the status line,
the inbox of every wait Reef recorded, each with the exact command the row machine names so one key runs it, the runner's last
steps, the doctor's warnings; off a terminal, the menu. `reef <verb> [args]` runs the sibling script that verb names, in the
project this runs in (`--repo DIR` for another). `reef --all`: every script here with its purpose line — the internal ones,
which the skills and agents run, not a person. The screen knows nothing the scripts do not: every key runs a command you could type.
Verbs: screen [--once] · approve <row> · answer <row> "<text>" · status · doctor · run [n] · night · watch · stop · setup · update · factory [row] · cost
"""
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import queue
import threading
import time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))   # the shared helpers live beside this script
sys.dont_write_bytecode = True   # and no scripts/__pycache__ lands in a project's tree (reef-update, a row worktree read it as changes)
from reef_common import main_checkout, approval_questions, questions, answer_command, drop_question, process_alive, plain  # noqa: E402

HERE = os.path.dirname(os.path.abspath(__file__))
PY = sys.executable
BANNER = r"""
  ____  ____  ____  ____
 |  _ \| ___|| ___|| ___|   Reef — run a software project as a graph of gated work
 | |_) |  _| |  _| |  _|
 |_| \_\____||____||_|
"""
VERBS = [
    ("screen",  "the live screen: the inbox of what waits on you, its keys on its last line (`screen --once` prints it and exits)",
     lambda root, a: cmd_screen(root, a)),
    ("approve", "`approve <row>`: the row's plan approval at its current digest — the line you would type, typed for you",
     lambda root, a: cmd_approve(root, a)),
    ("answer",  "`answer <row> \"<text>\"`: your answer to a filed question — `answered <#>` on an issues queue, the footnote on a file",
     lambda root, a: cmd_answer(root, a)),
    ("status",  "where things stand: the runner, the night, the last session, the loop's wait",
     lambda root, a: run_script("reef-run.py", ["status", "--repo", root], root)),
    ("doctor",  "what is wrong and the one command that fixes each thing (plugin, probe, hold, setup, scripts)",
     lambda root, a: run_script("reef-doctor.py", ["--repo", root, *a], root)),
    ("run",     "the loop in fresh headless sessions until it waits on you — `run 5` caps the sessions",
     lambda root, a: run_script("reef-run.py", ["--repo", root, "--detach", *(["--max-iterations", a[0], *a[1:]] if a and a[0].isdigit() else a)], root)),
    ("night",   "tonight's contract: install it, print the approval question; `night start` runs it detached",
     lambda root, a: run_script("reef-run.py", ["--repo", root, "--night", "--detach"] if a[:1] == ["start"] else ["contract", "--repo", root, *a], root)),
    ("autopilot", "the runner on its own under reef/proxy.md, approved once: Mahmoud decides inside it, the loop never waits on you; `autopilot off` stops it",
     lambda root, a: run_script("reef-run.py", ["stop", "--repo", root] if a[:1] == ["off"] else
                                ["--repo", root, "--autopilot", "--detach", *(["--max-iterations", a[0], *a[1:]] if a and a[0].isdigit() else a)], root)),
    ("watch",   "the runner's live steps, one line each, and its last word when it ends (Ctrl-C leaves, stops nothing)",
     lambda root, a: run_script("reef-run.py", ["watch", "--repo", root], root)),
    ("stop",    "the runner ends after its current session, never mid-merge; a session a dead runner left behind is ended now",
     lambda root, a: run_script("reef-run.py", ["stop", "--repo", root], root)),
    ("setup",   "the worktree setup, proven once per change: `setup` says the state, `setup prove` proves it",
     lambda root, a: run_script("reef-setup.py", [*(a or ["state"]), "--repo", root], root)),
    ("update",  "a new Reef: pull the plugin, the project's copies (one commit, pushed), the setup re-proved, the marketplace refreshed",
     lambda root, a: cmd_update(root, a)),
    ("factory", "the row on GitHub Actions: `factory` shows the last runs, `factory <row>` labels its issue reef-ready",
     lambda root, a: cmd_factory(root, a)),
    ("cost",    "the pipeline per merged row against the last batch (`cost --since 2026-10-01`)",
     lambda root, a: run_script("reef-cost.py", ["rows", "--repo", root, *a], root)),
]


def plugin_dir(root=None):
    """The plugin clone: CLAUDE_PLUGIN_ROOT, else the marketplace entry whose installLocation (or source.path) holds Reef's plugin.json."""
    cands = [os.environ.get("CLAUDE_PLUGIN_ROOT")]
    try:
        with open(os.path.expanduser("~/.claude/plugins/known_marketplaces.json"), encoding="utf-8") as f:
            for v in json.load(f).values():
                if isinstance(v, dict):
                    cands.append(v.get("installLocation"))
                    src = v.get("source")
                    if isinstance(src, dict):
                        cands.append(src.get("path"))
    except (OSError, ValueError):
        pass
    for c in cands:
        if not c:
            continue
        try:
            with open(os.path.join(c, ".claude-plugin", "plugin.json"), encoding="utf-8") as f:
                name = json.load(f).get("name")
        except (OSError, ValueError, TypeError):
            continue
        if name == "reef" and os.path.isfile(os.path.join(c, "scripts", "reef-update.py")):
            return c
    return None


def script(name):
    """A Reef script: the sibling copy in this folder, else the plugin's (reef-doctor.py and reef-update.py live only there)."""
    here = os.path.join(HERE, name)
    if os.path.isfile(here):
        return here
    plugin = plugin_dir()
    if plugin and os.path.isfile(os.path.join(plugin, "scripts", name)):
        return os.path.join(plugin, "scripts", name)
    return None


def run_script(name, args, cwd):
    path = script(name)
    if not path:
        print(f"reef: scripts/{name} is not here and no plugin clone was found — python3 <plugin>/scripts/reef-update.py --repo . --commit copies it", file=sys.stderr)
        return 1
    return subprocess.run([PY, path, *args], cwd=cwd).returncode


def purpose(path):
    """A script's first purpose line: the docstring's first sentence, or the first `# ` comment after the CLASS line."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read(4000)
    except OSError:
        return ""
    m = re.search(r'"""(.+?)(?:\n|""")', text, re.S)
    if m:
        return m.group(1).strip().split(". ")[0][:110]
    for line in text.splitlines():
        if line.startswith("# ") and "CLASS:" not in line and not line.startswith("#!/"):
            return line[2:].strip()[:110]
    return ""


def status_line(root):
    try:
        with open(os.path.join(root, ".reef", "run", "lock"), encoding="utf-8") as f:
            os.kill(int(f.read().strip() or 0), 0)
        runner = "the runner is running"
    except (OSError, ValueError):
        runner = "no runner is running"
    try:
        with open(os.path.join(root, ".reef", "loop.json"), encoding="utf-8") as f:
            st = json.load(f)
        wait = str(st.get("wait") or "")
        loop = f"the loop waits: {wait[:80]}" if wait else "the loop is active" if st.get("active") else "the loop is idle"
    except (OSError, ValueError):
        loop = "the loop is idle"
    return f"{runner} · {loop}"




# ---------------------------------------------------------------- the screen (consolidation step 5)

SHELL_SYNTAX = re.compile(r"[();|&<>$`]")


def sibling_module(name, modname):
    """A sibling script as a module (reef-run.py: the runner's own view of its lock and session), or None."""
    path = script(name)
    if not path:
        return None
    import importlib.machinery, importlib.util
    loader = importlib.machinery.SourceFileLoader(modname, path)
    spec = importlib.util.spec_from_loader(modname, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def row_state(root, row):
    """The row machine's view (reef-row.py state --json), or {} — kept as one seam for the tests."""
    path = script("reef-row.py")
    if not path or not str(row).isdigit():
        return {}
    try:
        r = subprocess.run([PY, path, "state", str(row), "--json", "--repo", root], capture_output=True, text=True, timeout=60)
        return json.loads(r.stdout) if r.returncode == 0 else {}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}


def handoff_awaiting(root):
    """The tick's `awaiting:` line as HANDOFF.md renders it — since #210 it carries each approval's exact question."""
    try:
        with open(os.path.join(root, "HANDOFF.md"), encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return ""
    m = re.search(r"^## The tick\n```\n(.*?)\n```", text, re.S | re.M)
    m2 = re.search(r"^awaiting: (.*)$", m.group(1) if m else "", re.M)
    return m2.group(1) if m2 else ""


def runner_view(root):
    """(runner pid or 0, session pid or 0, since) through the runner's own functions — never a second reading of its files."""
    mod = sibling_module("reef-run.py", "reef_run_for_screen")
    if mod is None:
        return 0, 0, ""
    try:
        spid, since = mod.session_record(root)
        return mod.runner_pid(root), spid, since
    except Exception:
        return 0, 0, ""


UPDATE_SECONDS = 900   # the screen asks the forge whether Reef moved — the doctor with --fetch, minutes apart, in its thread (hands-off step 6)
UPDATE_SHOWN = "python3 scripts/reef update"   # the doctor's new-Reef fixes print this one line: the inbox keeps one item per command


def doctor_lines(root, fetch=False):
    """The doctor's lines; `fetch` asks the forge whether the plugin clone is behind (the live screen does, once its last reading is
    UPDATE_SECONDS old; `reef screen --once --fetch` too). None when the doctor did not answer (the screen shows that as a failed
    reading, never as "nothing wrong"). 2026-10-31 (step 6): after a merge in Reef a person told the owner to run `reef update`."""
    path = script("reef-doctor.py")
    if not path:
        return []
    try:
        return subprocess.run([PY, path, "--repo", root] + (["--fetch"] if fetch else []), capture_output=True, text=True, timeout=180).stdout.splitlines()
    except (OSError, subprocess.TimeoutExpired):
        return None


def new_reef_waits(items):
    """The one predicate behind the headers' `a new Reef waits (u)`: the inbox holds the update item."""
    return any(it.get("kind") == "update" for it in (items or []))


def item(kind, text, argv, shown=None, row=None, recommended="", issue=""):
    """An inbox item: what it is, the argv that runs it (never a shell), and the line the owner would type."""
    return {"kind": kind, "text": text, "argv": argv, "cmd": shown or shlex.join(argv), "row": row, "recommended": recommended, "issue": issue}


def approve_item(q, text=None, row=None):
    return item("approve", text or q, [PY, script("reef-approval.py") or "scripts/reef-approval.py", "--owner", q],
                shown=f'python3 scripts/reef-approval.py --owner "{q}"', row=row)


def inbox(root, doctor=None, runner=None):
    """Every wait Reef has recorded, as items — each with the argv that answers it, never twice. The sources are the loop's
    own files and scripts; agent-written text becomes a command only through a regex that admits nothing a shell reads."""
    items = []

    def add(it):
        if it["argv"] and it["cmd"] not in [i["cmd"] for i in items]:
            items.append(it)

    st = read_json(os.path.join(root, ".reef", "loop.json"))
    wait = str(st.get("wait") or "")
    for q in approval_questions(wait + "\n" + handoff_awaiting(root)):
        add(approve_item(q))
    for r in dict.fromkeys(re.findall(r"\brow (\d+)", wait)):
        qs = approval_questions(str(row_state(root, r).get("detail") or ""))
        if qs:
            add(approve_item(qs[0], text=f"row {r}: {qs[0]}", row=r))
    for r, issue, q, rec in questions(root):
        a = answer_command(root, r, issue, rec or "<your answer>")   # answered <#> on issues, the footnote on a file queue, the recommendation filled in
        text = f"row {r}" + (f" (#{issue})" if issue else "") + f": {q}" + (f" (recommended: {rec})" if rec else "")
        if a:
            argv, shown = a
            add(item("answer", text, [PY, script("reef-queue.py") or "scripts/reef-queue.py"] + argv[2:], shown=shown, row=r, recommended=rec, issue=issue))
        else:   # an issues queue, a line from before 0.7.4, and gh could not name the issue: the look that finds it (never silence)
            add(item("look", text + " — its reef-question issue is not named here", ["gh", "issue", "list", "--label", "reef-question", "--search", f"row {r}"],
                     shown=f'gh issue list --label reef-question --search "row {r}"', row=r))
    # the runner's own waits (2026-10-30, the owner's first screen: the loop active with no runner, task 403 left in flight — neither was an item)
    pid_, spid_, _ = runner if runner is not None else runner_view(root)
    if not pid_ and spid_ <= 0:
        mod = sibling_module("reef-run.py", "reef_run_for_screen")   # the runner's own reading of what is in flight — one source; the item leaves with the marker
        try:
            flying = list(mod.in_flight(root)) if mod is not None else []
        except Exception:
            flying = []
        for t in flying:
            if re.fullmatch(r"R?\d+", str(t)):
                add(item("release", f"task {t} is marked in flight by the last run — when its work is not running, release it (the next run dispatches it again)",
                         [PY, script("reef-run.py") or "scripts/reef-run.py", "release", str(t), "--repo", root], shown=f"python3 scripts/reef-run.py release {t}"))
        if st.get("active") and not st.get("wait") and not st.get("parked") and not st.get("stop"):
            add(item("run", "the loop is active and no runner is running — start it", [PY, os.path.abspath(__file__), "run", "--repo", root], shown="python3 scripts/reef run"))
    if st.get("parked"):
        add(item("unpark", f"the loop parked: {str(st['parked'])[:100]}", [PY, script("reef-loop.py") or "scripts/reef-loop.py", "start", "--repo", root],
                 shown="python3 scripts/reef-loop.py start"))
    pid, spid, since = runner if runner is not None else runner_view(root)
    if not pid and spid > 0:
        add(item("stop", f"runner gone, session {spid} still running since {since}", [PY, script("reef-run.py") or "scripts/reef-run.py", "stop", "--repo", root],
                 shown="python3 scripts/reef-run.py stop"))
    for line in (doctor if doctor is not None else []):
        if not line.startswith("WARN") or " — " not in line:
            continue
        what, fix = line[4:].strip().rsplit(" — ", 1)   # the fix is the LAST part: a bare command, or not an item at all
        if not fix.startswith(COMMAND_WORDS) or SHELL_SYNTAX.search(fix) or re.search(r"<[^>]+>", fix):
            continue
        argv = shlex.split(fix)
        argv[0] = PY if argv[0] == "python3" else argv[0]
        add(item("update" if fix == UPDATE_SHOWN else "fix", what, argv, shown=fix))   # a new Reef is one item, whatever the doctor's three lines say
    return items


COMMAND_WORDS = ("python3 ", "git ", "claude ", "sh ", "gh ")


BLOCK = ("██████  ███████ ███████ ███████", "██   ██ ██      ██      ██     ", "██████  █████   █████   █████  ",
         "██   ██ ██      ██      ██     ", "██   ██ ███████ ███████ ██     ")
VERB_KEYS = {"r": "run", "n": "night", "s": "stop", "d": "doctor", "c": "cost", "u": "update"}
KEYS = "keys: q quit · Tab views · ↑↓ 1-9 select · Enter runs · w log · a autopilot · ? help · " + " · ".join(f"{k} {v}" for k, v in VERB_KEYS.items())   # quit first: never cut at the edge; g refreshes too
VIEWS = ("work", "inbox", "plan", "log")   # Tab's cycle (2026-10-31, the fourth screen)
MARK_ORDER = {"○": 0, "▶": 1, "⧖": 2, "⏸": 3, "…": 4, "✓": 5}   # what can start first, then what runs, then yours, then blocked, then unknown yet, then done
MARK_STYLE = {"✓": "done", "▶": "build", "○": "ready", "⧖": "wait", "⏸": "blocked", "…": ""}   # …: the row machine has not answered yet
INBOX_SECONDS = 10   # the inbox reading asks the row machine about the rows a wait names: seconds apart, not every tick (2026-10-31 12:30, the owner: "heavy")
BOARD_SECONDS = 120   # the work board costs a subprocess per row (the row machine, which may ask the forge): minutes apart; any command reads it again
BOARD = {"done": 0, "total": 0, "rows": {}}   # the rows read so far and each finished row as it lands, for the board drawn while the row machine answers
BOARD_LOCK = threading.Lock()
QUIT = threading.Event()   # set when the screen leaves: the row readers stop taking rows, so q returns the prompt at once (the review)


def read_rows(ids, fn, workers=4):
    """{id: fn(id)} for the ids, `workers` daemon threads over one queue — a reading of the row machine is a subprocess each, so four
    at a time; when QUIT is set the readers take no further row (the one in hand finishes), and daemon threads never hold the exit."""
    todo, out = queue.Queue(), {}
    for rid in ids:
        todo.put(rid)

    def work():
        while not QUIT.is_set():
            try:
                rid = todo.get_nowait()
            except queue.Empty:
                return
            got = fn(rid)
            out[rid] = got
            with BOARD_LOCK:   # published as it lands: the screen fills the row in while the others are still being read
                BOARD["done"] += 1
                BOARD["rows"][rid] = got
    threads = [threading.Thread(target=work, daemon=True, name="reef-row") for _ in range(max(1, min(workers, len(ids))))]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    return out


def screen_model(root, doctor=None, runner=None):
    """Everything the screen shows, as facts: the header's lines, the inbox items, the runner's steps, the doctor's warnings."""
    st = read_json(os.path.join(root, ".reef", "loop.json"))
    runner = runner if runner is not None else runner_view(root)
    pid, spid, since = runner
    runner_s = runner_line(root, pid, spid, since)
    loop = ("waits on you" if st.get("wait") else "parked" if st.get("parked") else "active" if st.get("active") else "idle")
    try:
        with open(os.path.join(root, ".reef", "version"), encoding="utf-8") as f:
            ver = f.read().strip()
    except OSError:
        ver = "?"
    base = str((read_json(os.path.join(root, ".reef", "config.json")).get("branches") or {}).get("base") or "main")
    try:
        flying = sorted(os.listdir(os.path.join(root, ".reef", "inflight")))
    except OSError:
        flying = []
    items = inbox(root, doctor, runner)
    facts = [f"{os.path.basename(root)} · Reef {ver}{' · a new Reef waits (u)' if new_reef_waits(items) else ''} · {time.strftime('%H:%M:%S')}", f"loop    {loop}", f"runner  {runner_s}",
             f"base    {base}" + (f" · {len(flying)} in flight ({', '.join(flying)[:40]})" if flying else ""), ""]
    try:
        with open(os.path.join(root, ".reef", "run", "live.log"), encoding="utf-8") as f:
            steps = [plain(l) for l in f.read().splitlines()]   # agent-written lines as the owner's terminal may show them (the security review)
    except OSError:
        steps = []
    warns = [l for l in (doctor or []) if l.startswith(("WARN", "FAIL"))]
    log = list(steps)   # the whole live log, for the log view (w)
    if not pid and spid <= 0 and steps:   # no run of ours is alive: a tail of the log and that it ended, not the screen (2026-10-30)
        steps = steps[-5:] + ["(the run ended · w for the whole log)"]
    return {"facts": facts, "items": items, "steps": steps, "log": log, "warns": warns, "doctor": doctor is not None}


_TREE = {"at": 0.0, "tree": []}


def process_tree():
    """Every process as (pid, ppid, elapsed, command) from one `ps` — macOS and Linux share these columns; cached 10 s (the tick)."""
    if time.time() - _TREE["at"] < 10:
        return _TREE["tree"]
    _TREE["at"] = time.time()
    try:
        r = subprocess.run(["ps", "-axo", "pid=,ppid=,etime=,command="], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return []
    out = []
    for line in r.stdout.splitlines():
        parts = line.split(None, 3)
        if len(parts) == 4 and parts[0].isdigit() and parts[1].isdigit():
            out.append((int(parts[0]), int(parts[1]), parts[2], parts[3]))
    _TREE["tree"] = out
    return out


def session_doing(spid, tree=None):
    """What the runner's session is doing now: the longest-running command under its pid — a Reef script with its first argument
    where one is in the chain (`reef-converge legacy-queue-to-issues`), else the deepest command — and how long it has run; "" when
    the session has no child (it is thinking, or waiting on the model). The owner's question (2026-10-31): a silent log for twenty
    minutes was a converge run, not a hang; the screen now says so."""
    if not spid or spid <= 0:
        return ""
    tree = process_tree() if tree is None else tree
    kids = {}
    for pid, ppid, et, cmd in tree:
        kids.setdefault(ppid, []).append((pid, et, cmd))
    cur, chain = spid, []
    while cur in kids:   # the oldest child at each level: the work, not a helper the host just spawned
        pid, et, cmd = max(kids[cur], key=lambda k: (len(k[1].strip()), k[1].strip()))
        chain.append((et.strip(), cmd)); cur = pid
    if not chain:
        return ""
    for et, cmd in chain:
        m = re.search(r"(reef-[a-z-]+(?:\.py|\.sh)?)(?:\s+(?!--)(\S+))?", cmd)
        if m:
            return f"running: {m.group(1)} {m.group(2) or ''}".strip()[:60] + f" ({et})"
    et, cmd = chain[-1]
    words = [w for w in cmd.split() if not w.startswith("-")]
    name = next((os.path.basename(w) for w in words if os.path.basename(w) not in ("zsh", "bash", "sh", "Python", "python3", "node", "npm", "exec", "source")), "a command")
    return f"running: {name}"[:60] + f" ({et})"


def jobs_running(root):
    """[(name, minutes, command)] of the runner's jobs still running — through the runner's own `jobs`/`job_alive` (one record contract)."""
    mod = sibling_module("reef-run.py", "reef_run_for_screen")
    if mod is None:
        return []
    try:
        return [(plain(j["name"]), int((time.time() - float(j.get("started_ts") or time.time())) // 60), plain(" ".join(j.get("cmd") or []))[:40])
                for j in mod.jobs(root) if mod.job_alive(j)]
    except Exception:
        return []


def last_word_age(root):
    """Minutes since the runner's live log last moved, or None without a log."""
    try:
        return int((time.time() - os.path.getmtime(os.path.join(root, ".reef", "run", "live.log"))) // 60)
    except OSError:
        return None


def runner_line(root, pid, spid, since, tree=None):
    """One line on the runner: alive or not, its session, how long the log has been silent and what the session runs now —
    so the owner can tell working from waiting from dead without a terminal."""
    if not pid and spid <= 0:
        return "no runner is running"
    if not pid:
        return f"gone · session {spid} still running since {since} — s ends it"
    since = str(since or "")
    since = since[11:16] if len(since) >= 16 and since[10] == "T" else since   # the runner's record is ISO in UTC-less local form; the screen shows the clock
    line = f"running · pid {pid}" + (f" · session {spid} since {since}" if spid > 0 else "")
    age = last_word_age(root)
    if age is not None and age >= 2:
        line += f" · quiet {age} min"
    running = jobs_running(root)
    if running:   # the runner's own record first; the process table only when it has none
        return line + " · job " + ", ".join(f"{n} ({m} min)" for n, m, _ in running)
    doing = session_doing(spid, tree) if spid > 0 else ""
    return line + (f" · {doing}" if doing else (" · thinking" if spid > 0 and age is not None and age >= 2 else ""))


def queue_rows(root, cfg):
    """(current batch, the queue's rows as dicts, archived ids) through reef-queue.py's own parser — the file, or on an issues queue
    the synced snapshot `.reef/queue.json` (no network on the screen)."""
    q = sibling_module("reef-queue.py", "reef_queue_for_screen")
    if q is None:
        return "", [], set()
    if (cfg.get("queue") or {}).get("home") == "issues":
        snap = read_json(os.path.join(root, ".reef", "queue.json"))
        snap = snap if isinstance(snap, dict) else {}
        ok = lambda r: isinstance(r, dict) and re.fullmatch(r"[0-9]+", str(r.get("Id", "")))   # digits: the one value that reaches an argv (the review)
        rows = sorted((dict(r) for r in (snap.get("rows") or []) if ok(r)), key=lambda r: int(r["Id"]))
        return str(snap.get("current_batch") or ""), rows, {str(r.get("Id")) for r in (snap.get("closed") or []) if ok(r)}
    rel = (cfg.get("paths") or {}).get("queue", "docs/queue.md")
    try:
        with open(os.path.join(root, rel), encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return "", [], set()
    try:
        with open(os.path.join(root, os.path.dirname(rel), "queue-archive.md"), encoding="utf-8", errors="replace") as f:
            archived = {r["Id"] for r in q.parse_table(f.read())}
    except OSError:
        archived = set()
    return str(q.current_batch(text) or ""), [r for r in q.parse_table(text) if re.fullmatch(r"[0-9]+", str(r.get("Id", "")))], archived


def today_keys():
    """Today's date, local and UTC — the runner stamps in UTC, the owner reads local."""
    return {time.strftime("%Y-%m-%d"), time.strftime("%Y-%m-%d", time.gmtime())}


def cost_today(root):
    """Today's spend from the runner's own ledger (.reef/run/run.log: one JSON record per session, `at` in UTC)."""
    days, total = today_keys(), 0.0
    try:
        with open(os.path.join(root, ".reef", "run", "run.log"), encoding="utf-8", errors="replace") as f:
            for line in f:
                try:
                    rec = json.loads(line)
                    if isinstance(rec, dict) and str(rec.get("at", ""))[:10] in days:
                        total += float(rec.get("cost_usd") or 0)
                except (ValueError, TypeError):
                    continue
    except OSError:
        pass
    return round(total, 2)


def autopilot_view(root):
    """{"on", "pid", "since", "decided_today"} from the autopilot's marker and the proxy's decision log — read, never computed."""
    ap = read_json(os.path.join(root, ".reef", "night", "autopilot"))
    pid = int(ap.get("pid") or 0) if str(ap.get("pid") or "").isdigit() else 0
    since = str(ap.get("started") or "")
    since = since[11:16] if len(since) >= 16 and since[10] == "T" else since[:16]
    days, decided = today_keys(), 0
    try:   # his plan approvals: .reef/approvals/<slug>.json with by: "mahmoud (proxy)" and today's date
        for name in os.listdir(os.path.join(root, ".reef", "approvals")):
            if name.endswith(".json") and name not in ("day.json", "night.json"):
                rec = read_json(os.path.join(root, ".reef", "approvals", name))
                if "proxy" in str(rec.get("by") or "") and str(rec.get("approved_at", ""))[:10] in days:
                    decided += 1
    except OSError:
        pass
    try:
        with open(os.path.join(root, ".reef", "approvals", "day-decisions.jsonl"), encoding="utf-8", errors="replace") as f:
            for line in f:   # the writer's own shape (reef-approval.py): one JSON record per line
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if isinstance(rec, dict) and str(rec.get("at", ""))[:10] in days:
                    decided += 1
    except OSError:
        pass
    return {"on": bool(pid) and process_alive(pid), "pid": pid, "since": since, "decided_today": decided}


def contract_view(root):
    """The standing contract as the start panel shows it: its approved digest, the kinds Mahmoud decides, the Never line."""
    rec = read_json(os.path.join(root, ".reef", "approvals", "day.json"))
    digest = str(rec.get("digest16") or str(rec.get("digest") or "")[:16] or "")
    rr = sibling_module("reef-run.py", "reef_run_for_screen")
    try:
        decides = [plain(k) for k in rr.day_kinds(root)] if rr is not None else []   # the runner's own reading of Decides: (one vocabulary)
    except Exception:
        decides = []
    never = ""
    try:
        with open(os.path.join(root, "reef", "proxy.md"), encoding="utf-8", errors="replace") as f:
            m = re.search(r"^Never:\s*(.+)$", f.read(), re.M)
        never = plain(m.group(1)) if m else ""
    except OSError:
        pass
    return {"digest16": plain(digest)[:16], "decides": decides, "never": never, "approved": bool(digest)}


def row_entry(r, st, done_ids, asked, lane, tasks):
    """One board row from the queue's row `r` and the row machine's answer `st` — None while it is being read (the `…` mark; the
    screen fills the row in when the answer lands). done_ids/asked/lane/tasks are the batch's facts the caller holds."""
    rid = str(r["Id"])
    deps = [d for d in re.split(r"[,\s]+", plain(r.get("Depends", "") or "")) if d]
    waits = [d for d in deps if d not in done_ids]
    state, detail = (str(st.get("state") or ""), plain(st.get("detail") or "")) if st is not None else ("", "")
    if rid in done_ids or state == "closed":
        mark, state = "✓", "done"
    elif st is None:
        mark, state = "…", "reading"
    elif waits:
        mark = "⏸"
    elif state == "approval" or rid in asked or approval_questions(detail):
        mark = "⧖"
    elif state in ("build", "review", "merge", "close"):
        mark = "▶"
    else:
        mark = "○"
    pr = re.search(r"PR #\d+", detail)
    issue = plain(r.get("_issue") or r.get("Issue") or r.get("issue") or "")   # the snapshot's key is _issue (reef-queue.py sync)
    item = re.sub(r"[⁰¹²³⁴⁵⁶⁷⁸⁹]+", "", plain(r.get("Item", ""))).strip()
    tk = st.get("tasks") if st is not None and isinstance(st.get("tasks"), dict) else None   # the row machine counts in the feature's checkout; the main checkout's folder is the fallback
    return {"id": rid, "item": item, "mark": mark, "tasks": (int(tk.get("done") or 0), int(tk.get("total") or 0)) if tk else tasks.get(rid, (0, 0)), "depends": deps, "waits": waits,
            "lane": lane, "forge": " · ".join(x for x in ((f"#{issue}" if issue else ""), (pr.group(0) if pr else "")) if x),
            "state": state or "plan", "detail": detail, "next": plain(st.get("next") or "") if st is not None else "", "slug": str(st.get("slug") or "") if st is not None else ""}


def fill_in(wm, landed):
    """The provisional board's `…` rows swapped for the finished rows that have landed (BOARD["rows"]) — in place; True when one changed.
    The header's counts stay the provisional ones until the full board replaces it (one rule, not half of one)."""
    changed = False
    for i, row in enumerate(wm.get("rows") or []):
        if row["mark"] == "…" and landed.get(row["id"]) is not None:
            wm["rows"][i] = landed[row["id"]]
            changed = True
    return changed


def reanchor_rows(wm, wsel, chosen):
    """The board's selection follows its row by id when the rows change under it (a state landed, the full board replaced the
    provisional one, the order re-sorted) — as the inbox's selection follows its item."""
    if chosen is None:
        return wsel
    ids = [r["id"] for r in ordered(wm)]
    return ids.index(chosen) if chosen in ids else min(wsel, max(len(ids) - 1, 0))


def reading_line():
    return f"reading the rows … {min(BOARD['done'], BOARD['total'])}/{BOARD['total']}"


def work_model(root, runner=None, states=True):
    """The batch as the owner asked to see it before choosing (2026-10-31): every row of the current batch with a state mark
    (✓ done · ▶ building · ○ can start now · ⏸ waits on the open rows it depends on · ⧖ yours — a gate or a question), its
    tasks done/total, its lane (the module its Item names: rows of one module go one at a time, different modules run beside
    each other), its forge (issue, PR), plus the batch's progress and today's cost. States come from the row machine
    (`row_state`), the rows from the queue's own parser — the screen computes nothing the scripts do not. `states=False`: the
    queue alone, at once — the provisional board every open row `…` (`partial`), which the screen fills in as the full reading
    publishes each row's state (2026-10-31 12:30: the board stayed "reading the rows … 3/8" until the last row landed)."""
    cfg = read_json(os.path.join(root, ".reef", "config.json"))
    batch, rows, archived = queue_rows(root, cfg)
    q = sibling_module("reef-queue.py", "reef_queue_for_screen")
    try:
        tstates = q.task_states(root, cfg) if q is not None else {}   # the queue's own rule for done (reef-queue.py load): no third counting here
    except Exception:
        tstates = {}
    tasks = {rid: (sum(1 for x in st if x == "done"), len(st)) for rid, st in tstates.items()}
    done_ids = set(archived) | {rid for rid, (d, n) in tasks.items() if n and d == n}
    current = [r for r in rows if not batch or str(r.get("Batch", "")).strip() == batch]
    asked = {rr for rr, _, _, _ in questions(root)}
    rows_by_id = {str(r["Id"]): r for r in current}
    lane_of = lambda r: q.module_of(re.sub(r"[⁰¹²³⁴⁵⁶⁷⁸⁹]+", "", plain(r.get("Item", ""))).strip()) if q is not None else "general"

    def finished(rid):   # one finished board row, from the row machine's answer (done rows need none) — what the reader threads publish
        r = rows_by_id[rid]
        return row_entry(r, row_state(root, rid) if rid not in done_ids else {}, done_ids, asked, lane_of(r), tasks)
    if states:
        with BOARD_LOCK:
            BOARD["done"], BOARD["total"], BOARD["rows"] = 0, sum(1 for r in current if str(r["Id"]) not in done_ids), {}
        got = read_rows(list(rows_by_id), finished)
        out = [got.get(rid) or finished(rid) for rid in rows_by_id]
    else:   # the queue alone: every open row `…`
        out = [row_entry(r, None if rid not in done_ids else {}, done_ids, asked, lane_of(r), tasks) for rid, r in rows_by_id.items()]
    pid, spid, since = runner if runner is not None else runner_view(root)
    ap, cost = autopilot_view(root), cost_today(root)
    dt, nt = sum(t["tasks"][0] for t in out), sum(t["tasks"][1] for t in out)
    dr = sum(1 for t in out if t["mark"] == "✓")
    try:
        with open(os.path.join(root, ".reef", "version"), encoding="utf-8") as f:
            ver = f.read().strip()
    except OSError:
        ver = "?"
    facts = [f"{os.path.basename(root)} · Reef {ver} · {time.strftime('%H:%M:%S')}",
             (f"batch {batch} · " if batch else "no current batch · ") + f"{dr}/{len(out)} rows · {dt}/{nt} tasks · ${cost:.2f} today",
             "runner  " + runner_line(root, pid, spid, since),
             "autopilot  " + (f"on · pid {ap['pid']} · since {ap['since']} · {ap['decided_today']} decided by Mahmoud today" if ap["on"] else "off · a starts it"), ""]
    return {"batch": batch, "rows": out, "progress": {"rows": (dr, len(out)), "tasks": (dt, nt)}, "cost_today": cost, "facts": facts,
            "autopilot": ap, "order": "queue", "cap": int(((cfg.get("loop") or {}).get("rows_in_flight", 2)) or 0), "at": time.time(), "partial": not states}


def ordered(wm):
    """The rows in the chosen order: the queue's, or (o) what can start first — ready, building, yours, blocked, done."""
    rows = list(wm.get("rows") or [])
    return sorted(rows, key=lambda r: MARK_ORDER.get(r["mark"], 9)) if wm.get("order") == "start" else rows


def row_what(r):
    """One phrase per row: why it waits, that it can start, that it is yours, what it is doing."""
    if r["mark"] == "✓":
        return "done"
    if r["mark"] == "⏸":
        return "waits: row" + ("s " if len(r["waits"]) > 1 else " ") + ", ".join(r["waits"])
    if r["mark"] == "⧖":
        return "yours: " + ("plan approval" if r["state"] == "approval" else "a question")
    if r["mark"] == "▶":
        return {"build": "building", "review": "in review", "merge": "merging", "close": "closing"}.get(r["state"], "running")
    if r["mark"] == "…":
        return "reading …"
    return "can start now"


LOG_FAIL = re.compile(r"\b(FAIL(?:ED)?|RED|denied|error|rc=[1-9]\d*|exit(?:ed)? [1-9]\d*)\b")   # in a verdict (uppercase by convention)
LOG_RUNNER_FAIL = re.compile(r"\b(rc=[1-9]\d*|died|killed)\b")   # the runner's own lines: a job's end
LOG_PASS = re.compile(r"\b(GREEN|PASS(?:ED)?|DONE|ok|completed|merged|Converged|closed)\b")
LOG_WAIT = re.compile(r"\b(WAIT|wait)\b")
BOARD_LOG_LINES = 8   # the board carries the runner's last lines under the table (the owner, 2026-10-31: a live log box, w for the whole)


def log_style(line):
    """A live-log line's style — read from its VERDICT, never from prose (a task titled "fix the error path" is not a failure): → cyan an
    agent or a job started; ← its return — red on a failure word in the verdict, green on a pass word, plain otherwise ("returned" is
    no verdict); the runner's own job lines red when a job died, was killed or ended rc≠0; yellow a wait."""
    if "←" in line:
        after = line.split("←", 1)[1]
        verdict = after.split(": ", 1)[1] if ": " in after else after
        if LOG_FAIL.search(verdict) or LOG_RUNNER_FAIL.search(verdict):
            return "blocked"
        return "done" if LOG_PASS.search(verdict) else ""
    if "→" in line:
        return "build"
    if LOG_RUNNER_FAIL.search(line):
        return "blocked"
    if LOG_WAIT.search(line):
        return "wait"
    return ""


def log_find(log, query, before):
    """The index of the newest line before `before` that contains `query` (case-insensitive), or None — `/` on the page, `n` for the next older."""
    q = query.lower()
    for i in range(min(before, len(log)) - 1, -1, -1):
        if q in log[i].lower():
            return i
    return None


def log_nav(act, log, body_h, offset, found, found_at):
    """The log page's navigation, pure: page_up/page_down a page, top/bottom the ends, search/next the newest hit of `found` before
    `found_at` (next: the next older; none older wraps to the newest; no hit at all: found_at None, the header says so). Returns
    (offset, found_at); the hit becomes the page's last line (or sits on the page when the log is shorter than the page)."""
    most = max(0, len(log) - body_h)
    if act == "page_up":
        return min(most, offset + body_h), found_at
    if act == "page_down":
        return max(0, offset - body_h), found_at
    if act == "top":
        return most, found_at
    if act == "bottom":
        return 0, found_at
    if act in ("search", "next") and found:
        before = len(log) if act == "search" or found_at is None else found_at
        hit = log_find(log, found, before)
        if hit is None and before < len(log):
            hit = log_find(log, found, len(log))   # none older: the newest again
        if hit is None:
            return offset, None
        return min(most, max(0, len(log) - 1 - hit)), hit
    return offset, found_at


def tabs_line(view, n_items, w, age=None):
    cells = [("WORK", "work"), (f"INBOX {n_items}" if n_items else "INBOX", "inbox"), ("PLAN", "plan"), ("LOG", "log")]
    row = "  ".join(f"[{t}]" if v == view else f" {t} " for t, v in cells) + "    Tab switches · ? keys"
    if age is not None and age >= 5:
        row += f" · board {int(age)} s old (g reads it now)"
    return row[:w]


def render_work(wm, items, width=120, height=None, selected=None, panel=None, note="", log=None):
    """WORK: the banner with the batch's facts, the tabs, the rows as a table, the selected row's details boxed under it, the
    runner's last lines (`log`, BOARD_LOG_LINES of them, styled by log_style — shed first on a short terminal), the inbox's count,
    the keys last. Returns (lines, styles {line index: style name}, the selected line's index). Styles name the row's state
    (done, build, ready, wait, blocked), the banner, the selection — the loop maps them to attributes once."""
    w = max(60, int(width))
    rows = ordered(wm) if wm else []
    n = len(rows)
    sel = None if selected is None or not n else min(max(int(selected), 0), n - 1)
    facts = list((wm or {}).get("facts") or ["", f"{reading_line()} (the row machine, four at a time)" if BOARD["total"] else "reading the queue …",
                                             note or "the keys work meanwhile · q quits", "", ""])   # `note`: a reading that failed, while no board is up
    if new_reef_waits(items) and facts[0] and "a new Reef" not in facts[0]:
        facts[0] += " · a new Reef waits (u)"   # the board is the first view: said here as on the inbox (hands-off step 6)
    if wm and wm.get("partial") and len(facts) > 1:
        facts[1] = f"{facts[1]} · {reading_line()}"
    head = [(row + "   " + fact)[:w] for row, fact in zip(BLOCK, facts)] + ["─" * w, tabs_line("work", len(items or []), w, (time.time() - wm["at"]) if wm and wm.get("at") else None)]
    styles = {i: "banner" for i in range(len(BLOCK))}
    styles[len(head) - 1] = "tabs"
    col = f"      row  tasks  {'lane':<16} {'what':<24} {'forge':<14} item"[:w]
    table = []
    for r in rows:
        t = f"{r['tasks'][0]}/{r['tasks'][1]}" if r["tasks"][1] else "-"
        table.append((f"  {r['mark']} {r['id']:<4} {t:>5}  {r['lane'][:16]:<16} {row_what(r)[:24]:<24} {r['forge'][:14]:<14} {r['item']}"[:w],
                      MARK_STYLE.get(r["mark"], "ready")))
    box = []
    if sel is not None:
        r = rows[sel]
        inner = [r["item"], f"{r['state']}" + (f" · {r['detail']}" if r["detail"] else ""), f"next: {r['next']}" if r["next"] else "",
                 f"depends: {', '.join(r['depends'])}" if r["depends"] else "", f"tasks {r['tasks'][0]}/{r['tasks'][1]} · lane {r['lane']}" + (f" · {r['forge']}" if r["forge"] else "")]
        for text in (x for x in inner if x):
            box += wrap(text, w - 4)[:2]
    panel_lines = list((panel or {}).get("lines") or ["(no output)"])[-12:] if panel else []
    panel_head = (f"OUTPUT  $ {panel.get('shown', '')} · " + ("running …" if panel.get("rc") is None else f"exit {panel['rc']} · any key closes"))[:w] if panel else ""
    keys = wrap(KEYS, w)
    log_lines = list(log or [])[-BOARD_LOG_LINES:]

    def frame(lo, hi, box, panel_lines, log_lines):
        out, st = list(head), dict(styles)
        out.append("")   # air between the tabs and the table
        out.append(col); st[len(out) - 1] = "head"
        sel_line = None
        for i in range(lo, hi):
            line, style = table[i]
            if i == sel:
                sel_line = len(out)
            out.append(line[:w]); st[len(out) - 1] = "sel" if i == sel else style   # the selection is the highlight alone: no second arrow beside the mark
        if n == 0:
            out.append("  (no rows in the current batch — add one: python3 scripts/reef-queue.py add-row \"<item>\")"[:w])
        if hi < n or lo > 0:
            out.append(f"       … {lo + (n - hi)} more ({'↑' if lo else ''}{'↓' if hi < n else ''})"[:w])
        if box and sel is not None:
            title = f"┌─ row {rows[sel]['id']} "
            out += [(title + "─" * (w - len(title) - 1) + "┐")[:w]] + ["│ " + b.ljust(w - 4)[:w - 4] + " │" for b in box] + ["└" + "─" * (w - 2) + "┘"]
        if panel:
            out += [panel_head] + ["  " + l[:w - 2] for l in panel_lines]
        out.append((f"LOG  the runner's last {len(log_lines)} line(s) · w opens it" if log_lines else "LOG  no live log yet · w opens it")[:w]); st[len(out) - 1] = "head"
        for l in log_lines:
            out.append("  " + l[:w - 2])
            style = log_style(l)
            if style:
                st[len(out) - 1] = style
        out.append((f"INBOX  {len(items)} item(s) wait on you · i opens it" if items else "INBOX  nothing waits on you")[:w])
        out += ["─" * w] + keys
        return out, st, sel_line

    lo, hi = 0, n
    lines, st, sel_line = frame(lo, hi, box, panel_lines, log_lines)
    if height is None:
        return lines, st, sel_line
    h = int(height)
    while len(lines) > h and len(log_lines) > 2:                   # 1. the log's oldest lines (the newest two stay; w has the whole)
        log_lines = log_lines[1:]
        lines, st, sel_line = frame(lo, hi, box, panel_lines, log_lines)
    dropped = 0
    while len(lines) > h and len(panel_lines) > 1:
        panel_lines, dropped = panel_lines[1:], dropped + 1
        panel_lines[0] = f"… {dropped} more line(s) above"
        lines, st, sel_line = frame(lo, hi, box, panel_lines, log_lines)
    while len(lines) > h and len(box) > 1:
        box = box[:-1]
        lines, st, sel_line = frame(lo, hi, box, panel_lines, log_lines)
    while len(lines) > h and hi - lo > 1:
        anchor = sel if sel is not None else 0
        if hi - 1 > anchor and (hi - 1 - anchor) >= (anchor - lo):
            hi -= 1
        else:
            lo += 1
        lines, st, sel_line = frame(lo, hi, box, panel_lines, log_lines)
    if len(lines) > h:
        lines = lines[:max(0, h - len(keys))] + keys
        sel_line = sel_line if sel_line is not None and sel_line < h - len(keys) else None
    return lines, st, sel_line


def render_plan(wm, items, width=120, height=None):
    """PLAN: the progress — a bar per row, the autopilot's line (on since when, how many decisions Mahmoud took today), the lanes
    (what runs beside what under loop.rows_in_flight), the inbox's count. Returns (lines, styles)."""
    w = max(60, int(width))
    ap = wm.get("autopilot") or {}
    pr, pt = wm["progress"]["rows"], wm["progress"]["tasks"]
    lines = [f"PLAN  batch {wm['batch'] or '-'} · {pr[0]}/{pr[1]} rows · {pt[0]}/{pt[1]} tasks · ${wm['cost_today']:.2f} today · order: {'what can start first' if wm.get('order') == 'start' else 'the queue'} (o)"[:w], ""]
    styles = {0: "tabs"}
    for r in ordered(wm):
        d, t = r["tasks"]
        k = round(20 * d / t) if t else 0
        bar = "█" * k + "░" * (20 - k)
        styles[len(lines)] = MARK_STYLE.get(r["mark"], "ready")
        lines.append(f"  {r['mark']} row {r['id']:<4} {bar} {f'{d}/{t}' if t else '  -':>5}  {row_what(r)[:22]:<22} {r['item']}"[:w])
    lines.append("")
    lines.append(("AUTOPILOT  " + (f"on · pid {ap.get('pid')} · since {ap.get('since')} · {ap.get('decided_today', 0)} decided by Mahmoud today" if ap.get("on")
                                   else "off · a opens the start panel"))[:w])
    styles[len(lines) - 1] = "head"
    lanes = {}
    for r in ordered(wm):
        if r["mark"] != "✓":
            lanes.setdefault(r["lane"], []).append(r["id"])
    lines.append(f"LANES  {len(lanes)} lane(s) · up to {wm.get('cap') or '∞'} row(s) in flight (loop.rows_in_flight) · one lane, one row at a time"[:w])
    styles[len(lines) - 1] = "head"
    for lane, ids in lanes.items():
        lines.append(f"  {lane[:20]:<20} rows {' → '.join(ids)}"[:w])
    lines.append("")
    lines.append((f"INBOX  {len(items)} item(s) wait on you · i opens it" if items else "INBOX  nothing waits on you")[:w])
    keys = wrap(KEYS, w)
    if height is not None and len(lines) + 1 + len(keys) > int(height):
        lines = lines[:max(0, int(height) - 1 - len(keys))]
    return lines + ["─" * w] + keys, styles


def render_autopilot(wm, contract, width=120, height=None):
    """The autopilot's start panel (a): the contract it runs under, what Mahmoud decides and never decides, the order the rows
    will be worked (o toggles), which forge items it will close, and the one key that starts it. Returns (lines, styles)."""
    w = max(60, int(width))
    decides = ", ".join(contract.get("decides") or []) or "-"
    lines = [f"AUTOPILOT  start · the contract at {contract.get('digest16') or 'NOT APPROVED'} · Mahmoud decides: {decides}"[:w],
             f"  never: {contract.get('never') or '-'}"[:w], ""]
    styles = {0: "tabs", 1: "wait"}
    if not contract.get("approved"):
        lines.append("  no approved contract: Enter runs `reef autopilot`, which prints the one approval line to type first"[:w])
        lines.append("")
    lines.append(f"  the order it works ({'what can start first' if wm.get('order') == 'start' else 'the queue'} · o toggles):")
    closes = []
    i = 0
    for r in ordered(wm):
        if r["mark"] == "✓":
            continue
        i += 1
        if r["mark"] == "⏸":
            what = f"after row{'s' if len(r['waits']) > 1 else ''} {', '.join(r['waits'])} · asks you only for what the contract does not name"
        elif r["mark"] == "⧖":
            what = ("at the gate — Mahmoud approves it (plan is in Decides)" if "plan" in (contract.get("decides") or []) else "at your gate — approve it first (plan is not in Decides)") if r["state"] == "approval" \
                else ("a question — Mahmoud answers it (question is in Decides)" if "question" in (contract.get("decides") or []) else "a question — yours first (question is not in Decides)")
        elif r["mark"] == "▶":
            what = row_what(r) + (f" · {r['tasks'][1] - r['tasks'][0]} task(s) left" if r["tasks"][1] else "") + (f" · {r['forge']}" if r["forge"] else "")
        else:
            what = "can start now" + (f" · {r['tasks'][1]} task(s)" if r["tasks"][1] else " · to plan")
        styles[len(lines)] = MARK_STYLE.get(r["mark"], "ready")
        lines.append(f"  {i}. row {r['id']:<4} {r['item'][:36]:<36} — {what}"[:w])
        closes += [x for x in r["forge"].split(" · ") if x]
    if i == 0:
        lines.append("  (nothing to work: the batch is done or empty)")
    lines.append("")
    if closes:
        lines.append(f"  it merges or closes: {', '.join(closes)}"[:w])
    lines.append("  Enter starts `reef autopilot` (detached; the screen keeps showing it) · Esc back · q quit"[:w])
    styles[len(lines) - 1] = "head"
    if height is not None and len(lines) > int(height):
        lines = lines[:int(height) - 1] + [lines[-1]]
    return lines, styles


def render_help(view, width=120, height=None):
    """Every key, one line each (?)."""
    w = max(60, int(width))
    lines = [f"KEYS  (you are on {view.upper()}) · Esc, q or ? closes this",
             "  Tab        next view: WORK → INBOX → PLAN → LOG", "  i / p / w  INBOX / PLAN / LOG", "  ↑↓ j k     move the selection (LOG: scroll)",
             "  1-9        select the row or item", "  Enter      WORK, PLAN: open the row (its state and next step) · INBOX: run the item (an answer is typed on the screen)",
             "  o          order: the queue's, or what can start first", "  a          the autopilot's start panel (Enter there starts it)",
             "  g          refresh now (the screen refreshes itself every 3 s)", "  r n s d c u  reef run · night · stop · doctor · cost · update",
             "  on the log: ↑↓ a line · PgUp/PgDn a page · Home/End the ends · / find a line, n the next older · q back",
             "  q / Esc    quit (in LOG or help: back)", "", "  marks: ✓ done · ▶ building · ○ can start now · ⏸ waits on open rows · ⧖ yours (a gate or a question)",
             "  lanes: rows of one module go one at a time; different modules run beside each other (loop.rows_in_flight caps them)"]
    return [l[:w] for l in lines][:int(height)] if height is not None else [l[:w] for l in lines], {0: "tabs"}


def style_attrs(c, colors=True):
    """Style name → curses attribute, once per screen: the selection reversed; where the terminal has colors, a palette that reads at a
    glance (the owner, 2026-10-31: a batch of ready rows looked black and white) — green can start, cyan building, yellow yours, red
    blocked, dim done, the banner in color; bold and dim alone otherwise. `c` is the curses module (or, in a test, a dict of its constants)."""
    g = (lambda k, d=0: c.get(k, d)) if isinstance(c, dict) else (lambda k, d=0: getattr(c, k, d))
    bold, rev, normal, dim = g("A_BOLD"), g("A_REVERSE"), g("A_NORMAL"), g("A_DIM")
    attrs = {"banner": bold, "tabs": bold, "head": dim, "sel": rev, "done": dim, "build": bold, "ready": bold, "wait": bold, "blocked": bold}
    if colors and not isinstance(c, dict):
        try:
            if c.has_colors():
                c.start_color(); c.use_default_colors()
                for i, color in ((1, c.COLOR_GREEN), (2, c.COLOR_CYAN), (3, c.COLOR_YELLOW), (4, c.COLOR_RED), (5, c.COLOR_WHITE)):
                    c.init_pair(i, color, -1)
                attrs.update({"ready": c.color_pair(1) | bold, "build": c.color_pair(2) | bold, "wait": c.color_pair(3) | bold, "blocked": c.color_pair(4) | bold,
                              "done": c.color_pair(5) | dim, "banner": c.color_pair(3) | bold})
        except Exception:
            pass
    return attrs


def wrap(text, width):
    """Words onto lines of at most `width` characters; a word longer than the width is cut."""
    out, line = [], ""
    for word in str(text).split(" "):
        while len(word) > width:
            if line:
                out.append(line); line = ""
            out.append(word[:width]); word = word[width:]
        if line and len(line) + 1 + len(word) > width:
            out.append(line); line = word
        else:
            line = f"{line} {word}" if line else word
    return out + [line] if line or not out else out


def render(model, width=120, height=None, selected=None, panel=None):
    """The screen as lines for a terminal of `width` and, when known, `height`: the banner with the facts beside it, the inbox
    as a list — with `selected` an index, the chosen row marked and its command boxed under the list (wrapped; a command past
    four lines is cut with a mark, `run` shows it whole); with None (`--once`, a log; no height), every item with its command
    wrapped — the runner's steps filling what is left, the doctor's top warnings, the keys last. The sections are built whole,
    then rows are shed in one declared order until the screen fits: the oldest steps, the doctor's warnings, the box's tail,
    the items farthest from the selection — the keys are measured, never assumed. `panel` ({"shown", "rc", "lines"}) is the last
    command's output, a section under the box until a key (2026-10-31: a command runs inside the screen). Returns (lines, the
    selected line's index)."""
    w = max(40, int(width))
    items, warns = model["items"], model["warns"]
    n = len(items)
    sel = None if selected is None or not n else min(max(int(selected), 0), n - 1)
    head = [(row + "   " + fact)[:w] for row, fact in zip(BLOCK, model["facts"])] + ["─" * w]
    head.append((f"INBOX  {n} item(s) wait on you" if n else "INBOX  nothing waits on you")[:w])   # the keys have one home: the last line
    rows = []   # one entry per item: its lines
    for idx, it in enumerate(items):
        mark = "▶" if idx == sel else " "
        first = f"  {mark} {str(idx + 1) if idx < 9 else ' ':>1}  {it['kind']:<8} {it['text']}"[:w]
        rows.append([first] + (["       " + b for b in wrap(it["cmd"], w - 7)] if sel is None else []))
    box = wrap(items[sel]["cmd"], w - 4) if sel is not None else []
    if len(box) > 4:
        box = box[:3] + [box[3][:w - 6] + " …"]
    steps = list(model["steps"]) or ["(no steps recorded)"]
    warn_rows = warns[:3]
    keys = wrap(KEYS, w)   # measured, never assumed: two rows under 96 columns, three under 50
    panel_lines = list((panel or {}).get("lines") or ["(no output)"])[-12:] if panel else []
    panel_head = (f"OUTPUT  $ {panel.get('shown', '')} · " + ("running … (Ctrl-C leaves the screen)" if panel.get("rc") is None else f"exit {panel['rc']} · any key closes"))[:w] if panel else ""

    def frame(box, steps, warn_rows, lo, hi, panel_lines=None):
        panel_lines = panel_lines if panel_lines is not None else []
        out = list(head)
        sel_line = None
        for idx in range(lo, hi):
            if idx == sel:
                sel_line = len(out)
            out += rows[idx]
        if hi < n or lo > 0:
            out.append(f"       … {lo + (n - hi)} more ({'↑' if lo else ''}{'↓' if hi < n else ''})"[:w])
        if box:
            out += ["┌─ selected " + "─" * (w - 13) + "┐"] + ["│ " + b.ljust(w - 4) + " │" for b in box] + ["└" + "─" * (w - 2) + "┘"]
        if panel:
            out += [panel_head] + ["  " + l[:w - 2] for l in panel_lines]
        out += ["", "RUNNER  the last steps · w for the log"] + ["  " + st[:w - 2] for st in steps]
        if model["doctor"]:
            out.append(f"DOCTOR  {len(warns)} warning(s) · d for the whole report" if warns else "DOCTOR  nothing wrong")
            out += ["  " + l[:w - 2] for l in warn_rows]
        out += ["─" * w] + keys
        return out, sel_line

    lo, hi = 0, n
    if height is None:
        return frame(box, steps[-10:], warn_rows, lo, hi, panel_lines)
    h = int(height)
    lines, sel_line = frame(box, steps, warn_rows, lo, hi, panel_lines)
    while len(lines) > h and len(steps) > 1:                      # 1. the oldest steps
        steps = steps[-(len(steps) - min(len(steps) - 1, len(lines) - h)):]
        lines, sel_line = frame(box, steps, warn_rows, lo, hi, panel_lines)
    while len(lines) > h and warn_rows:                           # 2. the doctor's warnings (the count stays)
        warn_rows = warn_rows[:-1]
        lines, sel_line = frame(box, steps, warn_rows, lo, hi, panel_lines)
    dropped = 0
    while len(lines) > h and len(panel_lines) > 1:                # 3. the panel's oldest lines, the cut marked (the review)
        panel_lines, dropped = panel_lines[1:], dropped + 1
        panel_lines[0] = f"… {dropped} more line(s) above"
        lines, sel_line = frame(box, steps, warn_rows, lo, hi, panel_lines)
    while len(lines) > h and len(box) > 1:                        # 4. the box's tail
        box = box[:-2] + [box[-2][:w - 6] + " …"] if len(box) > 1 else box
        lines, sel_line = frame(box, steps, warn_rows, lo, hi, panel_lines)
    while len(lines) > h and hi - lo > 1:                         # 5. the items farthest from the selection
        anchor = sel if sel is not None else 0
        if hi - 1 > anchor and (hi - 1 - anchor) >= (anchor - lo):
            hi -= 1
        else:
            lo += 1
        lines, sel_line = frame(box, steps, warn_rows, lo, hi, panel_lines)
    if len(lines) > h:                                            # a terminal too small for the furniture: the keys stay last
        lines = lines[:max(0, h - len(keys))] + keys
        sel_line = sel_line if sel_line is not None and sel_line < h - len(keys) else None
    return lines, sel_line


def screen_text(root, doctor=None, width=120):
    """The screen as text, once: every item with its command (`reef screen --once`, a test, an SSH session, a log)."""
    return "\n".join(render(screen_model(root, doctor), width=width)[0]) + "\n"


def cmd_screen(root, args):
    if "--once" in args or not (sys.stdout.isatty() and sys.stdin.isatty()):
        print(screen_text(root, doctor_lines(root, fetch="--fetch" in args)), end="")   # --fetch asks the forge, as the doctor's flag does
        return 0
    try:
        import curses
    except ImportError:
        print(screen_text(root, doctor_lines(root)), end="")
        return 0
    try:
        return curses.wrapper(lambda stdscr: screen_loop(stdscr, root, curses))
    except KeyboardInterrupt:   # Ctrl-C leaves the screen like q, with no traceback
        return 0


def render_log(steps, width=120, height=24, offset=0, found="", matched=True):
    """The whole live log as a page: the newest lines at the bottom, `offset` lines scrolled back (0: following); each body line styled
    by log_style (the full line, as on the board). The header says where the page is, what `/` found (`found`; `matched` False: no
    match) and the keys. Returns (lines, styles, the largest offset)."""
    w = max(40, int(width)); h = max(5, int(height))
    body_h = h - 2
    top = max(0, len(steps) - body_h - int(offset))
    body = steps[top:top + body_h]
    most = max(0, len(steps) - body_h)
    where = "following" if int(offset) <= 0 else f"{int(offset)} line(s) back · End follows"
    what = (f" · found {found!r} · n next" if matched else f" · no match for {found!r}") if found else ""
    head = f"LOG  {len(steps)} line(s) · {where}{what} · ↑↓ line · PgUp/PgDn page · Home/End · / search · q back"
    styles = {i + 1: log_style(l) for i, l in enumerate(body) if log_style(l)}
    return [head[:w]] + ["  " + l[:w - 2] for l in body] + ["─" * w], styles, most


def on_key(k, sel, n, view):
    """The screen's keys as one table → an action, or None. WORK, PLAN and INBOX: a digit SELECTS, Enter opens the row (WORK, PLAN) / runs the item (INBOX),
    ↑↓/j/k move, Tab cycles the views, i/p/w jump, a opens the autopilot panel, o toggles the order, ? the help, the verb letters
    run a verb, g refreshes, q/Esc quit. LOG: ↑↓ scroll, w/q/Esc back. Help: q/Esc/? back. Autopilot panel: Enter starts, o, q/Esc back.
    (2026-10-31, the owner: a digit should select, a command should run without leaving the screen; the fourth screen: see the work first.)"""
    ch = chr(k).lower() if 0 < k < 256 else ""   # one case: a caps lock is not silence
    if view == "help":
        return ("view", "work") if ch in ("q", "?") or k == 27 else None
    if view == "autopilot":
        if ch == "q" or k == 27:
            return ("view", "work")
        if k in (10, 13, KEY_ENTER):
            return ("start",)
        return ("order",) if ch == "o" else None
    if view == "log":
        if ch in ("q", "w") or k == 27:
            return ("back",)   # to the view the log was opened from
        if k in (KEY_UP, ord("k")):
            return ("up",)
        if k in (KEY_DOWN, ord("j")):
            return ("down",)
        return {KEY_PPAGE: ("page_up",), KEY_NPAGE: ("page_down",), KEY_HOME: ("top",), KEY_END: ("bottom",), ord("/"): ("search",), ord("n"): ("next",)}.get(k)
    if k == 9:   # Tab: the next view
        return ("view", VIEWS[(VIEWS.index(view) + 1) % len(VIEWS)] if view in VIEWS else "work")
    if ch == "?":
        return ("help",)
    if ch == "i":
        return ("view", "inbox")
    if ch == "p":
        return ("view", "plan")
    if ch == "a":
        return ("autopilot",)
    if ch == "o":
        return ("order",)
    if ch == "q" or k == 27:
        return ("quit",)
    if ch == "g":
        return ("refresh",)
    if ch == "w":
        return ("log",)
    if k in (KEY_UP, ord("k")):
        return ("up",)
    if k in (KEY_DOWN, ord("j")):
        return ("down",)
    if k in (10, 13, KEY_ENTER):
        return (("open" if view in ("work", "plan") else "run"), sel) if n else None   # PLAN shows rows, never the inbox: Enter opens a row (the security review)
    if ch in VERB_KEYS:
        return ("verb", VERB_KEYS[ch])
    if ch and ch in "123456789" and int(ch) <= n:
        return ("select", int(ch) - 1)   # a digit selects; Enter runs — two rules, as the keys line says
    return None


KEY_UP, KEY_DOWN, KEY_ENTER, KEY_BACKSPACE, KEY_RESIZE = 259, 258, 343, 263, 410   # curses' codes, named here so on_key needs no curses
KEY_PPAGE, KEY_NPAGE, KEY_HOME, KEY_END = 339, 338, 262, 360


def edit_step(buf, k):
    """One key into the answer line — a character (str, from get_wch) or a special key (int): (the buffer after it, "done" |
    "cancel" | None). Enter is done, Esc cancels, Backspace deletes, a printable character appends; anything else changes nothing."""
    if isinstance(k, str):
        if k in ("\n", "\r"):
            return buf, "done"
        if k == "\x1b":
            return buf, "cancel"
        if k in ("\x7f", "\b"):
            return buf[:-1], None
        return (buf + k, None) if k.isprintable() else (buf, None)
    if k == KEY_ENTER:
        return buf, "done"
    if k == KEY_BACKSPACE:
        return buf[:-1], None
    return buf, None


def read_key(stdscr):
    """One key from the screen as edit_step wants it: a special key as int, a character as str — UTF-8 bytes gathered until
    they decode (the owner's Python is linked without get_wch, the review: an Arabic answer is whole characters, never bytes)."""
    k = stdscr.getch()
    if k < 0 or k >= 256:
        return k
    if k < 0x80:
        return chr(k)
    raw = bytes([k])
    for _ in range(3):
        try:
            return raw.decode("utf-8")
        except UnicodeDecodeError:
            nxt = stdscr.getch()
            if nxt < 0 or nxt >= 256:
                return ""
            raw += bytes([nxt])
    return raw.decode("utf-8", "replace")


def edit_line(stdscr, curses, y, w, prompt, text):
    """An answer typed on the screen: the prompt, the recommendation prefilled; Enter keeps or takes the edit, Esc cancels (None)."""
    buf = text
    curses.curs_set(1)
    try:
        while True:
            line = f"{prompt}{buf}"
            try:
                stdscr.move(y, 0); stdscr.clrtoeol()
                stdscr.addstr(y, 0, line[-(w - 1):] if len(line) > w - 1 else line, curses.A_BOLD)
            except curses.error:
                pass
            stdscr.refresh()
            k = read_key(stdscr)
            if k == -1 or k == "":
                continue
            buf, state = edit_step(buf, k)
            if state == "done":
                return buf.strip()
            if state == "cancel":
                return None
    finally:
        curses.curs_set(0)


def reanchor(items, sel, chosen):
    """The selection after the list changed: the item with the same command, else the same index clamped."""
    return next((i for i, it in enumerate(items) if it["cmd"] == chosen), min(sel, max(len(items) - 1, 0)))


def restart_screen(curses):
    """The same command in a fresh process (2026-10-31 18:50: `u` applied a new Reef and the screen, still running the old code, crashed
    loading a new sibling against the old module in memory). curses is ended first; the new process draws from what is on disk."""
    try:
        curses.endwin()
    except Exception:
        pass
    os.execv(sys.executable, [sys.executable, os.path.abspath(__file__), *sys.argv[1:]])


def run_captured(root, argv, timeout=900):
    """A command run for the screen: its last lines and exit code, never a shell, never the terminal."""
    try:
        r = subprocess.run(argv, cwd=root, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL,
                           env={**os.environ, "GIT_TERMINAL_PROMPT": "0", "GH_PROMPT_DISABLED": "1", "GIT_PAGER": "cat", "GH_PAGER": "cat", "PAGER": "cat"})   # no prompt, no pager
        lines = [l for l in (r.stdout + ("\n" + r.stderr if r.stderr.strip() else "")).splitlines() if l.strip()]
        return r.returncode, lines
    except subprocess.TimeoutExpired:
        return 124, [f"timed out after {timeout} s"]
    except OSError as e:
        return 1, [str(e)]


def screen_loop(stdscr, root, curses):
    curses.curs_set(0)
    stdscr.timeout(3000)
    utf = bool(sys.stdout.encoding and "utf" in sys.stdout.encoding.lower())
    doctor, sel, model, view, offset, panel = None, 0, None, "work", 0, None   # the first frame is drawn before any reading returns
    doctor_at = 0.0   # the doctor fetches the plugin clone: read again every UPDATE_SECONDS, so a merge in Reef becomes an item by itself
    wm, wm_at, wsel, back, order = None, 0.0, 0, "work", "queue"   # the work board, read every BOARD_SECONDS (a row's state is a subprocess each)
    found, found_at = "", None   # the log page's search: the query and the index of its last hit (None: no match)
    attrs = style_attrs(curses, colors=os.environ.get("REEF_COLOR", "1") != "0")

    def draw(lines, sel_line, styles=None):
        h, w = stdscr.getmaxyx()
        stdscr.erase()
        for y, line in enumerate(lines[:h]):
            if styles is not None:
                attr = attrs["sel"] if y == sel_line else attrs.get((styles or {}).get(y, ""), curses.A_NORMAL)
            else:
                attr = curses.A_REVERSE if y == sel_line else (curses.A_BOLD if y < len(BLOCK) and view == "inbox" else curses.A_NORMAL)
            try:
                text = (line if utf else line.encode("ascii", "replace").decode("ascii"))[:w - 1]   # characters: curses' counted write measures bytes
                stdscr.addstr(y, 0, text, attr)
            except (curses.error, UnicodeEncodeError):
                pass
        stdscr.refresh()

    QUIT.clear()
    jobs, results, failed = {}, {}, {}   # readings run off the UI thread (2026-10-31: the first board froze the screen for minutes on an issues queue)

    def spawn(name, fn):
        t = jobs.get(name)
        if name in failed or (t is not None and t.is_alive()):   # a reading that failed is not retried until g: its error stays on the screen
            return
        def run():
            try:
                results[name] = fn()
            except Exception as e:   # a reading that fails leaves the last good one on the screen
                results[name] = e
        jobs[name] = threading.Thread(target=run, daemon=True, name=f"reef-{name}")
        jobs[name].start()

    empty = {"facts": [f"{os.path.basename(root)} · reading …", "", "", "", ""], "items": [], "steps": [], "log": [], "warns": [], "doctor": False}
    model_at = 0.0

    def take():
        """The readings that landed, swapped in: the inbox (the selection follows its item), the board (the order kept), the doctor.
        A reading that raised is shown on the screen (never a silent "reading …" forever — the review) and not retried until g."""
        nonlocal model, model_at, wm, wm_at, doctor, doctor_at, sel, wsel
        for name in ("model", "board", "doctor", "queue"):
            if name in results and isinstance(results[name], Exception):
                e = results.pop(name)
                failed[name] = f"{name}: {type(e).__name__}: {str(e)[:120]}"
        if "model" in results:
            res = results.pop("model")
            chosen = model["items"][sel]["cmd"] if model and model["items"] and sel < len(model["items"]) else None
            model, model_at = res, time.time()
            sel = reanchor(model["items"], sel, chosen) if chosen else sel
        if "queue" in results:
            got = results.pop("queue")
            if wm is None:   # the full board may have landed first
                wm, wm_at = got, 0.0
                wm["order"] = order
        if "board" in results:
            chosen = ordered(wm)[wsel]["id"] if wm and wm.get("rows") and wsel < len(wm["rows"]) else None
            wm, wm_at = results.pop("board"), time.time()
            wm["order"] = order
            wsel = reanchor_rows(wm, wsel, chosen)
        if "doctor" in results:
            got = results.pop("doctor")
            if got is None:   # the doctor did not answer (180 s): a failed reading, shown and retried on g — not "nothing wrong" for fifteen minutes
                failed["doctor"] = "doctor: no answer"
            else:
                doctor, doctor_at = got, time.time()
                model_at = 0.0   # the inbox gains the doctor's fixes on the next reading
        if failed:
            empty["facts"][2] = ("reading failed · g retries · " + " · ".join(failed.values()))[:200]

    while True:
        h, w = stdscr.getmaxyx()
        # readings: the inbox model every INBOX_SECONDS, the board every BOARD_SECONDS (the queue first, at once), the doctor every UPDATE_SECONDS and on g — each in its thread
        if model is None or time.time() - model_at > INBOX_SECONDS:
            spawn("model", lambda: screen_model(root, doctor))
        if view in ("work", "plan", "autopilot") and (wm is None or time.time() - wm_at > BOARD_SECONDS):   # spawn() skips while the board is still being read
            if wm is None:
                spawn("queue", lambda: work_model(root, states=False))   # the rows at once, every open one `…`
            spawn("board", lambda: work_model(root))
        if wm is not None and wm.get("partial"):
            with BOARD_LOCK:
                landed = dict(BOARD["rows"])
            chosen = ordered(wm)[wsel]["id"] if wm.get("rows") and wsel < len(wm["rows"]) else None
            if fill_in(wm, landed):   # each row as the row machine answers; the selection follows its row
                wsel = reanchor_rows(wm, wsel, chosen)
        if doctor is None or time.time() - doctor_at > UPDATE_SECONDS:   # at open, after a command, on g — and when the reading is UPDATE_SECONDS old
            spawn("doctor", lambda: doctor_lines(root, fetch=time.time() - doctor_at > UPDATE_SECONDS))   # the forge is asked minutes apart, not after every key
        take()
        cur = model or empty
        note = ("reading failed · g retries · " + " · ".join(failed.values()))[:200] if failed else ""
        if note and model is not None:   # on the banner's fifth line, whatever the view (the placeholder frame has its own line)
            cur = dict(cur, facts=list(cur["facts"][:4]) + [note])
        if note and wm is not None:
            wm = dict(wm, facts=list(wm["facts"][:4]) + [note])
        n = len(cur["items"])
        sel = min(sel, max(n - 1, 0))
        nrows = len(wm["rows"]) if wm else 0
        wsel = min(wsel, max(nrows - 1, 0))
        sel_line, styles = None, None
        log_all = cur.get("log") or []
        if view == "log":
            lines, styles, most = render_log(log_all, width=w - 1, height=h, offset=offset, found=found, matched=found_at is not None)
            offset = min(offset, most)
            top = max(0, len(log_all) - (h - 2) - offset)
            if found and found_at is not None and top <= found_at < top + h - 2:
                sel_line = found_at - top + 1   # the hit, highlighted
        elif view == "work" or (view in ("plan", "autopilot") and wm is None):
            lines, styles, sel_line = render_work(wm, cur["items"], width=w - 1, height=h, selected=wsel, panel=panel, note=note, log=log_all)
        elif view == "plan":
            lines, styles = render_plan(wm, cur["items"], width=w - 1, height=h)
        elif view == "autopilot":
            lines, styles = render_autopilot(wm, contract_view(root), width=w - 1, height=h)
        elif view == "help":
            lines, styles = render_help(back, width=w - 1, height=h)
        else:
            lines, sel_line = render(cur, width=w - 1, height=h, selected=sel, panel=panel)
            styles = {i: "banner" for i in range(len(BLOCK))}
        draw(lines, sel_line, styles)
        loading = any(t.is_alive() for t in jobs.values())
        stdscr.timeout(400 if loading or results else 3000)   # while a reading runs, redraw often: the count moves, a result lands
        k = stdscr.getch()
        if k == -1:   # the tick: the next pass spawns the readings that are due
            continue
        if k == KEY_RESIZE:   # the owner widened the window: the next pass measures again
            curses.update_lines_cols()
            continue
        if panel is not None and panel.get("rc") is not None:   # any key closes the output panel — and does nothing else (the review:
            panel = None                                          # the item just acted on has left, so Enter would have run the NEXT one)
            continue
        ch = chr(k).lower() if 0 < k < 256 else ""
        if (ch == "q" or k == 27) and view in ("work", "inbox"):   # q never waits for a reading: the readers stop at QUIT
            QUIT.set()
            return 0
        act = on_key(k, wsel if view in ("work", "plan") else sel, nrows if view in ("work", "plan") else n, view)
        if act is None:
            continue
        if act[0] == "quit":
            QUIT.set()
            return 0
        if act[0] == "back":   # from the log
            view = back if back in VIEWS else "work"; continue
        if act[0] == "view":
            view = act[1]; continue
        if act[0] in ("log", "help", "autopilot"):
            back = view if view in VIEWS else "work"
            view, offset = {"log": "log", "help": "help", "autopilot": "autopilot"}[act[0]], 0
            found, found_at = "", None   # the page opens following, with no search
            continue
        if act[0] == "order":
            order = "start" if order == "queue" else "queue"
            if wm:
                wm["order"] = order
            continue
        if view == "log" and act[0] in ("page_up", "page_down", "top", "bottom", "search", "next"):
            if act[0] == "search":   # / asks for the query on the last line; the hit becomes the page's last line, highlighted; n the next older
                q = edit_line(stdscr, curses, h - 1, w, "find: ", "")   # a fresh query (n repeats the last one)
                if not q:
                    continue
                found = q
            offset, found_at = log_nav(act[0], log_all, max(1, h - 2), offset, found, found_at)
            continue
        if act[0] == "up":
            if view == "log":
                offset += 1
            elif view in ("work", "plan"):
                wsel = max(0, wsel - 1)
            else:
                sel = max(0, sel - 1)
            continue
        if act[0] == "down":
            if view == "log":
                offset = max(0, offset - 1)
            elif view in ("work", "plan"):
                wsel = min(max(nrows - 1, 0), wsel + 1)
            else:
                sel = min(max(n - 1, 0), sel + 1)
            continue
        if act[0] == "refresh":   # g: every reading again (a reading that failed too), the last good ones stay on the screen until the new ones land
            failed.clear(); doctor, model_at, wm_at = None, 0.0, 0.0; continue
        if act[0] == "select":
            if view in ("work", "plan"):
                wsel = act[1]
            else:
                sel = act[1]
            continue
        argv, shown = None, None
        if act[0] == "start":   # the autopilot panel's Enter: the verb, then back to the work board
            argv, shown, view = [PY, os.path.abspath(__file__), "autopilot", "--repo", root], "reef autopilot", "work"
        elif act[0] == "open":   # a row: its state and its one next step, from the row machine, in the panel
            rid = ordered(wm)[act[1]]["id"] if wm and act[1] < nrows else None
            if rid is None:
                continue
            argv, shown = [PY, script("reef-row.py") or "scripts/reef-row.py", "state", rid, "--repo", root], f"python3 scripts/reef-row.py state {rid}"
        elif act[0] == "verb":
            argv, shown = [PY, os.path.abspath(__file__), act[1], "--repo", root], f"reef {act[1]}"
        elif act[0] == "run":
            target = cur["items"][act[1]]
            argv, shown = target["argv"], target["cmd"]
            if target["kind"] == "answer":   # the answer typed on the screen, the recommendation prefilled
                text = edit_line(stdscr, curses, min(h - 1, (sel_line or 0) + 1), w, f"your answer for row {target['row']}: ",
                                 "".join(c for c in (target.get("recommended") or "") if c.isprintable()))   # agent text on the owner's line: printable only
                if not text:
                    continue
                key = f"#{target['issue']}" if target.get("issue") else target["row"]
                argv, shown = [PY, os.path.abspath(__file__), "answer", key, text, "--repo", root], f"reef answer {shlex.quote(key)} {shlex.quote(text)}"
        if argv and [os.path.basename(str(argv[0]))] + list(argv[1:3]) == ["gh", "auth", "login"]:   # interactive by nature: the screen cannot carry it
            panel = {"shown": shown, "rc": 1, "lines": ["this command needs your terminal — run it there, then g refreshes"]}
            continue
        if argv:
            panel = {"shown": shown, "rc": None, "lines": ["running …"]}
            if view == "work":
                lines, styles, sel_line = render_work(wm, cur["items"], width=w - 1, height=h, selected=wsel, panel=panel)
                draw(lines, sel_line, styles)
            else:
                lines, sel_line = render(cur, width=w - 1, height=h, selected=sel, panel=panel)
                draw(lines, sel_line)
            rc, out = run_captured(root, argv)
            panel = {"shown": shown, "rc": rc, "lines": out}
            curses.flushinp()   # a key typed while it ran must not run the next item
            doctor, model_at = None, 0.0   # a command may have changed everything: every reading again, in the background
            if act[0] != "open":
                wm_at = 0.0   # opening a row changed nothing on the board
            if len(argv) > 2 and argv[2] == "update" and rc == 0:
                restart_screen(curses)   # the files on disk are new and this process is old: the same command, fresh (2026-10-31)
                return 0


def cmd_approve(root, args):
    """The row's plan approval, as the row machine names it: `reef-approval.py --owner "Approve plan <slug> at <digest>?"`."""
    rows = [a for a in args if not a.startswith("--")]
    if len(rows) != 1:
        print("reef approve <row>", file=sys.stderr)
        return 2
    d = row_state(root, rows[0])
    qs = approval_questions(str(d.get("detail") or ""))
    if not qs:
        print(f"reef approve: row {rows[0]} is in state {d.get('state', 'unknown')!r} — nothing to approve ({str(d.get('detail') or 'the row machine has no view of it')[:160]})")
        return 1
    it = approve_item(qs[0], row=rows[0])
    print(f"reef approve: {it['cmd']}", flush=True)
    if "--dry-run" in args:
        return 0
    return subprocess.run(it["argv"], cwd=root).returncode   # reef-approval.py resumes the runner itself


def cmd_answer(root, args):
    """Your answer to a filed question — `reef answer <row> "<text>"`, or `reef answer '#<issue>' "<text>"`: on an issues
    queue `reef-queue.py answered <#>` closes the question's issue (what the loop reads there; a row with two open
    questions needs the number), on a file queue the footnote on its row; then the question's line is cleared."""
    pos = [a for a in args if not a.startswith("--")]
    if len(pos) != 2 or not re.fullmatch(r"#?\d+", pos[0]):
        print('reef answer <row> "<text>" · reef answer \'#<issue>\' "<text>"', file=sys.stderr)
        return 2
    key, text = pos
    if not text.strip() or text.strip() in ("-h", "--help"):   # `-h` would be reef-queue.py's help, and the line would clear with nothing recorded
        print("reef answer: the answer is empty — nothing recorded", file=sys.stderr)
        return 2
    filed = questions(root)
    if key.startswith("#"):
        mine = [(r, i) for r, i, _, _ in filed if i == key[1:]]
        row, issue = (mine[0] if mine else ("-", key[1:]))
    else:
        row = key
        numbers = [i for r, i, _, _ in filed if r == row and i]
        if len(numbers) > 1:
            print(f"reef answer: row {row} has {len(numbers)} open questions — name one: " + " · ".join(f"reef answer '#{n}' \"<text>\"" for n in numbers), file=sys.stderr)
            return 2
        issue = numbers[0] if numbers else ""
    a = answer_command(root, row, issue, text)
    if a is None:
        print(f"reef answer: row {row}'s question lives in a reef-question issue this line does not name — answer it there: gh issue list --label reef-question", file=sys.stderr)
        return 2
    argv, shown = a
    argv = [PY, script("reef-queue.py") or "scripts/reef-queue.py"] + argv[2:]
    print(f"reef answer: {shown}", flush=True)
    if "--dry-run" in args:
        return 0
    rc = subprocess.run(argv, cwd=root).returncode
    if rc != 0:
        return rc
    gone = drop_question(root, issue=issue) if issue else drop_question(root, row=row)   # on issues `answered` already did; a file queue clears here
    if gone:
        print(f"reef answer: row {row}'s question cleared from .reef/questions.md")
    return 0   # reef-queue.py resumed the runner itself


def cmd_update(root, args):
    plugin = args[args.index("--plugin") + 1] if "--plugin" in args and args.index("--plugin") + 1 < len(args) else plugin_dir()
    if not plugin:
        print("reef update: no plugin clone found — pass --plugin <dir> (the folder /plugin marketplace points at)", file=sys.stderr)
        return 1
    print(f"reef update: the plugin clone is {plugin}", flush=True)
    steps = [["git", "-C", plugin, "pull", "--ff-only"],
             [PY, os.path.join(plugin, "scripts", "reef-update.py"), "--repo", root, "--commit", "--no-reload-line"]]   # the last word is this verb's
    for cmd in steps:
        print("reef update: " + " ".join(cmd[-3:]), flush=True)
        if subprocess.run(cmd, cwd=root).returncode != 0:
            print("reef update: stopped at that step", file=sys.stderr)
            return 1
    r = subprocess.run(["git", "push"], cwd=root)   # the update's commit goes to the forge (2026-10-28: it sat local and the owner found it)
    print("reef update: pushed" if r.returncode == 0 else "reef update: the push failed — push yourself: git push", flush=True)
    setup = script("reef-setup.py")
    if setup and subprocess.run([PY, setup, "state", "--repo", root], capture_output=True).returncode == 3:
        print("reef update: the setup digest changed — proving it (a scratch worktree, the setup, the full gate once)", flush=True)
        if subprocess.run([PY, setup, "prove", "--repo", root], cwd=root).returncode != 0:
            return 1
    upd = sibling_module("reef-update.py", "reef_update_for_entry")
    market = upd.marketplace_name(plugin) if upd else None
    reloaded = refresh_marketplace(market)
    if reloaded:
        plugin_still_enabled()
    print(update_done_line(market, reloaded))
    return 0


def refresh_marketplace(market):
    """`claude plugin marketplace update <market>`, run by Reef from the terminal — the step a person used to hand the owner after
    every update (hands-off step 6). True when it ran and succeeded; False without `claude` on the PATH or a marketplace, or on a
    failure (the done line then names the step, with the real name)."""
    if not market or not shutil.which("claude"):
        return False
    try:
        r = subprocess.run(["claude", "plugin", "marketplace", "update", market], capture_output=True, text=True, timeout=120, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as e:
        print(f"reef update: claude plugin marketplace update {market} did not run ({type(e).__name__})", flush=True)
        return False
    if r.returncode != 0:
        print(f"reef update: claude plugin marketplace update {market} exited {r.returncode}: {(r.stderr or r.stdout).strip()[-200:]}", flush=True)
    return r.returncode == 0


def plugin_still_enabled():
    """After the marketplace refresh: is the plugin still enabled? (2026-10-28: a marketplace update left it disabled and nothing
    said so — no guard in any session.) The doctor's own check; a FAIL is enabled again here, never handed to the owner."""
    doc = sibling_module("reef-doctor.py", "reef_doctor_for_entry")
    if doc is None:
        return True
    level, what, fix = doc.plugin_enabled()
    if level != "FAIL":
        return True
    try:
        argv = shlex.split(fix)
    except ValueError:
        argv = []
    if argv[:3] != ["claude", "plugin", "enable"] or len(argv) != 4:
        print(f"reef update: {what} — {fix}", flush=True)
        return False
    r = subprocess.run(argv, capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
    print(f"reef update: the marketplace refresh left {argv[3]} disabled — " + ("enabled it again" if r.returncode == 0 else f"`{fix}` exited {r.returncode}: {(r.stderr or r.stdout).strip()[-160:]}"), flush=True)
    return r.returncode == 0


def update_done_line(market, reloaded=False):
    """The update's last word, with the marketplace's name as it is on disk (reef-update.marketplace_name) — never a placeholder
    in a line the owner types (2026-10-30). `reloaded`: Reef refreshed the marketplace itself, so the runner's next session runs
    the new Reef and only a Claude Code window open now has a step (/reload-plugins); otherwise the step is named."""
    if reloaded:
        return f"reef update: done — marketplace {market} refreshed; the runner's next session runs the new Reef; a Claude Code window open now: /reload-plugins"
    step = f"/plugin marketplace update {market}, then /reload-plugins" if market else "/reload-plugins (no marketplace lists this plugin clone)"
    return f"reef update: done — in Claude Code: {step}"


def cmd_factory(root, args):
    wf = os.path.join(root, ".github", "workflows", "reef-factory.yml")
    if not os.path.isfile(wf):
        print("factory: .github/workflows/reef-factory.yml is not accepted yet — python3 scripts/reef-init.py shows it OFFERED; accept with\n"
              "  python3 <plugin>/scripts/reef-init.py --root . --accept .github/workflows/reef-factory.yml   then commit it on the base")
        return 1
    if args and args[0].isdigit():
        r = subprocess.run([PY, script("reef-queue.py") or os.path.join(HERE, "reef-queue.py"), "row-issue", args[0], "--repo", root], capture_output=True, text=True)
        issue = (r.stdout.strip().splitlines() or [""])[-1]
        if r.returncode != 0 or not issue.isdigit():
            print(f"factory: row {args[0]} has no issue — {(r.stderr or r.stdout).strip()[:160]}", file=sys.stderr)
            return 1
        print(f"factory: labelling issue #{issue} reef-ready (the labeler must be an admin)", flush=True)
        return subprocess.run(["gh", "issue", "edit", issue, "--add-label", "reef-ready"], cwd=root).returncode
    return subprocess.run(["gh", "run", "list", "--workflow", "reef-factory.yml", "--limit", "5"], cwd=root).returncode


def menu(root):
    print(BANNER.rstrip("\n"))
    try:
        with open(os.path.join(root, ".reef", "version"), encoding="utf-8") as f:
            ver = f.read().strip()
    except OSError:
        ver = "?"
    print(f"  Reef {ver} · {root} · {status_line(root)}\n")
    for verb, what, _ in VERBS:
        print(f"  {verb:<9}{what}")
    print("\n  reef <verb> [args] · reef --all lists every script and its purpose · reef <verb> --repo <dir> for another project"
          "\n  on a terminal `reef` alone opens the screen: the inbox of what waits on you, one key per command; `reef --menu` is this list")
    return 0


def main(argv):
    args = list(argv)
    repo = "."
    if "--repo" in args and args.index("--repo") + 1 < len(args):
        repo = args[args.index("--repo") + 1]
        del args[args.index("--repo"):args.index("--repo") + 2]
    root = main_checkout(os.path.abspath(repo))   # the abspath fallback the entry point always had
    if not args:
        if sys.stdout.isatty() and sys.stdin.isatty() and not os.environ.get("REEF_NO_SCREEN"):
            return cmd_screen(root, [])   # a terminal: the screen; `reef --menu`, or no terminal, the menu
        return menu(root)
    if args == ["--menu"]:
        return menu(root)
    if args[0] == "--all":
        for name in sorted(os.listdir(HERE)):
            if name.startswith("reef-"):   # commands; reef_common.py is a module
                print(f"  {name:<28}{purpose(os.path.join(HERE, name))}")
        return 0
    verb, rest = args[0], args[1:]
    for name, _, do in VERBS:
        if name == verb:
            try:
                return do(root, rest)
            except KeyboardInterrupt:   # Ctrl-C on `reef watch` and the like: the owner stopped it; no traceback (2026-10-31)
                print()
                return 130
    print(f"reef: unknown verb {verb!r} — run `reef` for the list", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
