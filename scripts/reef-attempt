#!/usr/bin/env python3
# CLASS: code
"""Reef attempt counter — the retry cap as DATA, not model memory.

Usage:
  reef-attempt <task-file>                    report state; print model/effort for the NEXT dispatch
  reef-attempt <task-file> <failure-text...>  record a FAIL (increment attempts, store signature), then report
  reef-attempt --cap N <task-file> [...]      override the cap for this call (rollup/CI loops)

Exit codes: 0 = dispatch allowed (prints the dispatch line + the REEF-TASK header the
dispatch prompt must start with), 2 = BLOCKED or unusable input -> USER ACTION REQUIRED.
Anything this script cannot parse is a 2, never a silent 0 and never a traceback: fail closed.

Cap resolution: --cap flag > .reef/config.json caps.attempts > 3.
Model: .reef/config.json tiers.<tier>.roles.author > roles.author > "opus" (0.6: the task's tier picks
the role table; an unset table is the 0.5 behaviour). Effort ladder: the heavier of the task's own
`effort:` and tiers.<tier>.effort is the base; any recorded FAIL escalates to high. Prints `author:`,
`verifier:` (judge tasks) and `adversary:` (design/critical) lines so the orchestrator passes exactly these.
A `verify: judge` task also gets a `verifier: model=` line (roles.verifier > "opus"),
so the judge's model is read at dispatch exactly like the author's.

One rollup per feature: a rollup file (R<NN>-slug.md) is refused when another rollup
with the same `feature:` exists in tasks/ or tasks/done/. Acceptance, diff and CI rounds
all record on that ONE file, so `attempts:` counts across them under one cap.

Failure signatures are NORMALIZED before hashing (lowercase, timings/addresses/
file:line numbers stripped, whitespace collapsed) so the "same failure twice"
guard fires on the same failure, not on byte-identical text. Ports and other
plain `host:port` pairs are NOT stripped — two different services failing must
not collide into one signature.

This script records WHY a task fails. Enforcement does not depend on it being
called: the PreToolUse guard (reef-guard.py) independently refuses implementer
dispatches on blocked/at-cap task files and advances a `dispatches:` odometer,
under the same lock this script takes.
"""
import fcntl
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import tempfile
from functools import partial
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))   # the shared helpers live beside this script
sys.dont_write_bytecode = True   # and no scripts/__pycache__ lands in a project's tree (reef-update, a row worktree read it as changes)
from reef_common import main_checkout, read_config, repo_root, table_cells, die as _die  # noqa: E402

DEFAULT_CAP = 3
FENCE = re.compile(r"\A---\r?\n(.*?\r?\n)---\r?\n", re.S)
EFFORTS = ("low", "medium", "high")
TIERS = ("light", "full", "design", "critical")


die = partial(_die, prefix="USER ACTION REQUIRED")


# Line/column stripping is keyed on a CURATED set of code-file shapes — a bare
# "ext:digits" rule cannot tell main.py:17 from db.example.co:5432, and colliding two
# different services into one signature falsely blocks a task.
CODE_LOC = re.compile(
    r"(?<![\w:])("
    r"[\w./-]*\.(?:py|pyi|pyx|js|jsx|mjs|cjs|ts|tsx|go|rs|rb|java|c|h|hh|hpp|cc|cpp|cs|php"
    r"|swift|kt|kts|scala|sh|bash|zsh|pl|pm|lua|ex|exs|erl|hrl|ml|mli|hs|vue|svelte|sql|tf"
    r"|yaml|yml|toml|json)"
    r"|[\w./-]*(?:makefile|dockerfile|justfile|rakefile|build|workspace)"
    r")((?::\d+)+)"      # :line and :line:col both drift between attempts
)


def normalize(failure):
    s = failure.lower()
    s = re.sub(r"0x[0-9a-f]+", "", s)                    # addresses
    s = re.sub(r"\b\d+(\.\d+)?m?s\b", "", s)             # timings (1.23s, 450ms)
    s = CODE_LOC.sub(r"\1:", s)                          # file.py:17[:5] — never host:port
    s = re.sub(r"\s+", " ", s).strip()
    return s


def parse_args(argv):
    cap = None
    rest = []
    i = 0
    while i < len(argv):
        if argv[i] == "--cap":
            if i + 1 >= len(argv) or not argv[i + 1].isdigit() or int(argv[i + 1]) < 1:
                die("--cap requires a positive integer")
            cap = int(argv[i + 1])
            i += 2
        else:
            rest.append(argv[i])
            i += 1
    if not rest:
        die("usage: reef-attempt [--cap N] <task-file> [failure-text...]")
    path = rest[0]
    failure_given = len(rest) > 1
    failure = " ".join(rest[1:]).strip()
    if failure_given and not failure:
        die("a failure argument was passed but it is empty — a FAIL with no text cannot be recorded; pass the real failure output")
    return cap, path, failure


def proof_is_test(cell):
    """A Proof cell is a test name unless it reads like a command ([mechanic], shell operators, a runner, a path) —
    the same reading scripts/reef-converge gives it."""
    body = cell.strip().strip("`").strip()
    if re.match(r"^\[mechanic\]", body):
        return False
    if re.search(r"(?<![A-Za-z0-9_])test_[a-z0-9_]+|(?:\bit|\btest|\bdescribe)\(", body):
        return True
    if re.search(r"&&|\|\||[|;<>]|\$\(|\$\{|\s--?[a-zA-Z]|=|^!", body):
        return False
    head = body.split()[0] if body.split() else ""
    runners = {"sh", "bash", "zsh", "env", "npm", "npx", "pnpm", "yarn", "bun", "node", "deno", "python", "python3", "pytest", "uv", "pip",
               "cargo", "go", "make", "git", "grep", "curl", "docker", "tsc", "eslint", "prettier", "vitest", "jest"}
    return not (head in runners or head.startswith(("./", "/", "../", "~")))


def rejudge_line(text, rnd):
    """Round ≥2: the criteria the verifier re-judges — those the last FAIL named, plus every criterion whose Proof is
    not a test (a command or a [mechanic] row the gate does not run). The others are carried: round 1's test name plus
    the gate's exit 0 on the new snapshot is their evidence. No criterion named in the failure → all of them."""
    log = re.search(r"^##\s+Log\s*$(.*)\Z", text, re.M | re.S)
    fails = [l for l in (log.group(1) if log else "").splitlines() if re.match(r"^\s*-\s*attempt \d+ FAIL:", l)]
    named = sorted({int(x) for x in re.findall(r"\bAC-?(\d+)\b", fails[-1])}, key=int) if fails else []
    if not named:
        return f"rejudge: all (round {rnd}: the recorded failure names no criterion)"
    proof = re.search(r"^##\s+Proof\s*$(.*?)(?=^##\s|\Z)", text, re.M | re.S)
    non_test = []
    for l in (proof.group(1) if proof else "").splitlines():
        cells = table_cells(l)
        m = re.match(r"^\**AC-?(\d+)\**$", cells[0]) if len(cells) >= 2 else None
        if m and not re.match(r"^-+$", cells[1]) and not proof_is_test(cells[1]):
            non_test.append(int(m.group(1)))
    ids = sorted(set(named) | set(non_test))
    return (f"rejudge: {', '.join(f'AC-{i}' for i in ids)} (round {rnd}: the criteria the failure named"
            + (f" plus the ones whose Proof is not a test: {', '.join(f'AC-{i}' for i in sorted(set(non_test) - set(named)))}" if set(non_test) - set(named) else "")
            + "; every other criterion is CARRIED — its verdict line cites round 1's test name and the gate's exit 0 on this snapshot, no re-verification)")


def lock_path_for(path):
    """Shared with reef-guard.py. Lives in tmp (never committed) and is never
    unlinked — unlink-in-finally is the classic broken lock."""
    digest = hashlib.sha1(os.path.abspath(path).encode()).hexdigest()
    return os.path.join(tempfile.gettempdir(), f"reef-lock-{digest}")


class TaskFile:
    """Frontmatter-scoped read/write. Keys are only ever read from and written to the
    region between the opening fences — never the body (a `status:` line inside ## Log
    is history, not state). Newlines are preserved byte-for-byte (newline='') so a
    CRLF task file is not silently rewritten, which would invalidate the plan stamp."""

    def __init__(self, path):
        self.path = path
        with open(path, encoding="utf-8", newline="") as f:
            self.text = f.read()
        m = FENCE.match(self.text)
        if not m:
            die(f"{path} has no frontmatter fence (--- ... ---) — not a reef task file; refusing to guess")
        self._fm_span = m.span(1)

    @property
    def fm(self):
        return self.text[self._fm_span[0]:self._fm_span[1]]

    def get(self, key, default=""):
        m = re.search(rf"^{re.escape(key)}:[ \t]*(.*)$", self.fm, re.M)
        return m.group(1).strip().strip('"') if m else default

    def set(self, key, value):
        fm = self.fm
        if re.search(rf"^{re.escape(key)}:", fm, re.M):
            fm = re.sub(rf"^{re.escape(key)}:.*$", f"{key}: {value}", fm, count=1, flags=re.M)
        else:
            fm = fm + f"{key}: {value}\n"
        self.text = self.text[:self._fm_span[0]] + fm + self.text[self._fm_span[1]:]
        self._fm_span = (self._fm_span[0], self._fm_span[0] + len(fm))

    def append_log(self, line):
        """One line at the end of ## Log (the last section; outside every digest). No ## Log → one is added."""
        nl = "\r\n" if "\r\n" in self.text else "\n"
        if re.search(r"^##[ \t]+[Ll][Oo][Gg][ \t]*$", self.text, re.M):
            self.text = self.text.rstrip("\r\n") + nl + line + nl
        else:
            self.text = self.text.rstrip("\r\n") + nl + nl + "## Log" + nl + line + nl

    def get_int(self, key, default=0):
        raw = self.get(key, str(default)) or str(default)
        try:
            v = int(raw)
        except ValueError:
            die(f"{self.path}: frontmatter {key}: {raw!r} is not an integer — fix the file")
        if v < 0:
            die(f"{self.path}: frontmatter {key}: {v} is negative — fix the file")
        return v

    def write(self):
        fd, tmp = tempfile.mkstemp(prefix=".reef-attempt-", dir=os.path.dirname(os.path.abspath(self.path)))
        try:
            with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
                f.write(self.text)
            os.replace(tmp, self.path)
        except BaseException:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise


ROLLUP_NAME = re.compile(r"^R\d+-.*\.md$")


def check_single_rollup(path, task):
    if not ROLLUP_NAME.match(os.path.basename(path)):
        return
    feature = task.get("feature")
    if not feature:
        die(f"{path}: a rollup must name its feature: (one rollup per feature carries the cap)")
    here = os.path.dirname(os.path.abspath(path))
    tasks_dir = os.path.dirname(here) if os.path.basename(here) == "done" else here
    for d in (tasks_dir, os.path.join(tasks_dir, "done")):
        if not os.path.isdir(d):
            continue
        for f in sorted(os.listdir(d)):
            other = os.path.join(d, f)
            if not ROLLUP_NAME.match(f) or os.path.abspath(other) == os.path.abspath(path):
                continue
            try:
                with open(other, encoding="utf-8", newline="") as fh:
                    m = FENCE.match(fh.read())
            except (OSError, UnicodeDecodeError):
                continue
            om = m and re.search(r"^feature:[ \t]*(.*)$", m.group(1), re.M)
            if om and om.group(1).strip().strip('"') == feature:
                die(f"feature {feature!r} already has rollup {os.path.relpath(other, tasks_dir)} — reuse it "
                    "(move it back from done/ with status: pending if needed); a second rollup resets the cap")


def plan_check_module():
    """scripts/reef-plan-check.py beside this script: the one home of the path rule (workflow v3)."""
    import importlib.machinery
    import importlib.util
    p = os.path.join(os.path.dirname(os.path.abspath(__file__)), "reef-plan-check.py")
    loader = importlib.machinery.SourceFileLoader("reef_plan_check", p)
    spec = importlib.util.spec_from_loader("reef_plan_check", loader)
    mod = importlib.util.module_from_spec(spec)
    sys.dont_write_bytecode = True
    loader.exec_module(mod)
    return mod


def run_attempt(cap_flag, path, failure):
    if not os.path.isfile(path):
        die(f"task file not found: {path}")
    root = repo_root(path)
    cfg = read_config(root)
    # loop policy has ONE home, the main checkout — like the queue (2026-10-18: `hunter.guard_pass: feature` was set on
    # develop; the feature worktree's copy of the config predated it and the fix round dispatched a hunter)
    policy = read_config(main_checkout(root)) or cfg
    cap = cap_flag or int(cfg.get("caps", {}).get("attempts", DEFAULT_CAP) or DEFAULT_CAP)
    roles = cfg.get("roles", {}) if isinstance(cfg.get("roles", {}), dict) else {}

    with open(lock_path_for(path), "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        task = TaskFile(path)
        attempts = task.get_int("attempts")
        prev_sig = task.get("last_failure_sig")
        check_single_rollup(path, task)
        # 0.6: the model per role and the effort come from the task's TIER table
        # (tiers.<tier>.roles.<role>, tiers.<tier>.effort) and fall back to roles.* — an
        # unset table is exactly the 0.5 behaviour
        tier = task.get("tier") or ("light" if task.get("complexity") == "mech" else "full")
        if tier not in TIERS:
            die(f"{path}: tier {tier!r} not in {'/'.join(TIERS)}")
        tcfg = cfg.get("tiers", {}).get(tier, {}) if isinstance(cfg.get("tiers", {}), dict) else {}
        troles = tcfg.get("roles", {}) if isinstance(tcfg, dict) and isinstance(tcfg.get("roles", {}), dict) else {}
        pick = lambda role, default: str(troles.get(role) or roles.get(role) or default)
        model, verifier, adversary = pick("author", "opus"), pick("verifier", "opus"), pick("adversary", "opus")
        tier_effort = str(tcfg.get("effort", "") or "") if isinstance(tcfg, dict) else ""

        # an already-blocked task is immutable until a human unblocks it — recording
        # more failures onto it would burn the counter past the cap and overwrite the
        # very signature the human needs to diagnose the block
        if task.get("status") == "blocked":
            die("task is blocked. A HUMAN must unblock it (set attempts: 0, status: pending, last_failure_sig: \"\") before any dispatch.")

        if failure:
            sig = hashlib.sha1(normalize(failure).encode()).hexdigest()[:12]
            attempts += 1
            # "twice" means twice within THIS round: after a human reset
            # (attempts back to 0) a stale signature must not burn the fresh round.
            repeated = attempts > 1 and prev_sig != "" and sig == prev_sig
            task.set("attempts", str(attempts))
            task.set("last_failure_sig", sig)
            # the failure's words go to ## Log (outside every digest): the next dispatch reads which criteria failed
            # and prints `rejudge:` — round ≥2 judges those, not all 23 again (2026-10-18: 202's one-test fix round
            # re-verified 23 criteria, 31 turns, 71k)
            task.append_log(f"- attempt {attempts} FAIL: {' '.join(failure.split())[:300]} · at {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}")
            if attempts >= cap or repeated:
                task.set("status", "blocked")
                task.write()
                reason = "same failure signature twice" if repeated else f"retry cap {cap} reached"
                die(f"task blocked ({reason}). attempts={attempts} sig={sig}")
            task.write()

        if attempts >= cap:  # cap is authoritative on the dispatch path too, not only when recording
            die(f"task is at the retry cap ({attempts}/{cap}); a HUMAN must reset or re-plan.")

        base = task.get("effort", "medium")
        if base not in EFFORTS:
            base = "medium"
        if tier_effort in EFFORTS and EFFORTS.index(tier_effort) > EFFORTS.index(base):
            base = tier_effort          # the tier's effort raises the task's; it never lowers it
        effort = "high" if attempts > 0 else base
        print(f"dispatch: model={model} effort={effort} attempt={attempts + 1}/{cap}")
        print(f"author: model={model} tier={tier}")
        print(f"hand-back: .reef/ci-local/handback-{task.get('id')}.md in the task worktree — the implementer writes it; "
              f"the orchestrator only checks it (reef-claims) and never types it from the agent's message")
        rw = int((cfg.get("writing") or {}).get("report_words", 0) or 0) if isinstance(cfg.get("writing"), dict) else 0
        acs = re.search(r"^##\s+Acceptance Criteria\s*$(.*?)(?=^##\s|\Z)", task.text, re.M | re.S)
        n_ac = len([l for l in (acs.group(1) if acs else "").splitlines()
                    if re.match(r"^\s*[-*+]\s+|^\s*\d+[.)]\s+", l) and "HUMAN AC" not in l])
        # workflow v3, phase 3b: the tier names the path — on the fast path (a 0.6 feature folder, light/full, no risk touch)
        # no verifier per task: the commit gate per commit, the evidence once, the one reviewer at the end
        fast_row = False
        try:
            pth, folder = plan_check_module().row_mode(path)
            fast_row = pth == "fast" and folder
            print(f"path: {pth}" + (" (row worktree)" if fast_row else ""))
        except Exception as e:
            print(f"path: critical (the plan could not be read: {e})")
        if task.get("verify") == "judge" and fast_row:
            print("verifier: none (fast path: the commit gate per commit, the evidence once, the one reviewer at the end)")
        elif task.get("verify") == "judge":
            print(f"verifier: model={verifier}")
            if rw:  # the judge is told its budget before it writes (first contact: 1693 words, unknown cap, a rewrite round)
                print(f"report: budget={rw + 40 * max(0, n_ac - 8)} words, RULE lines free ({n_ac} criteria)")
            if attempts > 0:
                print(rejudge_line(task.text, attempts + 1))
        if tier in ("design", "critical"):
            # hunter.guard_pass = feature (0.7): no hunter per task — graph-run and the task skill read the absence of the
            # `adversary:` line; the one pass runs on the feature's diff in /reef-review (2026-10-18: two judges, 96k, 20 lines)
            if str((policy.get("hunter") or {}).get("guard_pass", "task") or "task").lower() == "feature":
                print("guard-pass: feature (no hunter on this task; ONE loophole-hunter pass on the feature's diff before the GREEN record)")
            else:
                print(f"adversary: model={adversary}")
                if rw:
                    print(f"hunter-report: budget={rw} words")
        # absolute: the guard resolves this against the SESSION cwd, which need not
        # be the cwd this script happened to run from
        print(f"REEF-TASK: {os.path.abspath(path)}")


def main():
    cap_flag, path, failure = parse_args(sys.argv[1:])
    try:
        run_attempt(cap_flag, path, failure)
    except SystemExit:
        raise
    except Exception as e:   # fail closed: exit 2 with a reason, never a traceback
        die(f"internal error on {path}: {e}")


if __name__ == "__main__":
    main()
