#!/usr/bin/env python3
"""Reef attempt counter — the retry cap as DATA, not model memory.
Usage: reef-attempt <task-file> [failure-text...]
- No failure text: report current state + model/effort to use for the NEXT dispatch.
- With failure text: record a FAIL (increment attempts, store failure signature), then report.
Exit codes: 0 = dispatch allowed (prints model/effort), 2 = BLOCKED (cap or repeated signature) -> USER ACTION REQUIRED.
Rule for the orchestrator: NEVER spawn an implementer without running this first and using what it prints.
"""
import hashlib, re, sys

CAP = 3
path = sys.argv[1]
failure = " ".join(sys.argv[2:]).strip()
text = open(path).read()

def get(key, default=""):
    m = re.search(rf"^{key}:\s*(.*)$", text, re.M)
    return m.group(1).strip().strip('"') if m else default

def setkey(key, value):
    global text
    if re.search(rf"^{key}:", text, re.M):
        text = re.sub(rf"^{key}:.*$", f"{key}: {value}", text, count=1, flags=re.M)
    else:
        text = text.replace("---\n", f"---\n{key}: {value}\n", 1)  # after opening fence
        # ensure inserted inside frontmatter: insert after first line instead
attempts = int(get("attempts", "0") or 0)
prev_sig = get("last_failure_sig", "")

if failure:
    sig = hashlib.sha1(failure.encode()).hexdigest()[:12]
    attempts += 1
    repeated = sig == prev_sig and prev_sig != ""
    setkey("attempts", str(attempts))
    setkey("last_failure_sig", sig)
    if attempts >= CAP or repeated:
        setkey("status", "blocked")
        open(path, "w").write(text)
        reason = "same failure signature twice" if repeated else f"retry cap {CAP} reached"
        print(f"USER ACTION REQUIRED: task blocked ({reason}). attempts={attempts} sig={sig}", file=sys.stderr)
        sys.exit(2)
    open(path, "w").write(text)

if get("status") == "blocked":
    print("USER ACTION REQUIRED: task is blocked. Human must unblock (reset attempts/status) before any dispatch.", file=sys.stderr)
    sys.exit(2)

# escalation ladder: attempt 0 -> base effort; any recorded FAIL -> high.
model, effort = ("opus", "medium") if attempts == 0 else ("opus", "high")
print(f"dispatch: model={model} effort={effort} attempt={attempts + 1}/{CAP}")
