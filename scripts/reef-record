#!/usr/bin/env python3
# CLASS: code
"""Reef record — a review verdict bound to the FORGE-reported commit, or a plan review verdict bound to the plan's digest.
Usage: reef-record <feature> <verdict> [--pr <number|url|branch>] [--report FILE] [--root DIR]
  (0.7.1) GREEN/PASS needs --report: the reviewer's report naming the PR head (its first 12 hex) and its `VERDICT:` line
       reef-record plan-review <feature> <PASS|FAIL> [--report FILE] [--root DIR]
       reef-record security <PASS|FAIL> --report FILE [--root DIR]
  security (0.7) writes .reef/review/security-<sha12>.json = {kind, head, base, verdict, report_sha256, recorded_at}: the
  release's security pass (reef:security) bound to the head of branches.base; the guard refuses `gh pr create` into
  branches.release without a PASS whose head is the PR's head.
  plan-review writes .reef/review/plan-<feature>.json = {digest16, digest, verdict, rounds, decided?, report_sha256, recorded_at} in the MAIN
  checkout; the digest is computed where the plan is (--root, default cwd). `reef-plan-check.py --verify-stamp` requires
  a PASS at the current digest for any feature with a task above `light`, so the guard refuses the first dispatch of a
  plan whose semantic review never passed (first contact, 2026-10-16: the stamp recorded the scripted check only).
Writes .reef/review/<feature>.json = {sha, tree, verdict, base, pr, recorded_at} from `gh pr view` and
`gh api …/git/commits/<sha>`; under merge.by: loop the guard refuses `gh pr merge` without a PASS/GREEN record on
the forge head. Exit 0 recorded · 2 gh failed / no PR / bad usage (nothing written).
"""
import json
import os
import re
import subprocess
import sys
import time
from functools import partial
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))   # the shared helpers live beside this script
sys.dont_write_bytecode = True   # and no scripts/__pycache__ lands in a project's tree (reef-update, a row worktree read it as changes)
from reef_common import main_checkout, die as _die  # noqa: E402

GH_TIMEOUT = float(os.environ.get("REEF_GH_TIMEOUT", "20"))


die = partial(_die, prefix="reef-record")


def gh_text(*args, cwd=None):
    try:
        r = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=GH_TIMEOUT, cwd=cwd)
    except FileNotFoundError:
        die("gh is not installed — the record needs the forge's view of the PR")
    except subprocess.TimeoutExpired:
        die(f"gh {' '.join(args[:2])} exceeded {GH_TIMEOUT:g}s")
    if r.returncode != 0:
        die(f"gh {' '.join(args[:2])} failed ({r.returncode}): {r.stderr.strip()[:300]}")
    return r.stdout.strip()


def review_rounds_cap(main):
    """review.plan_rounds from the main checkout's config (default 2; 0 = no cap)."""
    try:
        with open(os.path.join(main, ".reef", "config.json"), encoding="utf-8") as f:
            return int(((json.load(f).get("review") or {}).get("plan_rounds", 2)) or 0)
    except (OSError, ValueError, TypeError, AttributeError):
        return 2


def footnote_recorded(root, feature, mark):
    """The owner's ruling is a queue footnote: a line of the main checkout's queue starting with the mark (`⁶⁸`, or `68`) —
    the same reading reef-adversarial's `--decided` makes."""
    main = main_checkout(root)
    try:
        with open(os.path.join(main, ".reef", "config.json"), encoding="utf-8") as f:
            qrel = (json.load(f).get("paths") or {}).get("queue", "docs/queue.md")
    except (OSError, ValueError, TypeError, AttributeError):
        qrel = "docs/queue.md"
    sup = mark.translate(str.maketrans("0123456789", "⁰¹²³⁴⁵⁶⁷⁸⁹"))
    try:
        with open(os.path.join(main, qrel), encoding="utf-8") as f:
            return any(l.startswith(sup + " ") or l.startswith(mark + " ") for l in f)
    except OSError:
        return False


def plan_digest(root, feature):
    script = os.path.join(root, "scripts", "reef-plan-check.py")
    if not os.path.isfile(script):
        script = os.path.join(os.path.dirname(os.path.abspath(__file__)), "reef-plan-check.py")
    r = subprocess.run([sys.executable, script, root, "--digest", "--feature", feature], capture_output=True, text=True, timeout=60)
    m = re.search(r"^digest: \S+ ([0-9a-f]{64})", r.stdout, re.M)
    return m.group(1) if m else None


def cmd_plan_review(argv):
    import hashlib
    report, root, decided, pos = None, None, None, []
    i = 0
    while i < len(argv):
        if argv[i] == "--report":
            report = argv[i + 1]; i += 2
        elif argv[i] == "--root":
            root = argv[i + 1]; i += 2
        elif argv[i] == "--decided":
            decided = argv[i + 1].strip(); i += 2
        else:
            pos.append(argv[i]); i += 1
    if len(pos) != 2 or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", pos[0]) or pos[1].upper() not in ("PASS", "FAIL"):
        die("usage: reef-record plan-review <feature> <PASS|FAIL> [--report FILE] [--decided <footnote mark>] [--root DIR]")
    feature, verdict = pos[0], pos[1].upper()
    root = os.path.abspath(root or os.getcwd())
    digest = plan_digest(root, feature)
    if not digest:
        die(f"cannot compute the plan digest for {feature!r} in {root} — run from the checkout that holds the plan")
    rec = {"digest16": digest[:16], "digest": digest, "verdict": verdict, "recorded_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    if report:
        try:
            with open(report, "rb") as f:
                rec["report_sha256"] = hashlib.sha256(f.read()).hexdigest()
            rec["report"] = os.path.relpath(os.path.abspath(report), root)
        except OSError as e:
            die(f"cannot read the report {report}: {e}")
    d = os.path.join(main_checkout(root), ".reef", "review")
    os.makedirs(d, exist_ok=True)
    p_ = os.path.join(d, f"plan-{feature}.json")
    try:   # 2026-10-30: a review is a round — the record counts them, the guard caps them (review.plan_rounds), like the hunter's pass
        with open(p_, encoding="utf-8") as f:
            prev = json.load(f)
        failed = int(prev.get("rounds") or 0) if str(prev.get("verdict", "")).upper() == "FAIL" else 0   # a PASS closes the series
    except (OSError, ValueError, TypeError):
        failed = 0
    rec["rounds"] = failed + 1
    cap = review_rounds_cap(main_checkout(root))
    if verdict == "PASS" and cap and failed >= cap:
        # past the cap the reviewer runs no more; a PASS is then the OWNER's ruling, bound to his queue footnote like the
        # hunter's `plan --decided` (the security review: a bare PASS would have dissolved the cap it answers)
        if not decided:
            die(f"plan review of {feature!r} is past review.plan_rounds {cap} ({failed} FAILED rounds): a PASS now records the owner's "
                f"ruling — write it as a queue footnote on the row, then --decided <its mark>")
        if not footnote_recorded(root, feature, decided):
            die(f"--decided {decided}: no queue footnote with that mark — the owner's ruling is written on the row first")
        rec["decided"] = decided
    with open(p_, "w", encoding="utf-8") as f:
        json.dump(rec, f, indent=1)
        f.write("\n")
    print(f"recorded plan review {feature}: {verdict} at {digest[:16]} (round {rec['rounds']}) -> .reef/review/plan-{feature}.json")
    return 0


def feature_guard_pass_missing(cwd, feature):
    """Under hunter.guard_pass = feature: the ids of the feature's design/critical tasks (open and done) without an
    adversarial-guard record; [] under the task mode (the pre-commit enforced it per task) or with every task stamped."""
    import importlib.machinery
    import importlib.util
    p = os.path.join(os.path.dirname(os.path.abspath(__file__)), "reef-adversarial")
    if not os.path.isfile(p):
        return []
    spec = importlib.util.spec_from_loader("reef_adversarial", importlib.machinery.SourceFileLoader("reef_adversarial", p))
    adv = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(adv)
    except Exception:
        return []
    if adv.guard_pass_mode(cwd) != "feature":
        return []
    root, cfg = adv.config_near(cwd)
    if not root:
        return []
    return [fm.get("id", os.path.basename(p_)) for p_, fm in adv.guarded_tasks(root, cfg, feature) if not (fm.get("adversarial-guard") or "").strip()]


def cmd_security(argv):
    """The release's security pass (reef:security), bound to the commit it audited: the head of branches.base in the
    main checkout. Stored as `head`, never `sha`, so no security record can stand in for a feature's GREEN at
    `gh pr merge`. A FAIL is recorded too (evidence); only a PASS at the head lets the guard open the release PR."""
    import hashlib
    report, root, pos = None, None, []
    i = 0
    while i < len(argv):
        if argv[i] == "--report":
            report = argv[i + 1]; i += 2
        elif argv[i] == "--root":
            root = argv[i + 1]; i += 2
        else:
            pos.append(argv[i]); i += 1
    if len(pos) != 1 or pos[0].upper() not in ("PASS", "FAIL") or not report:
        die("usage: reef-record security <PASS|FAIL> --report FILE [--root DIR]")
    verdict = pos[0].upper()
    root = main_checkout(os.path.abspath(root or os.getcwd()))
    try:
        with open(report, "rb") as f:
            raw = f.read()
    except OSError as e:
        die(f"cannot read the report {report}: {e}")
    text = raw.decode("utf-8", "replace")
    if not re.search(r"^RUN:[ \t]*agent=security\b", text, re.M):
        die(f"{report} is not a security report: its first line must be `RUN: agent=security …` (written by reef:security)")
    m = re.search(r"^VERDICT:[ \t]*(PASS|FAIL)\b", text, re.M)
    if not m:
        die(f"{report} has no `VERDICT: PASS|FAIL` line")
    if m.group(1) != verdict:
        die(f"the report says VERDICT: {m.group(1)}, not {verdict} — the record carries the agent's verdict, never another")
    if verdict == "PASS" and re.search(r"^BLOCKER\b", text, re.M):
        die(f"{report} says PASS with a BLOCKER line — a BLOCKER fails the pass")
    try:
        with open(os.path.join(root, ".reef", "config.json"), encoding="utf-8") as f:
            cfg = json.load(f)
    except Exception:
        cfg = {}
    base = str((cfg.get("branches") or {}).get("base", "main") or "main")
    r = subprocess.run(["git", "-C", root, "rev-parse", "--verify", "--quiet", f"refs/heads/{base}^{{commit}}"], capture_output=True, text=True)
    head = r.stdout.strip()
    if r.returncode != 0 or not re.fullmatch(r"[0-9a-f]{40}", head):
        die(f"no local branch {base!r} (branches.base) in {root} — the pass is bound to its head")
    rec = {"kind": "security", "head": head, "base": base, "verdict": verdict, "report_sha256": hashlib.sha256(raw).hexdigest(),
           "report": os.path.abspath(report), "recorded_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    d = os.path.join(root, ".reef", "review")
    os.makedirs(d, exist_ok=True)
    out = os.path.join(d, f"security-{head[:12]}.json")
    with open(out, "w", encoding="utf-8") as f:
        json.dump(rec, f, indent=1)
        f.write("\n")
    print(f"recorded security pass: {verdict} at {base} {head[:12]} -> .reef/review/security-{head[:12]}.json")
    return 0


def evidence_for(cwd, sha):
    """v3 phase 2: the suite's one result for the PR head, through scripts/reef-evidence.py beside this script (CI's
    check-runs when the project runs CI on feature PRs, else the gate's record for the commit's tree). A GREEN record
    binds a verdict to a commit; without green evidence for that commit there is nothing to bind it to."""
    import importlib.machinery
    import importlib.util
    p = os.path.join(os.path.dirname(os.path.abspath(__file__)), "reef-evidence.py")
    if not os.path.isfile(p):
        return {"source": "none", "state": "none", "why": "scripts/reef-evidence.py is missing (reef-update copies it)"}
    spec = importlib.util.spec_from_loader("reef_evidence", importlib.machinery.SourceFileLoader("reef_evidence", p))
    ev = importlib.util.module_from_spec(spec)
    sys.dont_write_bytecode = True   # no scripts/__pycache__ written into the tree
    spec.loader.exec_module(ev)
    return ev.evidence(cwd, sha)


def main(argv):
    if "-h" in argv or "--help" in argv:   # 0.7 (2026-10-24): `footnote --help` wrote a footnote reading "--help"
        print(__doc__.strip())
        return 0
    if argv and argv[0] == "plan-review":
        return cmd_plan_review(argv[1:])
    if argv and argv[0] == "security":
        return cmd_security(argv[1:])
    pr, root, pos, report = None, None, [], None
    i = 0
    while i < len(argv):
        if argv[i] == "--pr":
            pr = argv[i + 1]; i += 2
        elif argv[i] == "--report":
            report = argv[i + 1]; i += 2
        elif argv[i] == "--root":
            root = argv[i + 1]; i += 2
        else:
            pos.append(argv[i]); i += 1
    if len(pos) != 2 or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", pos[0]):
        die("usage: reef-record <feature> <verdict> [--pr N] [--root DIR]")
    feature, verdict = pos
    cwd = root or os.getcwd()
    if verdict.upper() in ("GREEN", "PASS"):
        missing = feature_guard_pass_missing(cwd, feature)
        if missing:
            die(f"{feature}: hunter.guard_pass is `feature` and the guard pass is not recorded on task(s) {', '.join(missing)} — dispatch the "
                f"loophole-hunter ONCE on the feature's diff (`git diff <base>...HEAD`, pass=guard) and record it with "
                f"`scripts/reef-adversarial --feature {feature} guard <report>` before a GREEN record")
    view = json.loads(gh_text("pr", "view", *([pr] if pr else []), "--json", "headRefOid,baseRefName,url,number", cwd=cwd))
    sha, base, url = view.get("headRefOid", ""), view.get("baseRefName", ""), view.get("url", "")
    m = re.search(r"github\.com/([^/]+)/([^/]+)/pull/(\d+)", url)
    if not re.fullmatch(r"[0-9a-f]{40}", sha) or not m:
        die(f"gh pr view returned no usable head/url: {view}")
    tree = gh_text("api", f"repos/{m.group(1)}/{m.group(2)}/git/commits/{sha}", "--jq", ".tree.sha", cwd=cwd)
    if not re.fullmatch(r"[0-9a-f]{40}", tree):
        die(f"gh api returned no tree sha for {sha}: {tree!r}")
    rec = {"sha": sha, "tree": tree, "verdict": verdict.upper(), "base": base, "pr": int(m.group(3)),
           "recorded_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    if verdict.upper() in ("GREEN", "PASS"):
        # 2026-10-24, the trial: the guard said "re-review and re-record", and a re-record with no review followed. The
        # record now carries the review: the report's VERDICT and the head it reviewed, bound by its hash.
        if not report or not os.path.isfile(report):
            die("a GREEN record carries its reviewer's report: --report <file> with `HEAD: <sha12>` and `VERDICT: GREEN`")
        raw = open(report, "rb").read()
        text = raw.decode("utf-8", "replace")
        v = re.search(r"^VERDICT:[ \t]*(GREEN|PASS|FAIL)\b", text, re.M)
        if not v or v.group(1) == "FAIL":
            die(f"{report} says VERDICT: {v.group(1) if v else '(none)'} — the record carries the reviewer's verdict, never another")
        if sha[:12] not in text:
            h = re.search(r"^HEAD:[ \t]*([0-9a-f]{7,40})", text, re.M)
            die(f"the report reviewed {h.group(1)[:12] if h else 'no named head'}, not the PR head {sha[:12]} — review the head, then record")
        import hashlib
        rec["report_sha256"] = hashlib.sha256(raw).hexdigest()
        e = evidence_for(cwd, sha)
        if e.get("state") != "green":
            what = {"red": f"the evidence for {sha[:12]} is RED ({e.get('source')}): a GREEN record needs a green suite — fix, then record",
                    "pending": f"CI is still running for {sha[:12]} — record when it is done (python3 scripts/reef-evidence.py {sha[:12]})"}
            die(what.get(e.get("state"), f"no evidence for {sha[:12]}: no check-run and no .reef/evidence/<snapshot>.json for its tree — "
                                        f"run `sh scripts/reef-gate.sh full` on that tree (or wait for CI), then record" + (f" ({e['why']})" if e.get("why") else "")))
        rec["evidence"] = {"source": e.get("source"), "snapshot": e.get("snapshot"),
                           "checks": [c.get("name") for c in e.get("checks") or []] or None}
    d = os.path.join(main_checkout(cwd), ".reef", "review")
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, f"{feature}.json"), "w", encoding="utf-8") as f:
        json.dump(rec, f, indent=1)
        f.write("\n")
    print(f"recorded {feature}: {verdict.upper()} at {sha[:12]} (tree {tree[:12]}, PR #{rec['pr']} -> {base})")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except Exception as e:
        die(f"internal error: {e}")
