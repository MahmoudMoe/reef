#!/usr/bin/env python3
# CLASS: code
"""Reef record — a review verdict bound to the FORGE-reported commit, or the release's security verdict.
Usage: reef-record <feature> <verdict> [--pr <number|url|branch>] [--report FILE] [--root DIR]
  (0.7.1) GREEN/PASS needs --report: the reviewer's report naming the PR head (its first 12 hex) and its `VERDICT:` line
  (0.7.5) one review: on a critical-path feature under hunter.guard_pass = feature the report carries `## Guard pass`, and
       `## Security` when a task touches auth/pii/money/migration (any mode) — refused without them, naming what is missing
       reef-record security <PASS|FAIL> --report FILE [--root DIR]
  security (0.7) writes .reef/review/security-<sha12>.json = {kind, head, base, verdict, report_sha256, recorded_at}: the
  release's security pass (reef:security) bound to the head of branches.base; the guard refuses `gh pr create` into
  branches.release without a PASS whose head is the PR's head.
Writes .reef/review/<feature>.json = {sha, tree, verdict, base, pr, recorded_at} from `gh pr view` and
`gh api …/git/commits/<sha>`; under merge.by: loop the guard refuses `gh pr merge` without a PASS/GREEN record on
the forge head. Exit 0 recorded · 2 gh failed / no PR / bad usage (nothing written).
"""
import json
import os
import re
import subprocess
import sys
import time
from functools import partial
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))   # the shared helpers live beside this script
sys.dont_write_bytecode = True   # and no scripts/__pycache__ lands in a project's tree (reef-update, a row worktree read it as changes)
from reef_common import main_checkout, die as _die, report_binding, BLOCKER_LINE, load_sibling, read, section  # noqa: E402

GH_TIMEOUT = float(os.environ.get("REEF_GH_TIMEOUT", "20"))


die = partial(_die, prefix="reef-record")


def gh_text(*args, cwd=None):
    try:
        r = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=GH_TIMEOUT, cwd=cwd)
    except FileNotFoundError:
        die("gh is not installed — the record needs the forge's view of the PR")
    except subprocess.TimeoutExpired:
        die(f"gh {' '.join(args[:2])} exceeded {GH_TIMEOUT:g}s")
    if r.returncode != 0:
        die(f"gh {' '.join(args[:2])} failed ({r.returncode}): {r.stderr.strip()[:300]}")
    return r.stdout.strip()


def review_parts(cwd, feature):
    """0.7.5, one review (an adopted project, 2026-11-07: the hunter's guard pass, a per-feature security review and the acceptance
    review were three read-only agents on one head): the sections the acceptance report of a GREEN must carry — `Guard pass` on a
    critical-path feature (`reef-tier.py path`'s rule) under hunter.guard_pass = feature, `Security` when a task touches
    auth/pii/money/migration. None when the feature's tasks are in no checkout under feature mode (fail closed); the tasks are
    read where the plan lives (feature_home). Under the task mode the pre-commit holds a guard record per task, as before."""
    adv, pc = load_sibling("reef-adversarial"), load_sibling("reef-plan-check.py")
    feature_mode = adv.guard_pass_mode(cwd) == "feature"
    root, cfg = adv.feature_home(cwd, feature)
    if not root:
        return None if feature_mode else []
    tasks = [p for p in adv.feature_tasks(root, cfg, feature) if not pc.is_rollup(p)]
    parts = ["Guard pass"] if feature_mode and tasks and pc.feature_path(tasks)[0] == "critical" else []
    touches = {t.strip().strip("\"'") for p in tasks for t in pc.fm_value(read(p, errors="replace"), "touches").strip("[]").split(",")}
    return parts + (["Security"] if touches & set(pc.RISK_TOUCHES) else [])


def parts_missing(text, parts):
    """The `## <part>` sections a report lacks, or holds with nothing under them but its VERDICT line."""
    def body(part):
        b = section(text, part) or ""
        return [l for l in b.splitlines() if l.strip() and not l.lstrip().startswith(("VERDICT:", "```"))]
    return [f"## {p}" for p in parts if not body(p)]


def cmd_security(argv):
    """The release's security pass (reef:security), bound to the commit it audited: the head of branches.base in the
    main checkout. Stored as `head`, never `sha`, so no security record can stand in for a feature's GREEN at
    `gh pr merge`. A FAIL is recorded too (evidence); only a PASS at the head lets the guard open the release PR."""
    import hashlib
    report, root, pos = None, None, []
    i = 0
    while i < len(argv):
        if argv[i] == "--report":
            report = argv[i + 1]; i += 2
        elif argv[i] == "--root":
            root = argv[i + 1]; i += 2
        else:
            pos.append(argv[i]); i += 1
    if len(pos) != 1 or pos[0].upper() not in ("PASS", "FAIL") or not report:
        die("usage: reef-record security <PASS|FAIL> --report FILE [--root DIR]")
    verdict = pos[0].upper()
    root = main_checkout(os.path.abspath(root or os.getcwd()))
    try:
        with open(report, "rb") as f:
            raw = f.read()
    except OSError as e:
        die(f"cannot read the report {report}: {e}")
    text = raw.decode("utf-8", "replace")
    if verdict == "PASS" and BLOCKER_LINE.search(text):
        die(f"{report} says PASS with a BLOCKER line — a BLOCKER fails the pass")
    try:
        with open(os.path.join(root, ".reef", "config.json"), encoding="utf-8") as f:
            cfg = json.load(f)
    except Exception:
        cfg = {}
    base = str((cfg.get("branches") or {}).get("base", "main") or "main")
    r = subprocess.run(["git", "-C", root, "rev-parse", "--verify", "--quiet", f"refs/heads/{base}^{{commit}}"], capture_output=True, text=True)
    head = r.stdout.strip()
    if r.returncode != 0 or not re.fullmatch(r"[0-9a-f]{40}", head):
        die(f"no local branch {base!r} (branches.base) in {root} — the pass is bound to its head")
    why = report_binding(text, "security", head, (verdict,), head_on_run=True, bound=f"the head of {base}")   # its RUN line's head=
    if why:
        die(f"{report}: {why}")
    rec = {"kind": "security", "head": head, "base": base, "verdict": verdict, "report_sha256": hashlib.sha256(raw).hexdigest(),
           "report": os.path.abspath(report), "recorded_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    d = os.path.join(root, ".reef", "review")
    os.makedirs(d, exist_ok=True)
    out = os.path.join(d, f"security-{head[:12]}.json")
    with open(out, "w", encoding="utf-8") as f:
        json.dump(rec, f, indent=1)
        f.write("\n")
    print(f"recorded security pass: {verdict} at {base} {head[:12]} -> .reef/review/security-{head[:12]}.json")
    return 0


def evidence_for(cwd, sha):
    """v3 phase 2: the suite's one result for the PR head, through scripts/reef-evidence.py beside this script (CI's
    check-runs when the project runs CI on feature PRs, else the gate's record for the commit's tree). A GREEN record
    binds a verdict to a commit; without green evidence for that commit there is nothing to bind it to."""
    import importlib.machinery
    import importlib.util
    p = os.path.join(os.path.dirname(os.path.realpath(__file__)), "reef-evidence.py")
    if not os.path.isfile(p):
        return {"source": "none", "state": "none", "why": "scripts/reef-evidence.py is missing (reef-update copies it)"}
    spec = importlib.util.spec_from_loader("reef_evidence", importlib.machinery.SourceFileLoader("reef_evidence", p))
    ev = importlib.util.module_from_spec(spec)
    sys.dont_write_bytecode = True   # no scripts/__pycache__ written into the tree
    spec.loader.exec_module(ev)
    return ev.evidence(cwd, sha)


def main(argv):
    if "-h" in argv or "--help" in argv:   # 0.7 (2026-10-24): `footnote --help` wrote a footnote reading "--help"
        print(__doc__.strip())
        return 0
    if argv and argv[0] == "plan-review":   # 0.7.5: the plan-reviewer is gone; never a GREEN record for a feature named so
        die("plan-review is retired (0.7.5): the critical path's plan review is the hunter's plan pass (scripts/reef-adversarial)")
    if argv and argv[0] == "security":
        return cmd_security(argv[1:])
    pr, root, pos, report = None, None, [], None
    i = 0
    while i < len(argv):
        if argv[i] == "--pr":
            pr = argv[i + 1]; i += 2
        elif argv[i] == "--report":
            report = argv[i + 1]; i += 2
        elif argv[i] == "--root":
            root = argv[i + 1]; i += 2
        else:
            pos.append(argv[i]); i += 1
    if len(pos) != 2 or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", pos[0]):
        die("usage: reef-record <feature> <verdict> [--pr N] [--root DIR]")
    feature, verdict = pos
    cwd = root or os.getcwd()
    if verdict.upper() in ("GREEN", "PASS"):
        parts = review_parts(cwd, feature)
        if parts is None:
            die(f"{feature}: feature not found — no task file of it in its worktree or the main checkout, so its path cannot be read")
        missing = parts_missing(read(report, errors="replace", default=""), parts) if report and os.path.isfile(report) else []
        if missing:
            die(f"{feature}: the review's {' and '.join(missing)} {'is' if len(missing) == 1 else 'are'} missing or empty in {report} — on the critical "
                f"path the acceptance review opens with the guard pass (and the security part on an auth/pii/money/migration touch): "
                f"re-dispatch reef:acceptance with `critical path: yes` (agents/acceptance.md), then record")
    view = json.loads(gh_text("pr", "view", *([pr] if pr else []), "--json", "headRefOid,headRefName,baseRefName,url,number", cwd=cwd))
    sha, base, url = view.get("headRefOid", ""), view.get("baseRefName", ""), view.get("url", "")
    try:
        with open(os.path.join(main_checkout(cwd), ".reef", "config.json"), encoding="utf-8") as f:
            prefix = str((json.load(f).get("branches") or {}).get("feature_prefix", "feat/") or "feat/")
    except (OSError, ValueError, AttributeError):
        prefix = "feat/"
    if "headRefName" in view and view["headRefName"] != prefix + feature:   # 2026-11-03 H7: another row's PR
        die(f"PR {view.get('number', pr)} is {view['headRefName']!r}, not {prefix + feature!r} — the record is this row's PR")
    m = re.search(r"github\.com/([^/]+)/([^/]+)/pull/(\d+)", url)
    if not re.fullmatch(r"[0-9a-f]{40}", sha) or not m:
        die(f"gh pr view returned no usable head/url: {view}")
    tree = gh_text("api", f"repos/{m.group(1)}/{m.group(2)}/git/commits/{sha}", "--jq", ".tree.sha", cwd=cwd)
    if not re.fullmatch(r"[0-9a-f]{40}", tree):
        die(f"gh api returned no tree sha for {sha}: {tree!r}")
    rec = {"sha": sha, "tree": tree, "verdict": verdict.upper(), "base": base, "pr": int(m.group(3)),
           "recorded_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    green = verdict.upper() in ("GREEN", "PASS")
    if green and (not report or not os.path.isfile(report)):
        # 2026-10-24, the trial: the guard said "re-review and re-record", and a re-record with no review followed. The
        # record now carries the review: the report's VERDICT and the head it reviewed, bound by its hash.
        die("a GREEN record carries its reviewer's report: --report <file> with `HEAD: <sha12>` and `VERDICT: GREEN`")
    if report:   # any verdict (2026-11-03 H7): the acceptance agent's report of THIS row at THIS head, saying this verdict
        try:
            raw = open(report, "rb").read()
        except OSError as e:
            die(f"cannot read the report {report}: {e}")
        why = report_binding(raw.decode("utf-8", "replace"), "acceptance", sha, ("GREEN", "PASS") if green else (verdict.upper(),),
                             feature=feature, run_required=green)
        if why:
            die(f"{report}: {why}")
        import hashlib
        rec["report_sha256"] = hashlib.sha256(raw).hexdigest()
    if green:
        e = evidence_for(cwd, sha)
        if e.get("dirty"):   # 2026-11-03, hard H2: a killed close left the row's last task uncommitted, and the gate's green was that tree's
            die(f"the tree differs from {sha[:12]}: commit or close first (a GREEN binds the head, and the gate ran on a tree it does not hold)")
        if e.get("state") != "green":
            what = {"red": f"the evidence for {sha[:12]} is RED ({e.get('source')}): a GREEN record needs a green suite — fix, then record",
                    "pending": f"CI is still running for {sha[:12]} — record when it is done (python3 scripts/reef-evidence.py {sha[:12]})"}
            die(what.get(e.get("state"), f"no evidence for {sha[:12]}: no check-run and no .reef/evidence/<snapshot>.json for its tree — "
                                        f"run `sh scripts/reef-gate.sh full` on that tree (or wait for CI), then record" + (f" ({e['why']})" if e.get("why") else "")))
        rec["evidence"] = {"source": e.get("source"), "snapshot": e.get("snapshot"),
                           "checks": [c.get("name") for c in e.get("checks") or []] or None}
    d = os.path.join(main_checkout(cwd), ".reef", "review")
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, f"{feature}.json"), "w", encoding="utf-8") as f:
        json.dump(rec, f, indent=1)
        f.write("\n")
    print(f"recorded {feature}: {verdict.upper()} at {sha[:12]} (tree {tree[:12]}, PR #{rec['pr']} -> {base})")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except Exception as e:
        die(f"internal error: {e}")
