#!/usr/bin/env python3
# CLASS: code
"""Reef structure — the one tree, checked. Usage: reef-structure --check | --raw-sql | --sizes | --quality [--baseline] [--repo DIR]
--quality (0.7.5): the clean-code ratchet — the project's own linter (eslint, ruff) with Reef's limits (`structure.quality`:
complexity 10, params 5, function_lines 60, statements 50, depth 4) on the files the branch changed since its base, over reef/quality-baseline.json
(`--quality --baseline` grandfathers the old code). No linter: exit 77, a skip. Joins gates.extra.
--sizes (0.7.2): the size ratchet over reef/size-baseline.json (written by `reef-recalibrate measure`, product files only): a
baselined file may not grow past its baseline, a new file may not exceed `structure.new_file_lines` (default 400); a file that
shrank lowers its baseline in the same run. Only the files the branch changed since its base are read. Joins gates.extra.
--raw-sql (0.7.2; 0.7.3 any stack with a profile): exit 1 on an unsafe raw query (scripts/reef-stacks.json) in a file outside `assess.raw_sql_allow`
(the files that held one when assess measured — a baseline, not a cleanup); a comment line never counts. Joins gates.extra.
Exit 1 when a process document (decision, spec, runbook, plan) lives outside the layout — reef/ for 0.6, the
docs/adr, docs/queue.md, docs/journal.md, tasks/ places for a project without .reef/version. Kept: README, LICENSE*,
CONTRIBUTING, SECURITY, CHANGELOG, CODEOWNERS, docs a docs build serves, reef/archive/, anything referenced from
code/CI. Feature-folder rules come from reef-queue.py. Joins gates.extra.
"""
import json
import os
import re
import subprocess
import sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))   # the shared helpers live beside this script
sys.dont_write_bytecode = True   # and no scripts/__pycache__ lands in a project's tree (reef-update, a row worktree read it as changes)
from reef_common import served_dirs, config_homes  # noqa: E402

KEEP = {"README.md", "LICENSE", "LICENSE.md", "CONTRIBUTING.md", "SECURITY.md", "CHANGELOG.md", "CODEOWNERS", "CODE_OF_CONDUCT.md", "AGENTS.md", "CLAUDE.md", "HANDOFF.md"}
PROCESS = re.compile(r"(^|/)(adr|adrs|decisions?|rfcs?|specs?|plans?|runbooks?|design|proposals?)(/|$)|(adr|rfc|spec|plan|runbook|decision|proposal|design)[-_.]", re.I)
HEADINGS = re.compile(r"^#+\s*(Status|Context|Decision|Consequences|Acceptance Criteria|Requirements|Runbook|Proposal)\b", re.M | re.I)


def referenced(root, rel):
    # a reference from code, CI or the docs build exempts a document; Reef's own plan (.reef/recalibration.json names
    # every document), logs and evidence dumps do not — on a real project they made the check pass over 800 stray files
    r = subprocess.run(["git", "-C", root, "grep", "-l", "-F", "--", rel, "--", ":!*.md", ":!.reef/**", ":!*.log", ":!*.txt"],
                       capture_output=True, text=True)
    return bool(r.stdout.strip())


def is_process_doc(root, rel):
    if PROCESS.search(rel):
        return True
    try:
        with open(os.path.join(root, rel), encoding="utf-8", errors="replace") as f:
            head = f.read(6000)
    except OSError:
        return False
    return bool(HEADINGS.search(head))


def config_homes_of(root):
    """config_homes (reef_common) for a project root — None when .reef/config.json cannot be read."""
    try:
        with open(os.path.join(root, ".reef", "config.json"), encoding="utf-8") as f:
            return config_homes(json.load(f))
    except (OSError, ValueError):
        return None


PLAN_KEEP = re.compile(r"^(directory .+ read by|referenced by|waits: |the instruction layer|edited on unmerged branch|in place \()")   # 0.7.3: adopted in place


def plan_keeps(root):
    """The documents the recalibration plan kept ON PURPOSE because something still reads them (a directory read, a code or
    instruction-file reference, a reader to retire, an in-flight edit): the baseline, not a violation — the gate can be on from
    day one and only a NEW stray document fails (first adoption, 2026-10-25: `structure` found 507 such documents under specs/ and
    design_handoff/ the plan had kept for `check:docs`, so the gate could not be switched on). A `keep` the owner chose by hand
    (reason edited) counts too: the plan is the owner's decision."""
    p = os.path.join(root, ".reef", "recalibration.json")
    try:
        with open(p, encoding="utf-8") as f:
            entries = json.load(f).get("entries") or []
    except (OSError, ValueError):
        return set()
    return {e["path"] for e in entries if e.get("action") == "keep" and (PLAN_KEEP.match(str(e.get("reason") or "")) or e.get("blocked_by"))}


def violations(root):
    is06 = os.path.isfile(os.path.join(root, ".reef", "version"))
    homes = config_homes_of(root)
    kept = plan_keeps(root)
    kept_seen = 0
    legacy_ok = ("docs/adr/", "docs/queue", "docs/journal", "docs/day-zero", "docs/glossary", "docs/runlog", "tasks/", ".specify/")
    served = served_dirs(root)
    bad = []
    r = subprocess.run(["git", "-C", root, "ls-files", "--", "*.md", "**/*.md"], capture_output=True, text=True)
    files = [l for l in r.stdout.splitlines() if l.endswith(".md")]
    if not files:
        files = [os.path.relpath(os.path.join(dp, f), root) for dp, dn, fn in os.walk(root) if ".git" not in dp and ".reef" not in dp for f in fn if f.endswith(".md")]
    for rel in sorted(files):
        if os.path.basename(rel) in KEEP or rel.startswith(("reef/", ".reef/", ".github/", ".claude/")):
            continue
        if any(rel == d or rel.startswith(d + "/") for d in served if d):
            continue
        if homes is not None and any(rel == h or rel.startswith(h + "/") for h in homes):
            continue   # the home the config names, whatever the version
        if not homes and not is06 and rel.startswith(legacy_ok):
            continue   # no paths configured: the 0.5 places
        if not is_process_doc(root, rel):
            continue
        if rel in kept:
            kept_seen += 1
            continue   # kept by the recalibration plan for a reader: the baseline until that reader is retired
        if referenced(root, rel):
            continue
        bad.append(f"{rel}: a process document outside the layout — a decision goes under reef/architecture/adr/ or its feature's adr/, a spec in its feature folder, anything else to reef/archive/ (scripts/reef-recalibrate)")
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import importlib.machinery, importlib.util
        loader = importlib.machinery.SourceFileLoader("reef_queue", os.path.join(os.path.dirname(os.path.abspath(__file__)), "reef-queue.py"))
        spec = importlib.util.spec_from_loader("reef_queue", loader)
        q = importlib.util.module_from_spec(spec)
        loader.exec_module(q)
        bad += q.structure_errors(root, q.config(root))
    except Exception as e:
        bad.append(f"feature-folder rules unavailable (reef-queue.py): {e}")
    return bad


REEF_CODE = re.compile(r"^(scripts/reef[-_][^/]+|\.githooks/[^/]+)$")   # Reef's own code, re-copied by reef-update: never the project's
SKIP_DIR = re.compile(r"(^|/)(node_modules|dist|build|out|coverage|\.next|\.turbo|generated|__generated__|\.prisma|vendor)(/|$)")


def raw_sql_violations(root):
    """0.7.2 (item 12): SQL injection had no deterministic check — only the security agent's judgment. An unsafe raw call
    outside `assess.raw_sql_allow` fails; the allow list is the baseline the measure found, owner-edited. 0.7.3: what an
    unsafe call looks like comes from the stack profiles in scripts/reef-stacks.json (reef-recalibrate reads the same file)."""
    try:
        with open(os.path.join(root, ".reef", "config.json"), encoding="utf-8") as f:
            allow = set(str(x) for x in ((json.load(f).get("assess") or {}).get("raw_sql_allow") or []))
    except (OSError, ValueError):
        allow = set()
    try:
        with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "reef-stacks.json"), encoding="utf-8") as f:
            profiles = {k: v for k, v in json.load(f).items() if isinstance(v, dict)}
    except (OSError, ValueError):
        profiles = {}
    r = subprocess.run(["git", "-C", root, "ls-files", "-co", "--exclude-standard"], capture_output=True, text=True)
    listed = [l for l in r.stdout.splitlines() if l and not SKIP_DIR.search(l)]
    bad = []
    for prof in profiles.values():
        rs = prof.get("raw_sql")
        if not rs or not any(os.path.isfile(os.path.join(root, f)) for f in prof.get("detect") or []):
            continue
        deps = ""
        for f in prof.get("deps_from") or []:
            try:
                with open(os.path.join(root, f), encoding="utf-8", errors="replace") as fh:
                    deps += fh.read() + "\n"
            except OSError:
                continue
        if not any(re.search(r"(?<![\w@/.-])" + re.escape(d) + r"(?![\w/-])", deps, re.I) for d in rs.get("when_deps") or []):
            continue   # the same switch as reef-recalibrate's measure: the stack AND the dependency its rule names
        unsafe, ext, comment = re.compile(rs["unsafe"]), tuple(prof.get("code_ext") or ()), tuple(prof.get("comment") or ("#",))
        for rel in sorted(l for l in listed if l.endswith(ext) and l not in allow):
            try:
                with open(os.path.join(root, rel), encoding="utf-8", errors="replace") as f:
                    for n, line in enumerate(f, 1):
                        s = line.strip()
                        if not s.startswith(comment) and unsafe.search(s):
                            bad.append(f"{rel}:{n}: an unsafe raw query outside assess.raw_sql_allow — {rs.get('fix', 'parameterise it')}, "
                                       "or the owner adds the file to the allow list in .reef/config.json")
            except OSError:
                continue
    return bad

# the measure's product set, repeated here (scripts never import each other): code files that are not tests, declarations,
# generated or data (i18n) — the same excludes, so the baseline and the check agree on what a product file is
CODE_EXT = (".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".py", ".go", ".rs", ".java", ".kt", ".rb", ".php", ".cs", ".swift", ".vue", ".svelte")
TEST_FILE = re.compile(r"(^|/)(tests?|__tests__|spec)/|\.(test|spec)\.[a-z]+$|(^|/)test_[^/]+\.py$|_test\.(go|py|rs|js|ts)$")
DATA_DIR = re.compile(r"(^|/)(i18n|locales|interface|translations)(/|$)")


def changed_since_base(root):
    """(changed, added): the files this branch changed against its merge-base with the base branch (`branches.base`; origin's
    copy first, else the local one) — committed, staged, edited or untracked — and the ones it added. None when no base is
    found: the caller fails, never passes on nothing. 2026-11-06 (an adopted project, row 239): the files changed since HEAD
    are none on a committed, pushed head, so `--quality` and `--sizes` passed on every row."""
    git = lambda *a: subprocess.run(["git", "-C", root, *a], capture_output=True, text=True)
    lines = lambda r: set(l for l in r.stdout.splitlines() if l)
    try:
        with open(os.path.join(root, ".reef", "config.json"), encoding="utf-8") as f:
            base = str((json.load(f).get("branches") or {}).get("base") or "main")
    except (OSError, ValueError):
        base = "main"
    for ref in (f"origin/{base}", base):
        mb = git("merge-base", "HEAD", ref)
        if mb.returncode == 0 and mb.stdout.strip():
            point = mb.stdout.strip()
            break
    else:
        return base, None
    new = lines(git("ls-files", "--others", "--exclude-standard"))
    return base, (lines(git("diff", "--name-only", point, "--")) | new,
                  lines(git("diff", "--name-only", "--diff-filter=A", point, "--")) | new)


def no_base(base):
    return [f"no base branch {base} (neither origin/{base} nor {base}) to measure this branch against — fetch it, or set "
            "branches.base in .reef/config.json; the check refuses to pass on nothing"]


def size_violations(root):
    """0.7.2 (first adoption, 2026-10-24, item 14): big files only grew. A baselined product file may not grow past its baseline; a
    new one may not exceed `structure.new_file_lines`; shrinking lowers the baseline in the same run (the ratchet). Cost: one
    read per file the branch changed since its base, never the whole tree."""
    import fnmatch
    bp = os.path.join(root, "reef", "size-baseline.json")
    try:
        with open(os.path.join(root, ".reef", "config.json"), encoding="utf-8") as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        cfg = {}
    new_max = int(((cfg.get("structure") or {}).get("new_file_lines")) or 400)
    excl = [str(x) for x in ((cfg.get("assess") or {}).get("exclude") or [])]
    try:
        with open(bp, encoding="utf-8") as f:
            base = json.load(f)
    except (OSError, ValueError):
        return [f"no reef/size-baseline.json — run `python3 scripts/reef-recalibrate measure` once (it writes the baseline), then commit it"]
    files = base.get("files") or {}
    branch, got = changed_since_base(root)
    if got is None:
        return no_base(branch)
    changed = got[0]
    bad, lowered = [], 0
    for rel in sorted(changed):
        if not rel.endswith(CODE_EXT) or rel.endswith(".d.ts") or SKIP_DIR.search(rel) or TEST_FILE.search(rel) or DATA_DIR.search(rel) \
           or REEF_CODE.match(rel) \
           or any(fnmatch.fnmatch(rel, g) or rel.startswith(g.rstrip("/") + "/") for g in excl) or not os.path.isfile(os.path.join(root, rel)):
            continue
        with open(os.path.join(root, rel), "rb") as f:
            n = sum(1 for _ in f)
        if rel in files:
            if n > int(files[rel]):
                bad.append(f"{rel}: {n} lines, over its baseline of {files[rel]} — a big file only shrinks (split it: a `kind: refactor` row), or the owner raises the baseline in reef/size-baseline.json")
            elif n < int(files[rel]):
                files[rel] = n
                lowered += 1
        elif n > new_max:
            bad.append(f"{rel}: a new file of {n} lines, over structure.new_file_lines ({new_max}) — split it before it is born big")
    if lowered:
        base["files"] = files
        with open(bp, "w", encoding="utf-8") as f:
            json.dump(base, f, indent=1)
            f.write("\n")
        print(f"sizes: {lowered} baseline(s) lowered in reef/size-baseline.json — commit it with the change (the ratchet)")
    return bad


QUALITY = {"complexity": 10, "params": 5, "function_lines": 60, "statements": 50, "depth": 4}   # structure.quality's defaults


def quality_counts(root, rels):
    """{file: [rule, ...]} from the project's own linter with Reef's limits (scripts/reef-stacks.json `quality`), or None when no
    linter of the stack runs here — a skip, never a pass. eslint's JSON (filePath, messages[].ruleId) and ruff's (filename, code)."""
    with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "reef-stacks.json"), encoding="utf-8") as f:
        stacks = json.load(f)
    try:
        with open(os.path.join(root, ".reef", "config.json"), encoding="utf-8") as f:
            lim = dict(QUALITY, **((json.load(f).get("structure") or {}).get("quality") or {}))
    except (OSError, ValueError):
        lim = dict(QUALITY)
    out, ran = {}, False
    for prof in stacks.values():
        q = prof.get("quality") if isinstance(prof, dict) else None
        files = [r for r in rels if q and r.endswith(tuple(prof.get("code_ext") or ()))]
        if not files:
            continue
        cmd = [re.sub(r"<(\w+)>", lambda m: str(lim.get(m.group(1), m.group(0))), a) for a in q["cmd"]] + files
        try:
            r = subprocess.run(cmd, cwd=root, capture_output=True, text=True, timeout=600)
            found = json.loads(r.stdout)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            continue
        ran = True
        for item in found:
            path = item.get("filePath") or item.get("filename") or ""
            rel = os.path.relpath(os.path.realpath(path), os.path.realpath(root)) if os.path.isabs(path) else path
            rules = [m.get("ruleId") for m in item.get("messages") or []] if "messages" in item else [item.get("code")]
            out.setdefault(rel, []).extend(x for x in rules if x in q["rules"])
    return out if ran else None


def quality_violations(root, baseline=False):
    """2026-11-06 (the owner): the clean-code limits, measured. A file the branch changed never gains a violation over
    reef/quality-baseline.json, a new file has none, a file that got cleaner lowers its baseline (the ratchet).
    `--baseline` grandfathers the tracked code as it is. None = no linter ran (exit 77)."""
    bp = os.path.join(root, "reef", "quality-baseline.json")
    git = lambda *a: [l for l in subprocess.run(["git", "-C", root, *a], capture_output=True, text=True).stdout.splitlines() if l]
    keep = lambda rel: rel.endswith(CODE_EXT) and not (rel.endswith(".d.ts") or SKIP_DIR.search(rel) or TEST_FILE.search(rel)
                                                      or REEF_CODE.match(rel)) and os.path.isfile(os.path.join(root, rel))
    if baseline:
        rels = [r for r in git("ls-files") if keep(r)]
        counts = quality_counts(root, rels)
        if counts is None:
            return None
        os.makedirs(os.path.dirname(bp), exist_ok=True)
        with open(bp, "w", encoding="utf-8") as f:
            json.dump({"files": {k: len(v) for k, v in sorted(counts.items()) if v}}, f, indent=1)
            f.write("\n")
        print(f"quality: baseline written — {sum(len(v) for v in counts.values())} violation(s) in {sum(1 for v in counts.values() if v)} file(s) "
              "grandfathered (reef/quality-baseline.json; commit it)")
        return []
    try:
        with open(bp, encoding="utf-8") as f:
            base = json.load(f)
    except (OSError, ValueError):
        base = {"files": {}}
    files = base.setdefault("files", {})
    branch, got = changed_since_base(root)
    if got is None:
        return no_base(branch)
    rels, added = sorted(r for r in got[0] if keep(r)), got[1]
    counts = quality_counts(root, rels) if rels else {}
    if counts is None:
        return None
    bad, lowered = [], 0
    for rel in rels:
        got, was = counts.get(rel, []), int(files.get(rel, 0))
        rules = ", ".join(sorted(set(got)))
        if len(got) > was:
            bad.append(f"{rel}: {len(got)} violation(s) in a new file ({rules}) — split the function, fewer branches or parameters"
                       if rel in added else f"{rel}: {len(got)} violation(s), over its baseline of {was} ({rules}) — a file "
                       "never gains one; split the function, or a `kind: refactor` row")
        elif len(got) < was:
            files[rel] = len(got)
            lowered += 1
    if lowered:
        base["files"] = {k: v for k, v in files.items() if v}
        with open(bp, "w", encoding="utf-8") as f:
            json.dump(base, f, indent=1)
            f.write("\n")
        print(f"quality: {lowered} baseline(s) lowered in reef/quality-baseline.json — commit it with the change (the ratchet)")
    return bad


def main(argv):
    repo = "."
    if "--repo" in argv:
        repo = argv[argv.index("--repo") + 1]
    if "--check" not in argv and "--raw-sql" not in argv and "--sizes" not in argv and "--quality" not in argv:
        print("usage: reef-structure --check | --raw-sql | --sizes | --quality [--baseline] [--repo DIR]", file=sys.stderr)
        return 2
    if "--quality" in argv:
        root = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=repo, capture_output=True, text=True).stdout.strip() or os.path.abspath(repo)
        bad = quality_violations(root, baseline="--baseline" in argv)
        if bad == [] and "--baseline" in argv:
            return 0
        if bad is None:
            print("skipped: quality — no linter of this stack runs here (eslint through npx, or ruff); install it, then run again")
            return 77
        if bad:
            print("FAIL: quality")
            for b in bad:
                print(f"  - {b}")
            return 1
        print("ok: no changed file gained a complexity, parameter, length or nesting violation")
        return 0
    if "--sizes" in argv:
        root = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=repo, capture_output=True, text=True).stdout.strip() or os.path.abspath(repo)
        bad = size_violations(root)
        if bad:
            print("FAIL: sizes")
            for b in bad:
                print(f"  - {b}")
            return 1
        print("ok: no product file grew past its baseline, no new file over the cap")
        return 0
    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=repo, capture_output=True, text=True).stdout.strip() or os.path.abspath(repo)
    if "--raw-sql" in argv:
        bad = raw_sql_violations(root)
        if bad:
            print("FAIL: raw-sql")
            for b in bad:
                print(f"  - {b}")
            return 1
        print("ok: no unsafe raw query outside assess.raw_sql_allow")
        return 0
    bad = violations(root)
    kept = plan_keeps(root)
    if kept:
        print(f"note: {len(kept)} document(s) kept by the recalibration plan for a reader are the baseline (not violations until their readers are retired)")
    if bad:
        print("FAIL: structure")
        for b in bad:
            print(f"  - {b}")
        return 1
    print("ok: every process document lives in the layout" + (" or is kept by the plan" if kept else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
