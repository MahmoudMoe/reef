#!/bin/sh
# Reef commit gate: tests the INDEX (what is actually being committed), not the worktree.
# Method:
#   1. back up the exact index bytes and save the unstaged diff (plumbing: git diff-files,
#      so no rename detection and no diff.* config can alter the output);
#   2. set the changed tracked files to their index state, run the gate;
#   3. restore the backed-up index, re-sync those files to it, re-apply the unstaged patch.
# Restoring the index BEFORE re-applying means a gate that stages changes cannot corrupt the
# restore, and the plain patch always applies against its own preimage — so no `git stash`
# (pop conflicts on same-file staged+unstaged edits, eats merge state, pops other sessions'
# stashes) and no `git apply --3way` (it implies --index and would merge untested worktree
# content into the commit). Intent-to-add paths are excluded: their index blob is EMPTY and
# materializing it would truncate the real file.
# Limits are LOUD, never silent: untracked and intent-to-add files stay in place during the
# gate; clean/smudge-filtered paths skip the dance with a note. CI is the wall.
set -e
ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT"
GITDIR=$(git rev-parse --absolute-git-dir 2>/dev/null) || GITDIR=$(git rev-parse --git-dir)
INDEX=$(git rev-parse --git-path index)
PATCH="$GITDIR/reef-precommit.patch"
LIST="$GITDIR/reef-precommit.paths"
IBACK="$GITDIR/reef-precommit.index-bak"

fail_gate() { echo "pre-commit: gate failed — commit rejected." >&2; exit 1; }
in_place() {
  rm -f "$PATCH" "$LIST" "$IBACK"
  [ -n "$1" ] && echo "pre-commit: NOTE — gate tested the WORKTREE, not the index ($1)." >&2
  sh scripts/reef-gate.sh || fail_gate
  exit 0
}

# unborn HEAD or merge/rebase/cherry-pick in progress: touching the worktree is unsafe
git rev-parse -q --verify HEAD >/dev/null 2>&1 || in_place "first commit"
if [ -e "$GITDIR/MERGE_HEAD" ] || [ -e "$GITDIR/REBASE_HEAD" ] || [ -e "$GITDIR/CHERRY_PICK_HEAD" ]; then
  in_place "merge/rebase/cherry-pick in progress"
fi
git diff --quiet 2>/dev/null && in_place ""   # worktree == index: nothing to hide

# paths the dance will touch: unstaged changes EXCLUDING intent-to-add additions
git diff-files --name-only -z --diff-filter=a >"$LIST"
[ -s "$LIST" ] || in_place "only intent-to-add paths differ"

# clean/smudge filters do not round-trip through a patch; refuse to corrupt content
if git check-attr filter -z --stdin <"$LIST" | tr '\0' '\n' | awk 'NR%3==0' \
   | grep -qv '^\(unspecified\|unset\)$'; then
  in_place "a changed path has a clean/smudge content filter"
fi

cp -p "$INDEX" "$IBACK"    # the exact staged state, restored verbatim after the gate
git diff-files -p --binary --full-index --diff-filter=a >"$PATCH"
restore() {
  rc=$?
  [ -f "$IBACK" ] && mv -f "$IBACK" "$INDEX"          # commit exactly what was staged
  xargs -0 git checkout -q -- <"$LIST" 2>/dev/null || true   # worktree files -> restored index
  if [ -s "$PATCH" ]; then
    if git apply -p1 --whitespace=nowarn "$PATCH" 2>/dev/null; then
      rm -f "$PATCH" "$LIST"
    else
      RESCUE=$(mktemp "$GITDIR/reef-precommit-rescue.XXXXXX") && mv -f "$PATCH" "$RESCUE"
      echo "pre-commit: FAILED to restore your unstaged changes automatically." >&2
      echo "pre-commit: they are saved as a patch — recover with: git apply \"$RESCUE\"" >&2
      echo "pre-commit: rejecting the commit so this cannot pass silently." >&2
      rm -f "$LIST"
      exit 1   # a silently thinner worktree is data loss; loud rejection is the only honest exit
    fi
  else
    rm -f "$PATCH" "$LIST"
  fi
  exit $rc     # otherwise the trap must never override the script's real exit status
}
trap restore EXIT
xargs -0 git checkout -q -- <"$LIST"   # changed tracked files = index state; ita untouched
sh scripts/reef-gate.sh || fail_gate
