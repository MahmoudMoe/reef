#!/bin/sh
# CLASS: code
# Reef commit gate: runs the FAST gate (reef-gate.sh fast) on the INDEX (what is actually being
# committed), not the worktree. The full gate runs at verify/review/CI.
# Method:
#   1. back up the exact index bytes and save the unstaged diff (plumbing: git diff-files,
#      so no rename detection and no diff.* config can alter the output);
#   2. set the changed tracked files to their index state, run the gate;
#   3. restore the backed-up index, re-sync those files to it, re-apply the unstaged patch.
# Restoring the index BEFORE re-applying means a gate that stages changes cannot corrupt the
# restore, and the plain patch always applies against its own preimage — so no `git stash`
# (pop conflicts on same-file staged+unstaged edits, eats merge state, pops other sessions'
# stashes) and no `git apply --3way` (it implies --index and would merge untested worktree
# content into the commit). Intent-to-add paths are excluded: their index blob is EMPTY and
# materializing it would truncate the real file.
# Limits are LOUD, never silent: untracked and intent-to-add files stay in place during the
# gate; clean/smudge-filtered paths skip the dance with a note. CI is the wall.
set -e
ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT"
GITDIR=$(git rev-parse --absolute-git-dir 2>/dev/null) || GITDIR=$(git rev-parse --git-dir)
INDEX=$(git rev-parse --git-path index)
PATCH="$GITDIR/reef-precommit.patch"
LIST="$GITDIR/reef-precommit.paths"
IBACK="$GITDIR/reef-precommit.index-bak"

fail_gate() { echo "pre-commit: gate failed — commit rejected." >&2; exit 1; }
# git exports GIT_DIR / GIT_INDEX_FILE / GIT_WORK_TREE / GIT_PREFIX to a hook; a test suite that runs its
# own `git init` / `git commit` in temp dirs would then act on THIS repository (seen live, 0.7 dogfood:
# Reef's own suite re-initialised the repo as bare and moved the branch 17 commits). The gate runs clean.
# GIT_CONFIG_PARAMETERS carries a committer's `git -c k=v` into every git the gate runs (a hooksPath given that
# way made the suite's temp repositories run THIS hook); the gate's git sees the repository's config only.
# REEF_GATE_NO_CACHE: the commit gate always RUNS (0.7: reef-gate skips a snapshot it already ran green; the hook is the
# defence that never trusts a marker)
run_gate() { ( unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_CONFIG_PARAMETERS; REEF_GATE_NO_CACHE=1 sh scripts/reef-gate.sh fast ); }

# A tier: design (or critical) task closes only after the loophole-hunter's SECOND pass, on the finished
# guard (scripts/reef-adversarial <task> guard <report> writes adversarial-guard:). Checked on
# the STAGED blob of every task file entering a done/ directory, before anything else runs.
# hunter.guard_pass = feature (0.7): the pass runs ONCE on the feature's merged diff and reef-record refuses GREEN
# without it (scripts/reef-adversarial --feature <slug> guard <report>); a task then closes without the key.
# the MAIN checkout's config: loop policy has one home (a worktree's copy predates the owner's edit until its next merge)
MAIN_CO=$(git worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p'); [ -f "$MAIN_CO/.reef/config.json" ] || MAIN_CO=.
GUARD_PASS=$(command -v python3 >/dev/null 2>&1 && python3 -c 'import json,sys;print(str((json.load(open(sys.argv[1])).get("hunter") or {}).get("guard_pass","task")).lower())' "$MAIN_CO/.reef/config.json" 2>/dev/null || echo task)
[ "$GUARD_PASS" = feature ] || git diff --cached --name-only --diff-filter=AR -z | tr '\0' '\n' | grep -E '(^|/)done/[^/]+\.md$' \
| while IFS= read -r p; do
    blob=$(git show ":$p" 2>/dev/null) || continue
    if printf '%s\n' "$blob" | grep -qE '^tier: *(design|critical)' \
       && ! printf '%s\n' "$blob" | grep -q '^adversarial-guard: *[^ ]'; then
      echo "pre-commit: $p is a tier: design/critical task closing without adversarial-guard: — run the loophole-hunter on the finished guard and record it (scripts/reef-adversarial <task> guard <report>)." >&2
      exit 1
    fi
  done || { echo "pre-commit: commit rejected." >&2; exit 1; }
in_place() {
  rm -f "$PATCH" "$LIST" "$IBACK"
  [ -n "$1" ] && echo "pre-commit: NOTE — gate tested the WORKTREE, not the index ($1)." >&2
  run_gate || fail_gate
  exit 0
}

# unborn HEAD or merge/rebase/cherry-pick in progress: touching the worktree is unsafe. A running rebase is its
# directory (rebase-merge/ or rebase-apply/), never REBASE_HEAD: that file outlives a finished or aborted rebase, and a
# stale one made every commit gate the worktree instead of the index (ai-coach, 2026-10-24).
git rev-parse -q --verify HEAD >/dev/null 2>&1 || in_place "first commit"
if [ -e "$GITDIR/MERGE_HEAD" ] || [ -d "$GITDIR/rebase-merge" ] || [ -d "$GITDIR/rebase-apply" ] || [ -e "$GITDIR/CHERRY_PICK_HEAD" ]; then
  in_place "merge/rebase/cherry-pick in progress"
fi
git diff --quiet 2>/dev/null && in_place ""   # worktree == index: nothing to hide

# paths the dance will touch: unstaged changes EXCLUDING intent-to-add additions
git diff-files --name-only -z --diff-filter=a >"$LIST"
[ -s "$LIST" ] || in_place "only intent-to-add paths differ"

# clean/smudge filters do not round-trip through a patch; refuse to corrupt content
if git check-attr filter -z --stdin <"$LIST" | tr '\0' '\n' | awk 'NR%3==0' \
   | grep -qv '^\(unspecified\|unset\)$'; then
  in_place "a changed path has a clean/smudge content filter"
fi

cp -p "$INDEX" "$IBACK"    # the exact staged state, restored verbatim after the gate
git diff-files -p --binary --full-index --diff-filter=a >"$PATCH"
restore() {
  rc=$?
  [ -f "$IBACK" ] && mv -f "$IBACK" "$INDEX"          # commit exactly what was staged
  xargs -0 git checkout -q -- <"$LIST" 2>/dev/null || true   # worktree files -> restored index
  if [ -s "$PATCH" ]; then
    if git apply -p1 --whitespace=nowarn "$PATCH" 2>/dev/null; then
      rm -f "$PATCH" "$LIST"
    else
      RESCUE=$(mktemp "$GITDIR/reef-precommit-rescue.XXXXXX") && mv -f "$PATCH" "$RESCUE"
      echo "pre-commit: FAILED to restore your unstaged changes automatically." >&2
      echo "pre-commit: they are saved as a patch — recover with: git apply \"$RESCUE\"" >&2
      echo "pre-commit: rejecting the commit so this cannot pass silently." >&2
      rm -f "$LIST"
      exit 1   # a silently thinner worktree is data loss; loud rejection is the only honest exit
    fi
  else
    rm -f "$PATCH" "$LIST"
  fi
  exit $rc     # otherwise the trap must never override the script's real exit status
}
trap restore EXIT
xargs -0 git checkout -q -- <"$LIST"   # changed tracked files = index state; ita untouched
run_gate || fail_gate
