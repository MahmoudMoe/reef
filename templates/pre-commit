#!/bin/sh
# Reef commit gate: tests the INDEX (what is actually being committed), not the worktree.
# Method: save the unstaged diff as a patch, set tracked files to the index state, run the
# gate, restore the patch. No `git stash`: a --keep-index stash pop CONFLICTS by design when
# the same file has staged+unstaged edits, destroys merge state, and on a shared checkout can
# pop another session's stash. The patch applies cleanly by construction (worktree == index).
# Known limitation: untracked files stay in place during the gate; CI is the wall for those.
set -e
ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT"
GITDIR=$(git rev-parse --git-dir)
PATCH="$GITDIR/reef-precommit.patch"

fail_gate() { echo "pre-commit: gate failed — commit rejected." >&2; exit 1; }

# Test in place when the dance is unnecessary or unsafe:
# - unborn HEAD (first commit): nothing to diff against;
# - merge/rebase/cherry-pick state: touching the worktree here corrupts the operation;
# - worktree already equals the index: nothing to hide.
if ! git rev-parse -q --verify HEAD >/dev/null 2>&1 \
   || [ -e "$GITDIR/MERGE_HEAD" ] || [ -e "$GITDIR/REBASE_HEAD" ] || [ -e "$GITDIR/CHERRY_PICK_HEAD" ] \
   || git diff --quiet; then
  sh scripts/reef-gate.sh || fail_gate
  exit 0
fi

git diff --no-color --no-ext-diff --binary >"$PATCH"
restore() {
  rc=$?
  if [ -s "$PATCH" ]; then
    git checkout -q -- . 2>/dev/null || true   # drop any gate side effects on tracked files
    if git apply --whitespace=nowarn "$PATCH" 2>/dev/null; then
      rm -f "$PATCH"
    else
      echo "pre-commit: could not restore unstaged changes; they are saved in $PATCH (restore with: git apply \"$PATCH\")" >&2
    fi
  else
    rm -f "$PATCH"
  fi
  exit $rc    # the trap must never override the script's real exit status
}
trap restore EXIT
git checkout -q -- .    # tracked worktree = index; the gate now sees what will be committed
sh scripts/reef-gate.sh || fail_gate
