{
  "gates": {
    "fast": "",
    "full": "",
    "timeout_s": 1200,
    "resources": []
  },
  "caps": {
    "attempts": 3,
    "feature_tokens": 0,
    "batch_tokens": 0,
    "context_tokens": 150000,
    "context_warn": 100000,
    "dispatch_reserve": 30000,
    "task_growth": 0
  },
  "roles": {
    "author": "opus",
    "verifier": "opus",
    "plan_reviewer": "opus",
    "planner": "opus",
    "adversary": "opus",
    "reviewer": "opus",
    "security": "opus",
    "proxy": "fable",
    "mechanic": "sonnet"
  },
  "ci": {
    "feature_gate": "ci"
  },
  "branches": {
    "base": "main",
    "release": "main"
  },
  "hunter": {
      "plan_rounds": 2,
      "plan_pass": "critical",
      "guard_pass": "feature"
  },
  "review": {
      "split_lines": 4000,
      "security_per_item": "on"
  },
  "plan": {
    "max_acs": 0,
    "test_re": "",
    "max_words": 0
  },
  "paths": {
    "tasks": "tasks",
    "adr": "docs/adr",
    "glossary": "docs/glossary.md",
    "runlog": "docs/runlog.md",
    "queue": "docs/queue.md"
  },
  "queue": {
    "home": "file",
    "batch_max": 10
  },
  "invariants": [],
  "graph": {
    "parallel": 10,
    "mode": "auto"
  },
  "resources": {
    "heavy": {
      "slots": 2
    }
  },
  "worktree": {
    "dir": ".reef/worktrees",
    "setup": ""
  },
  "tiers": {
    "critical": {
      "roles": {
        "planner": "opus",
        "plan_reviewer": "opus",
        "adversary": "opus",
        "verifier": "opus",
        "reviewer": "opus",
        "security": "opus",
        "author": "opus"
      },
      "effort": "high",
      "paths": [
        ".githooks/**",
        "scripts/reef-*",
        "scripts/reef_*",
        "hooks/**",
        ".reef/config.json"
      ]
    },
    "design": {
      "roles": {
        "planner": "opus",
        "plan_reviewer": "opus",
        "adversary": "opus",
        "verifier": "opus",
        "reviewer": "opus",
        "security": "opus",
        "author": "opus"
      },
      "effort": "high",
      "paths": [
        "**/auth/**",
        "**/crypto/**",
        "**/secrets/**",
        "migrations/**",
        "prisma/migrations/**",
        "alembic/**"
      ]
    },
    "full": {
      "roles": {
        "planner": "opus",
        "plan_reviewer": "opus",
        "adversary": "opus",
        "verifier": "opus",
        "reviewer": "opus",
        "security": "opus",
        "author": "opus"
      },
      "effort": "medium"
    },
    "light": {
      "roles": {
        "plan_reviewer": "none"
      },
      "effort": "low",
      "allow": [
        "docs/**",
        "README.md"
      ],
      "max_lines": 80,
      "migrations": [
        "migrations/**",
        "prisma/migrations/**",
        "alembic/**"
      ]
    }
  },
  "writing": {
      "task_words": {
          "light": 0,
          "full": 0,
          "design": 0,
          "critical": 0
      },
      "handback_words": 0,
      "report_words": 0,
      "journal_words": 40000,
      "queue_words": 35000,
      "sentence_words": 0,
      "criterion_words": 0,
      "session_start_tokens": 8000
  },
  "loop": {
    "inflight_stale_minutes": 90,
    "no_progress_ticks": 3,
    "rows_in_flight": 2
  },
  "context": {
    "failure_lines": 60,
    "explore_files": 40
  },
  "converge": {
    "test_cmd": ""
  },
  "assess": {
    "exclude": [],
    "large_file": 800
  },
  "structure": {
    "new_file_lines": 400
  }
}
