{
  "gates": {
    "fast": "",
    "full": ""
  },
  "caps": {
    "attempts": 3,
    "feature_tokens": 0,
    "batch_tokens": 0,
    "context_tokens": 150000,
    "context_warn": 100000
  },
  "roles": {
    "author": "opus",
    "verifier": "opus",
    "plan_reviewer": "fable",
    "planner": "fable",
    "adversary": "opus",
    "reviewer": "opus",
    "security": "opus",
    "mechanic": "sonnet"
  },
  "merge": {
    "by": "human"
  },
  "ci": {
    "feature_gate": "ci"
  },
  "branches": {
    "base": "main",
    "release": "main"
  },
  "plan": {
    "test_re": "",
    "max_words": 0
  },
  "paths": {
    "tasks": "tasks",
    "adr": "docs/adr",
    "glossary": "docs/glossary.md",
    "runlog": "docs/runlog.md",
    "queue": "docs/queue.md"
  },
  "invariants": [],
  "graph": {
    "parallel": 10
  },
  "resources": {
    "heavy": {
      "slots": 2
    }
  },
  "worktree": {
    "dir": ".reef/worktrees",
    "setup": ""
  },
  "tiers": {
    "critical": {
      "roles": {
        "planner": "fable",
        "plan_reviewer": "fable",
        "adversary": "fable",
        "verifier": "fable",
        "reviewer": "fable",
        "security": "fable",
        "author": "opus"
      },
      "effort": "high",
      "paths": [
        ".githooks/**",
        "scripts/reef-*",
        "hooks/**",
        ".reef/config.json"
      ]
    },
    "design": {
      "roles": {
        "planner": "fable",
        "plan_reviewer": "fable",
        "adversary": "opus",
        "verifier": "opus",
        "reviewer": "opus",
        "security": "opus",
        "author": "opus"
      },
      "effort": "high",
      "paths": [
        "**/auth/**",
        "**/crypto/**",
        "**/secrets/**",
        "migrations/**",
        "prisma/migrations/**",
        "alembic/**"
      ]
    },
    "full": {
      "roles": {
        "planner": "fable",
        "plan_reviewer": "fable",
        "adversary": "opus",
        "verifier": "opus",
        "reviewer": "opus",
        "security": "opus",
        "author": "opus"
      },
      "effort": "medium"
    },
    "light": {
      "roles": {
        "plan_reviewer": "none"
      },
      "effort": "low",
      "allow": [
        "docs/**",
        "README.md"
      ],
      "max_lines": 80,
      "migrations": [
        "migrations/**",
        "prisma/migrations/**",
        "alembic/**"
      ]
    }
  },
  "writing": {
    "task_words": {
      "light": 600,
      "full": 2500,
      "design": 2500,
      "critical": 2500
    },
    "handback_words": 150,
    "prompt_words": 120,
    "report_words": 900,
    "journal_words": 40000,
    "queue_words": 35000,
    "sentence_words": 25,
    "criterion_words": 50,
    "session_start_tokens": 8000
  },
  "loop": {
    "inflight_stale_minutes": 90,
    "no_progress_ticks": 3
  },
  "context": {
    "failure_lines": 60,
    "read_lines_max": 300,
    "explore_files": 40
  },
  "converge": {
    "test_cmd": ""
  }
