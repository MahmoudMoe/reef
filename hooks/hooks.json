{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "onFailure": "block",
            "command": "sh -c 'if command -v python3 >/dev/null 2>&1; then exec python3 \"$0\"; fi; if grep -qiE \"no-?verify|hookspath\"; then echo \"reef-guard (no python3, degraded): possible gate bypass \u2014 denied\" >&2; exit 2; fi; exit 0' \"${CLAUDE_PLUGIN_ROOT}/scripts/reef-guard.py\""
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "onFailure": "block",
            "command": "sh -c 'command -v python3 >/dev/null 2>&1 && exec python3 \"$0\"; echo \"reef-guard: python3 is required to check a dispatch \u2014 denied\" >&2; exit 2' \"${CLAUDE_PLUGIN_ROOT}/scripts/reef-guard.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "onFailure": "block",
            "command": "sh -c 'command -v python3 >/dev/null 2>&1 && exec python3 \"$0\"; exit 0' \"${CLAUDE_PLUGIN_ROOT}/scripts/reef-guard.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "onFailure": "continue",
            "command": "sh -c 'command -v python3 >/dev/null 2>&1 && exec python3 \"$0\"; exit 0' \"${CLAUDE_PLUGIN_ROOT}/scripts/reef-guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "onFailure": "continue",
            "command": "sh -c 'command -v python3 >/dev/null 2>&1 && exec python3 \"$0\"; exit 0' \"${CLAUDE_PLUGIN_ROOT}/scripts/reef-approval.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "onFailure": "continue",
            "command": "sh -c 'command -v python3 >/dev/null 2>&1 || exit 0; [ -f .reef/config.json ] && [ -f scripts/reef-loop.py ] || exit 0; exec python3 scripts/reef-loop.py tick --session-start --hook'"
          }
        ]
      }
    ]
  }
}
